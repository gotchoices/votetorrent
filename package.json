{
	"name": "votetorrent",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"packages/*",
			"apps/*"
		],
		"nohoist": [
			"**/react-native",
			"**/react-native/**",
			"**/@react-native/**",
			"**/@react-native-*",
			"**/react-native-*",
			"**/@react-navigation/**",
			"**/react-i18next",
			"**/i18next",
			"**/@babel/**"
		]
	},
	"scripts": {
		"clean": "yarn workspaces foreach -A run clean",
		"build": "yarn workspaces foreach -A run build",
		"lint": "node scripts/check-peer-requirements.mjs && node scripts/check-screen-scroll-containers.mjs && yarn workspaces foreach -A run lint",
		"test": "yarn workspaces foreach -A run test",
		"start": "yarn workspace votetorrent-authority start",
		"android": "yarn workspace votetorrent-authority android",
		"ios": "yarn workspace votetorrent-authority ios",
		"all": "yarn workspace votetorrent-authority ios && yarn workspace votetorrent-authority android",
		"start:voter": "yarn workspace votetorrent-voter start",
		"android:voter": "yarn workspace votetorrent-voter android",
		"ios:voter": "yarn workspace votetorrent-voter ios",
		"all:voter": "yarn workspace votetorrent-voter ios && yarn workspace votetorrent-voter android",
		"verify:keystore": "yarn workspace votetorrent-voter verify:keystore && yarn workspace votetorrent-authority verify:keystore",
		"build:apk": "yarn workspace votetorrent-voter build:apk && yarn workspace votetorrent-authority build:apk",
		"publish:apk": "yarn workspace votetorrent-voter publish:apk && yarn workspace votetorrent-authority publish:apk",
		"release:apk": "yarn verify:keystore && yarn build:apk && yarn publish:apk",
		"lint:peers": "node scripts/check-peer-requirements.mjs",
		"lint:stubs": "bash scripts/lint-stubs.sh",
		"lint:copy": "node scripts/lint-copy.mjs",
		"lint:screen-scroll": "node scripts/check-screen-scroll-containers.mjs",
		"assert:ui-web-consumers": "node scripts/assert-ui-web-dedupe-and-gate.mjs",
		"verify:security-controls": "node scripts/verify-security-controls.mjs all",
		"verify:relay-smoke": "node scripts/assert-relay-smoke.mjs",
		"postinstall": "node scripts/check-peer-requirements.mjs"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"aegir": "^45.0.8"
	},
	"resolutions": {
		"uint8arrays@npm:^5.0.0": "3.1.1",
		"uint8arrays@npm:^5.0.1": "3.1.1",
		"uint8arrays@npm:^5.0.2": "3.1.1",
		"uint8arrays@npm:^5.1.0": "3.1.1",
		"uuid": "9.0.1",
		"react-native-screens": "4.28.0",
		"@serfab/cadre-core": "patch:@serfab/cadre-core@npm%3A1.21.0#~/.yarn/patches/@serfab-cadre-core-npm-1.21.0-votetorrent.patch",
		"@serfab/quereus-plugin-sereus": "^1.21.0",
		"@serfab/strand-proto": "^0.11.0",
		"@optimystic/db-core": "^1.25.0",
		"@optimystic/db-p2p": "patch:@optimystic/db-p2p@npm%3A1.25.0#~/.yarn/patches/@optimystic-db-p2p-npm-1.25.0-votetorrent.patch",
		"@optimystic/db-p2p-storage-rn": "^1.25.0",
		"@optimystic/db-p2p-storage-fs": "^1.25.0",
		"@optimystic/db-p2p-storage-web": "^1.25.0",
		"@optimystic/quereus-plugin-optimystic": "^1.25.0",
		"@optimystic/quereus-plugin-crypto": "^1.25.0",
		"@multiformats/multiaddr": "13.0.3",
		"p2p-fret": "^1.3.0",
		"@noble/curves": "2.2.0",
		"@noble/hashes": "2.2.0",
		"@noble/ciphers": "2.2.0",
		"@libp2p/crypto": "5.1.23",
		"@libp2p/circuit-relay-v2": "4.2.10",
		"@libp2p/websockets": "patch:@libp2p/websockets@npm%3A10.1.25#~/.yarn/patches/@libp2p-websockets-npm-10.1.25-votetorrent.patch",
		"@libp2p/peer-id@npm:^6.0.0": "6.0.15",
		"@libp2p/peer-id@npm:^6.0.1": "6.0.15",
		"@libp2p/peer-id@npm:^6.0.4": "6.0.15",
		"@libp2p/peer-id@npm:^6.0.9": "6.0.15",
		"@libp2p/peer-id@npm:^6.0.11": "6.0.15",
		"@libp2p/peer-id@npm:^6.0.13": "6.0.15",
		"@libp2p/peer-id@npm:^6.0.15": "6.0.15",
		"@libp2p/interface@npm:^3.0.0": "3.4.0",
		"@libp2p/interface@npm:^3.1.0": "3.4.0",
		"@libp2p/interface@npm:^3.2.2": "3.4.0",
		"@libp2p/interface@npm:^3.2.4": "3.4.0",
		"@libp2p/interface@npm:^3.2.5": "3.4.0",
		"@libp2p/interface@npm:^3.3.0": "3.4.0",
		"@types/react": "19.2.17",
		"@types/readable-stream": "4.0.24",
		"@ungap/structured-clone": "1.3.3",
		"@quereus/store": "^4.26.0",
		"@quereus/isolation": "^4.26.0",
		"@quereus/quereus": "patch:@quereus/quereus@npm%3A4.26.0#~/.yarn/patches/@quereus-quereus-npm-4.26.0-votetorrent.patch",
		"react-native-nitro-modules": "patch:react-native-nitro-modules@npm%3A0.37.1#~/.yarn/patches/react-native-nitro-modules-npm-0.37.1-votetorrent.patch"
	},
	"packageManager": "yarn@4.7.0",
	"engines": {
		"node": ">=20.19"
	}
}
