{
	"name": "votetorrent",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"packages/*",
			"apps/*"
		],
		"nohoist": [
			"**/react-native",
			"**/react-native/**",
			"**/@react-native/**",
			"**/@react-native-*",
			"**/react-native-*",
			"**/@react-navigation/**",
			"**/react-i18next",
			"**/i18next",
			"**/@babel/**"
		]
	},
	"scripts": {
		"clean": "yarn workspaces foreach -A run clean",
		"build": "yarn workspaces foreach -A run build",
		"lint": "node scripts/check-peer-requirements.mjs && yarn workspaces foreach -A run lint",
		"test": "yarn workspaces foreach -A run test",
		"start": "yarn workspace votetorrent-authority start",
		"android": "yarn workspace votetorrent-authority android",
		"ios": "yarn workspace votetorrent-authority ios",
		"all": "yarn workspace votetorrent-authority ios && yarn workspace votetorrent-authority android",
		"lint:peers": "node scripts/check-peer-requirements.mjs",
		"lint:stubs": "bash scripts/lint-stubs.sh",
		"postinstall": "node scripts/check-peer-requirements.mjs"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"aegir": "^45.0.8"
	},
	"resolutions": {
		"uint8arrays@npm:^5.0.0": "3.1.1",
		"uint8arrays@npm:^5.0.1": "3.1.1",
		"uint8arrays@npm:^5.0.2": "3.1.1",
		"uint8arrays@npm:^5.1.0": "3.1.1",
		"uuid": "9.0.1",
		"react-native-screens": "4.10.0",
		"@serfab/cadre-core": "^0.8.1",
		"@serfab/quereus-plugin-sereus": "^0.8.1",
		"@serfab/strand-proto": "^0.8.1",
		"@optimystic/db-core": "^0.14.1",
		"@optimystic/db-p2p-storage-rn": "^0.14.1",
		"@multiformats/multiaddr": "13.0.1",
		"p2p-fret": "^0.6.0",
		"@optimystic/quereus-plugin-optimystic": "^0.14.1",
		"@noble/curves": "2.2.0",
		"@noble/hashes": "2.2.0",
		"@libp2p/crypto": "5.1.20",
		"@quereus/store": "4.3.1",
		"@quereus/isolation": "4.3.1",
		"@chainsafe/libp2p-gossipsub@npm:^14.1.2": "patch:@chainsafe/libp2p-gossipsub@npm%3A14.1.2#~/.yarn/patches/@chainsafe-libp2p-gossipsub-npm-14.1.2-8e35f26afb.patch",
		"@quereus/quereus": "patch:@quereus/quereus@npm%3A4.3.1#~/.yarn/patches/@quereus-quereus-npm-4.3.1-6814ac0861.patch",
		"@optimystic/db-p2p@npm:^0.14.1": "patch:@optimystic/db-p2p@npm%3A0.14.1#~/.yarn/patches/@optimystic-db-p2p-npm-0.14.1-d92453d5ee.patch"
	},
	"packageManager": "yarn@4.7.0",
	"engines": {
		"node": ">=20.19"
	}
}
