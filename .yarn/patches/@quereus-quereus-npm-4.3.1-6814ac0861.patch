+ */
+function applyViewDefaults(viewStmt, targetSchemaName) {
+    if (targetSchemaName && targetSchemaName !== 'main' && !viewStmt.view.schema) {
+        return {
+            ...viewStmt,
+            view: {
+                ...viewStmt.view,
+                schema: targetSchemaName
+            }
+        };
+    }
