diff --git a/cpp/utils/WeakReferenceCache.hpp b/cpp/utils/WeakReferenceCache.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..31c9daff280013c27491888c3f56fad1d2b4acfe
--- /dev/null
+++ b/cpp/utils/WeakReferenceCache.hpp
@@ -0,0 +1,36 @@
+//
+//  WeakReferenceCache.hpp
+//  NitroModules
+//
+//  VoteTorrent patch: JSICache kept one WeakReference per value it ever converted and released
+//  them only in ~JSICache, so every ArrayBuffer passed to native code left its ReferenceState
+//  (~96 bytes) and a vector slot alive for the life of the runtime.
+//
+
+#pragma once
+
+#include "WeakReference.hpp"
+#include <algorithm>
+#include <vector>
+
+namespace margelo::nitro {
+
+/**
+ * Appends `ref` to `cache`, first dropping the entries whose value is gone when the vector is
+ * full. If more than half are still live after that, the capacity doubles, so a mostly-live
+ * vector is not rescanned on every append; either way the cost stays amortised O(1) per append.
+ * Live entries stay for ~JSICache to destroy.
+ */
+template <typename T>
+inline void appendPruningExpired(std::vector<WeakReference<T>>& cache, WeakReference<T>&& ref) {
+  if (cache.size() == cache.capacity()) {
+    cache.erase(std::remove_if(cache.begin(), cache.end(), [](const WeakReference<T>& entry) { return entry.isExpired(); }),
+                cache.end());
+    if (cache.size() > cache.capacity() / 2) {
+      cache.reserve(cache.capacity() * 2);
+    }
+  }
+  cache.push_back(std::move(ref));
+}
+
+} // namespace margelo::nitro
