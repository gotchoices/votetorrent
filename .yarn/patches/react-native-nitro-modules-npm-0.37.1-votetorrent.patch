   [[nodiscard]]
   BorrowingReference<T> lock() const;
 
+  /**
+   * VoteTorrent patch: whether the value is gone (its last strong reference was released, or it
+   * was destroyed). An expired `WeakReference<T>` can never be locked again.
+   */
+  [[nodiscard]]
+  bool isExpired() const {
+    return _state == nullptr || _state->isDeleted;
+  }
