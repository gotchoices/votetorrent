+++ b/dist/strand-cohort-refusal.js
@@ -0,0 +1,66 @@
+import debug from 'debug';
+const log = debug('sereus:cadre:strand-cohort-refusal');
+/**
+ * VoteTorrent patch (strand-cohort-refusal): opt-in `CadreNodeConfig.strandCohortRefusal`.
+ *
+ * A strand member that stores nothing (the officer's browser dashboard: a storage-withdrawn edge
+ * node) can still read as "serves this network" in a storage node's peerStore, because libp2p
+ * merges the protocol of every stream negotiated with a peer into that peer's record, and the
+ * member's own reads open `repo` streams. db-p2p then puts it into write cohorts and may pick it
+ * as coordinator, and a write that needs its approval falls short. db-p2p already has the gate
+ * for this, `NodeOptions.isNetworkMember`; cadre-core passes it only to the control node. This
+ * hook hands one to each strand node, per strand.
+ *
+ * Contract:
+ * - Opt-in. With no hook, the strand node's options carry no `isNetworkMember` key at all, so
+ *   db-p2p takes its "absent predicate" path exactly as before.
+ * - The hook is called once per strand-node build (a hibernation wake calls it again for the
+ *   same strand) and returns `{ refuses(peerId), attach?(libp2pNode) }`, or `undefined` for no
+ *   refusal on that strand.
+ * - A peer is refused only when `refuses` returns the literal `true`. Any other value, or a
+ *   throw, ADMITS the peer: a predicate that refused everyone would collapse every cohort to a
+ *   solo write, which is worse than the defect this closes.
+ * - A hook that throws, or returns anything but an object with a function `refuses`, means no
+ *   refusal on that strand (logged, never thrown).
+ * - `attach(node)` is called with the strand's libp2p node right after it is built, so the
+ *   refusal can learn from that node's peer events. A throwing `attach` is swallowed.
+ * - Reads are not gated: db-p2p's predicate only decides who this node sends storage to
+ *   (cohort, coordinator, spread, restoration, redirects).
+ */
+export function resolveStrandCohortRefusal(hook, strandId) {
+    if (typeof hook !== 'function') {
+        return null;
+    }
+    let refusal;
+    try {
+        refusal = hook(strandId);
+    }
+    catch (error) {
+        log('strand %s: cohort refusal hook threw, no refusal on this strand: %s', strandId, error?.name ?? typeof error);
+        return null;
+    }
+    if (refusal === null || typeof refusal !== 'object' || typeof refusal.refuses !== 'function') {
+        return null;
+    }
+    return {
+        isNetworkMember(peerId) {
+            try {
+                return refusal.refuses(peerId) !== true;
+            }
+            catch {
+                return true;
+            }
+        },
+        attach(node) {
+            if (typeof refusal.attach !== 'function') {
+                return;
+            }
+            try {
+                refusal.attach(node);
+            }
+            catch (error) {
+                log('strand %s: cohort refusal attach threw (ignored): %s', strandId, error?.name ?? typeof error);
+            }
+        }
+    };
+}
