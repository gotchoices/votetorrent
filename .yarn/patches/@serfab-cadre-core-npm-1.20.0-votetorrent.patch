+/**
+ * VoteTorrent patch (strand-cohort-refusal): what a {@link StrandCohortRefusalHook} returns for one
+ * strand. `refuses(peerId)` is called synchronously by db-p2p on every cohort and coordinator
+ * choice, so it must be cheap; only a literal `true` refuses, and a throw admits. `attach` is
+ * called once per built strand node with that node, so the refusal can learn from its peer events.
+ */
+export interface StrandCohortRefusal {
+    refuses(peerId: string): boolean;
+    attach?(libp2pNode: unknown): void;
+}
+/**
+ * VoteTorrent patch (strand-cohort-refusal): opt-in per-strand cohort refusal, set as
+ * `CadreNodeConfig.strandCohortRefusal`. Called once per strand-node build (again on a hibernation
+ * wake); return `undefined` for no refusal on that strand.
+ */
+export type StrandCohortRefusalHook = (strandId: string) => StrandCohortRefusal | undefined;
+/**
+ * VoteTorrent patch (strand-cohort-refusal): the strand node's `isNetworkMember` predicate and its
+ * attach step, or `null` (no hook, a throwing hook, or a result without a function `refuses`).
+ * `isNetworkMember(p)` is `refuses(p) !== true`, and a throw admits. `attach` swallows a throw.
+ */
+export declare function resolveStrandCohortRefusal(hook: StrandCohortRefusalHook | undefined, strandId: string): null | {
+    isNetworkMember(peerId: string): boolean;
+    attach(node: unknown): void;
+};
