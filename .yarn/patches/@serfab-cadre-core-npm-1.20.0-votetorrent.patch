+    if (known !== undefined) {
+        return known;
+    }
+    const verdict = verify(data, signature, publicKey, curveType, inputEncoding, signatureEncoding, keyEncoding);
+    if (typeof verdict === 'boolean') {
+        if (verdicts.size >= MAX_ENTRIES) {
+            verdicts.delete(verdicts.keys().next().value);
+        }
+        verdicts.set(key, verdict);
+    }
