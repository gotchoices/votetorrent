+import { verify } from '@optimystic/quereus-plugin-crypto';
+/**
+ * VoteTorrent patch: `verify` with its verdicts remembered. The membership refresh judges the same
+ * `CadrePeer` rows, and `resolvePeerAddrs` the same peer records, on every pass, so the same
+ * (digest, signature, key) triples were re-verified in pure-JS ed25519 each time; on a phone that
+ * kept the JS thread busy. A verdict is a pure function of every argument, all of which are in the
+ * key, so remembering it cannot change one. A call that throws is not remembered. Bounded: the
+ * oldest entry is dropped once the map is full.
+ */
+const MAX_ENTRIES = 4096;
+const verdicts = new Map();
+export function memoVerify(data, signature, publicKey, curveType, inputEncoding, signatureEncoding, keyEncoding) {
+    if (typeof data !== 'string' || typeof signature !== 'string' || typeof publicKey !== 'string') {
+        return verify(data, signature, publicKey, curveType, inputEncoding, signatureEncoding, keyEncoding);
+    }
+    const key = `${curveType}|${inputEncoding}|${signatureEncoding}|${keyEncoding}|${publicKey}|${signature}|${data}`;
+    const known = verdicts.get(key);
+    if (known !== undefined) {
+        return known;
+    }
+    const verdict = verify(data, signature, publicKey, curveType, inputEncoding, signatureEncoding, keyEncoding);
+    if (typeof verdict === 'boolean') {
+        if (verdicts.size >= MAX_ENTRIES) {
+            verdicts.delete(verdicts.keys().next().value);
+        }
+        verdicts.set(key, verdict);
+    }
+    return verdict;
+}
