+/**
+ * VoteTorrent patch: memoize the offline verification of a claim's proof. A node re-reads the same
+ * blocks every read-repair window (cadre's membership views reload every 15 s) and every answering
+ * peer re-sends the same proof, so the same Ed25519 signatures were verified again and again: about
+ * a fifth of an idle Voter's JS time on Hermes. The verdict is a pure function of (proof, claim,
+ * thresholds), so it is keyed by a hash of their JSON, and two inputs share an entry only when their
+ * JSON is identical. An input JSON cannot represent exactly (a Map, a typed array, a non-finite
+ * number, a BigInt) is verified uncached. Anchoring still runs on every call.
+ */
+const VERDICT_CACHE_MAX = 512;
+const verdictCache = new Map();
+
+function exactJson(_key, value) {
+    if (typeof value === 'number' && !Number.isFinite(value)) {
+        throw new Error('non-finite');
+    }
+    if (value !== null && typeof value === 'object' && !Array.isArray(value)) {
+        const proto = Object.getPrototypeOf(value);
+        if (proto !== Object.prototype && proto !== null) {
+            throw new Error('not plain JSON');
+        }
+    }
+    return value;
+}
+
+function verifyClaimCached(proof, claim, thresholds) {
+    let key;
+    try {
+        key = bytesToHex(sha256(utf8ToBytes(JSON.stringify([proof, claim, thresholds], exactJson))));
+    }
+    catch {
+        return verifyBlockCommitProofClaim(proof, claim, thresholds);
+    }
+    const hit = verdictCache.get(key);
+    if (hit !== undefined) {
+        verdictCache.delete(key);
+        verdictCache.set(key, hit);
+        return hit;
+    }
+    const verdict = verifyBlockCommitProofClaim(proof, claim, thresholds);
+    verdictCache.set(key, verdict);
+    if (verdictCache.size > VERDICT_CACHE_MAX) {
+        verdictCache.delete(verdictCache.keys().next().value);
+    }
+    return verdict;
+}
+
 /**
