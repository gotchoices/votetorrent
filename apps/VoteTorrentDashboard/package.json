{
	"name": "votetorrent-dashboard",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Read-only web dashboard for an authority officer",
	"scripts": {
		"dev": "vite --port 5180 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 5180 --strictPort",
		"test": "yarn test:node",
		"test:node": "node --test --test-concurrency=1 test/node/*.test.mjs",
		"test:browser": "node test/browser/run-headless.mjs",
		"gate:ui": "node ../../packages/ui-web/scripts/run-ui-gates.mjs --app .",
		"build:mutant": "vite build --config vite.mutant.config.ts",
		"build:chart-geometry": "vite build --config test/browser/vite.chart-geometry.config.ts",
		"gate:prove-no-dedupe": "node ../../packages/ui-web/scripts/run-ui-gates.mjs --app . --prove-no-dedupe",
		"gate:prove-token-missing": "node ../../packages/ui-web/scripts/run-ui-gates.mjs --app . --prove-token-missing",
		"gate:chart-geometry": "node test/browser/run-chart-geometry-gate.mjs",
		"gate:prove-chart-geometry-matchers": "node test/browser/run-chart-geometry-gate.mjs --prove-matchers",
		"gate:live": "node test/browser/run-live-gate.mjs",
		"gate:prove-live-matchers": "node test/browser/run-live-gate.mjs --prove-matchers",
		"typecheck": "tsc --noEmit",
		"lint": "node ../../scripts/lint-copy.mjs",
		"assert:no-polyfills": "node scripts/assert-no-node-polyfills.mjs",
		"assert:no-test-harness-in-dist": "node scripts/assert-no-test-harness-in-dist.mjs",
		"assert:tokens-in-dist": "node scripts/assert-tokens-in-dist.mjs",
		"capabilities:generate": "node scripts/generate-capabilities.mjs",
		"clean": "rm -rf dist node_modules",
		"gate:zero-state-legend": "node test/browser/zero-state-legend-gate.mjs",
		"gate:prove-zero-state-legend-matchers": "node test/browser/zero-state-legend-gate.mjs --prove-matchers",
		"gate:label-headroom": "node test/browser/label-headroom-gate.mjs",
		"gate:prove-label-headroom-matchers": "node test/browser/label-headroom-gate.mjs --prove-matchers"
	},
	"dependencies": {
		"@libp2p/crypto": "5.1.23",
		"@libp2p/websockets": "10.1.25",
		"@noble/ciphers": "^2",
		"@noble/hashes": "^2",
		"@optimystic/db-core": "^1.24.0",
		"@optimystic/db-p2p": "^1.24.0",
		"@optimystic/db-p2p-storage-web": "^1.24.0",
		"@optimystic/quereus-plugin-crypto": "^1.24.0",
		"@quereus/isolation": "4.24.0",
		"@quereus/plugin-indexeddb": "4.24.0",
		"@quereus/quereus": "patch:@quereus/quereus@npm%3A4.24.0#~/.yarn/patches/@quereus-quereus-npm-4.24.0-votetorrent.patch",
		"@quereus/store": "4.24.0",
		"@serfab/cadre-core": "patch:@serfab/cadre-core@npm%3A1.20.0#~/.yarn/patches/@serfab-cadre-core-npm-1.20.0-votetorrent.patch",
		"@serfab/quereus-plugin-sereus": "^1.20.0",
		"@votetorrent/ui-web": "workspace:*",
		"@votetorrent/vote-engine": "workspace:*",
		"@votetorrent/web-data": "workspace:*",
		"jsqr": "1.4.0",
		"react": "19.0.0",
		"react-dom": "19.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^5.0.0",
		"fake-indexeddb": "^6.2.5",
		"playwright": "^1.62.1",
		"typescript": "^5.6.3",
		"vite": "^7.0.0"
	},
	"engines": {
		"node": ">=20.19"
	}
}
