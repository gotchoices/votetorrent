		"@noble/ciphers": "^2",
		"@noble/curves": "^2",
		"@noble/hashes": "^2",
		"@optimystic/db-core": "^1.24.0",
		"@optimystic/db-p2p": "^1.24.0",
		"@optimystic/db-p2p-storage-rn": "^1.24.0",
