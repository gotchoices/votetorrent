		"react-native-safe-area-context": "^5.2.0",
		"react-native-screens": "4.28.0",
		"react-native-splash-view": "^0.0.22",
		"react-native-vector-icons": "^10.0.0",
		"react-native-vision-camera": "5.2.3",
		"react-native-vision-camera-barcode-scanner": "5.2.3",
		"readable-stream": "^4.7.0",
		"rn-leveldb": "patch:rn-leveldb@npm%3A3.11.1#~/.yarn/patches/rn-leveldb-npm-3.11.1-add1912081.patch",
