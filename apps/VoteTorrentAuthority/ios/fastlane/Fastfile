default_platform(:ios)

# Assumption A5 (51-03 Task 2) was verified, not assumed: this file exists and both
# lanes below (beta, release) are real publish lanes (TestFlight / App Store), so they
# get the same D-14 App Attest release gate as the Android build_apk/build_aab lanes.
# See scripts/fastlane/vt_appattest_release_gate.rb.
FASTLANE_DIR = __dir__
REPO_ROOT    = File.expand_path("../../../..", FASTLANE_DIR)
require File.join(REPO_ROOT, "scripts", "fastlane", "vt_appattest_release_gate")

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    VtAppAttestReleaseGate.assert_releasable!(REPO_ROOT)

    # Provisioning comes from Xcode automatic signing; this lane creates and
    # downloads nothing at Apple.

    # Increment build number
    increment_build_number
    
    # Build the app
    build_ios_app(
      scheme: "VoteTorrentAuthority",
      export_method: "app-store",
      configuration: "Release",
      clean: true
    )
    
    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Push a new release build to the App Store"
  lane :release do
    VtAppAttestReleaseGate.assert_releasable!(REPO_ROOT)

    # Provisioning comes from Xcode automatic signing; this lane creates and
    # downloads nothing at Apple.

    # Increment build number
    increment_build_number
    
    # Build the app
    build_ios_app(
      scheme: "VoteTorrentAuthority",
      export_method: "app-store",
      configuration: "Release",
      clean: true
    )
    
    # Upload to App Store
    upload_to_app_store(
      force: true,
      submit_for_review: true,
      automatic_release: true
    )
  end
end 