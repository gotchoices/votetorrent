figmaToken.txt

# Temp Figma REST artifacts (local only)
.figma-tmp/

.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
!.yarn/patches

.idea

# proof-flags.generated.ts is TRACKED (committed default-false baseline) — an
# ignore entry here would be a no-op for a tracked file (WR-02, 17-REVIEW).
