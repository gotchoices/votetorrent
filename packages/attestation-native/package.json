{
	"name": "@votetorrent/attestation-native",
	"version": "0.0.1",
	"private": true,
	"description": "Shared, app-agnostic attestation TurboModule — Android (Play Integrity + hardware Keystore key attestation, D-08) and iOS (App Attest + Secure Enclave cross-sign)",
	"main": "src/index.ts",
	"react-native": "src/index.ts",
	"types": "src/index.ts",
	"license": "MIT",
	"files": [
		"src",
		"android",
		"ios"
	],
	"codegenConfig": {
		"name": "AttestationNativeSpec",
		"type": "modules",
		"jsSrcsDir": "./src/specs",
		"android": {
			"javaPackageName": "org.votetorrent.attestationnative"
		}
	},
	"scripts": {
		"tsc": "tsc --noEmit",
		"typecheck:ios": "bash scripts/typecheck-ios.sh",
		"typecheck:ios:app": "bash scripts/typecheck-ios-app.sh"
	},
	"dependencies": {
		"@optimystic/quereus-plugin-crypto": "^1.24.0",
		"@votetorrent/vote-core": "workspace:*"
	},
	"peerDependencies": {
		"react": "*",
		"react-native": "*"
	},
	"devDependencies": {
		"@react-native/typescript-config": "0.87.1",
		"@types/jest": "^29.5.13",
		"@types/node": "^22",
		"react": "19.2.3",
		"react-native": "0.87.1",
		"typescript": "5.9.3"
	}
}
