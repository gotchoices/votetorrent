{
	"name": "@votetorrent/vote-engine",
	"version": "0.0.1",
	"type": "module",
	"description": "Concerete implementation of voting functionality for VoteTorrent",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"src",
		"dist",
		"!dist/test",
		"!**/*.tsbuildinfo"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./rn": {
			"types": "./dist/rn-entry.d.ts",
			"import": "./dist/rn-entry.js"
		}
	},
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"lint": "aegir lint",
		"test": "TS_NODE_PROJECT=./tsconfig.test.json mocha --node-option=import=./register-ts-node.mjs --node-option=experimental-specifier-resolution=node --require tsconfig-paths/register \"test/**/*.spec.ts\"",
		"guard:builders": "bash scripts/ci-grep-guard.sh",
		"dep-check": "aegir dep-check"
	},
	"homepage": "https://github.com/gotchoices/votetorrent",
	"bugs": {
		"url": "https://github.com/gotchoices/votetorrent/issues"
	},
	"keywords": [
		"vote",
		"voting"
	],
	"license": "MIT",
	"peerDependencies": {
		"@react-native-async-storage/async-storage": "^2.1.1",
		"react-native": "0.78.0"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.13.10",
		"@types/uuid": "^11.0.0",
		"aegir": "^45.1.4",
		"chai": "^5.2.0",
		"eslint": "^8.31.0",
		"eslint-plugin-n": "^17.23.1",
		"mocha": "^11.5.0",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.6.3"
	},
	"dependencies": {
		"@noble/curves": "2.2.0",
		"@noble/hashes": "2.2.0",
		"@optimystic/quereus-plugin-crypto": "^0.14.1",
		"@peculiar/asn1-android": "^2.8.0",
		"@peculiar/asn1-schema": "^2.8.0",
		"@peculiar/x509": "^2.0.0",
		"@quereus/quereus": "^4.3.1",
		"@react-native-async-storage/async-storage": "^2.1.2",
		"@votetorrent/vote-core": "^0.0.1",
		"asn1js": "^3.0.10",
		"jose": "^6.2.4",
		"react": "19.0.0",
		"react-native": "0.78.0",
		"reflect-metadata": "^0.2.2",
		"temporal-polyfill": "^0.3.0",
		"uuid": "^14.0.0"
	},
	"ts-node": {
		"esm": true,
		"experimentalSpecifierResolution": "node"
	}
}
