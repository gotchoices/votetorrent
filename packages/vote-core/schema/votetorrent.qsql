	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsUserValid boolean );

	-- Append-only withdrawal marker for a proposed network revision (SURF-04, D-09).
	-- Keyed on (Name, Revision) so a withdrawn revision drops off the proposed list via a
	-- NOT EXISTS read filter, WITHOUT mutating or deleting the ProposedNetwork row.
	-- Justification: append-only audit consistency + no proposal-history loss — NOT because
	-- ProposedNetwork forbids delete (it does not: ProposedNetwork has no CantDelete/InsertOnly;
	-- CantDelete lives only on Network/Officer/ProposedOfficer(User)/Authority). Non-signing
	-- this phase (D-09/D-05): the context envelope carries only Tid + now, no signature/user CHECK.
	table RevisionCancellation (
		Name text,
		Revision integer not null,
		CancelledAt datetime,
		primary key (Name, Revision),
		constraint ProposalExists check on insert (
			exists (select 1 from ProposedNetwork P where P.Name = new.Name and P.Revision = new.Revision)
		),
		constraint InsertOnly check on update, delete (false)
	)
		with context ( Tid int, now datetime );

	table ProposedAuthority (
		Id text primary key,
		Name text,
		DomainName text null,
		ImageRef text null, -- json object { url?: string, cid?: string }
		constraint AuthorityExists check on insert, update (exists (select 1 from Authority A where A.Id = new.Id)),
		constraint UserValid check (context.IsUserValid = true),
		-- constraint TasksHandled	check (
		-- 	-- if more signatures are required
		-- 	-- exists (

		-- 	-- )
		-- 	-- if a signature is present, no hanging tasks should be left
		-- 	not exists (
		-- 		select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
		-- 			join AdminSignature ASig on ASig.SigningNonce = A.Nonce
		-- 				where T.Id = new.TaskId and T.IsCompleted = false
		-- 	)
		-- )
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsUserValid boolean );

	table ProposedAdmin (
		AuthorityId text,
		EffectiveAt datetime,
		ThresholdPolicies text default '[]', -- json array of { policy: string (Scope), threshold: integer }
		primary key (AuthorityId, EffectiveAt),
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint EffectiveAtValid check on insert, update (EffectiveAt is not null),
		--constraint ThresholdPoliciesValid check (...), -- TODO: constraint
		constraint UserValid check (context.IsUserValid = true)
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsUserValid boolean );

	table ProposedOfficer (
		AuthorityId text,
		AdminEffectiveAt datetime,
		ProposedName text,
		Title text,
		Scopes text default '[]', -- json array of strings
		primary key (AuthorityId, AdminEffectiveAt, ProposedName),
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint AdminValid check (exists (select 1 from ProposedAdmin A where A.AuthorityId = new.AuthorityId and A.EffectiveAt = new.AdminEffectiveAt)),
		constraint CantDelete check on delete (false),
		constraint ScopesValid check (not exists (select 1 from json_each(Scopes) where value not in (select Code from Scope))),
		constraint UserValid check (context.IsUserValid = true)
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsUserValid boolean );

	-- Possibly remove, since users must be associated with a keyholer or officer
	-- Extension of ProposedOfficer to associate a specific UserId and include the user''s signature
	table ProposedOfficerUser (
		AuthorityId text,
		AdminEffectiveAt datetime,
		ProposedName text,
		UserId text,
		UserKey text,
		UserSignature text,
		primary key (AuthorityId, AdminEffectiveAt, ProposedName),
		constraint ProposedOfficerValid check (exists (select 1 from ProposedOfficer PA where PA.AuthorityId = new.AuthorityId and PA.AdminEffectiveAt = new.AdminEffectiveAt and PA.ProposedName = new.ProposedName)),
		constraint UserIdValid check (exists (select 1 from User U where U.Id = new.UserId)),
		constraint UserKeyValid check (exists (select 1 from UserKey K where K.UserId = new.UserId and K.PubKey = new.UserKey and K.Expiration > context.now)),
		constraint CantDelete check on delete (false),
		-- TODO: re-enable when ProposedOfficerUser's role is decided (currently "possibly remove" per the table comment).
		-- Original (broken) body referenced PA.AdminRevision / PA.UserId / PA.SignerKey / PA.Signature which do not exist on ProposedOfficer.
		constraint SignatureValid check (true)
	)
		with context ( now datetime );

	view InviteType as
		select 'au' as Code, 'Authority' as Name
		union all select 'of' as Code, 'Officer' as Name
		union all select 'k' as Code, 'Keyholder' as Name
		union all select 'r' as Code, 'Registrant' as Name;

	table InviteSlot (
		Cid text primary key,
		Type text, -- references InviteType(Code) — must match TS union InviteType in packages/vote-core/src/invite/models.ts:68 ('au'|'of'|'k'|'r')
		Name text, -- Name of invited person or authority for informational purpose and/or manually catch abuse
		Expiration datetime,
		InviteKey text, -- public key of temporary Invite key pair
		InviteSignature text,
		SigningNonce text, -- AdminSigning.Nonce, shows admin approval including scope (implies the type of invite, e.g. authority, officer, keyholder, registrant)
		ResendSalt text null, -- D-03 Option B (Phase 36): resendInvite's salt (resend|tid|now), persisted so the resend row's Cid is fully re-derivable; null for normal (au/of) invites
		-- D-02/D-03 (Phase 36): Cid is minted as an IPLD CIDv1 via cid(Digest(...)) at all
		-- 3 authority-engine.ts producer sites (au/of/resend). TOTAL content
		-- re-derivation — no structural-only acceptance branch on InviteSlot: every
		-- row's Cid must equal cid(Digest(...)) recomputed from that row's OWN
		-- persisted columns. Branches are keyed on ResendSalt null/not-null. Both
		-- au and of are 6-field (Type-bound, WR-01 fix — Type is no longer
		-- normalized out of the au branch's re-derivation):
		--   au/of (6-field):  Cid = cid(Digest(Expiration, InviteKey, InviteSignature, Name, SigningNonce, Type))
		--   resend (7-field): Cid = cid(Digest(Expiration, InviteKey, InviteSignature, Name, SigningNonce, Type, ResendSalt))
		constraint CidValid check (
			(ResendSalt is null
				and Cid = cid(Digest(Expiration, InviteKey, InviteSignature, Name, SigningNonce, Type)))
			or (ResendSalt is not null
				and Cid = cid(Digest(Expiration, InviteKey, InviteSignature, Name, SigningNonce, Type, ResendSalt)))
		),
		constraint TypeValid check (Type in (select Code from InviteType)),
		constraint ExpirationValid check (Expiration > context.now),
		constraint InviteSignatureValid check (context.IsSignatureValid = true),
		constraint InsertOnly check on update, delete (false),
		constraint InsertValid check on insert (context.IsInsertValid = true)
	)
		with context ( Tid int, now datetime, IsSignatureValid boolean, IsInsertValid boolean );

	index InviteSlotSigningNonce on InviteSlot (SigningNonce, Cid);

	-- A single signing can encompass a batch of Invite slots, so validate the whole batch at once.
	-- D-03 (Phase 33): rewritten to inner-join form that fires only when AdminSigning IS present but
	-- no InviteSlot in the batch matches the Digest. This allows:
	--   (a) InviteSlot INSERT before AdminSigning — inner join finds no AdminSigning → no violation.
	--   (b) resendInvite — fresh slot reuses the original SigningNonce; AdminSigning.Digest = Digest(orig.Cid)
	--       matches the original slot in the batch → no violation (whole batch is covered).
	--   (c) mismatched AdminSigning Digest — no InviteSlot in the batch matches → violation.
	-- Eliminates the SND derived alias that quereus 4.x per-tuple residual resolveAttribute
	-- cannot carry into run context (same Digest(I.Cid) UDF call, same Cid argument, D-03).
	assertion InviteSlotSigningValid check (not exists (
		select 1 from InviteSlot I
			inner join AdminSigning SIG on SIG.Nonce = I.SigningNonce
				where not exists (
					select 1 from InviteSlot I2
						where I2.SigningNonce = I.SigningNonce and SIG.Digest = Digest(I2.Cid)
				)
	));

	-- Acceptance or rejection of Invite, created before resulting object
	table InviteResult (
		SlotCid text primary key,
		IsAccepted boolean,	-- If Not accepted, Digest must be null
		Digest text null,	-- On whatever the invited party is intending to create - not validated here besides not null if IsAccepted
		InviteSignature text,	-- Signs H(SlotCid, Digest, IsAccepted)
		InvokedId text null,	-- ID of the object that will be invoked by the invitation - not validated here, this id is reserved for when the authority/user/ is created
		constraint InsertOnly check on update, delete (false),
		constraint SigningValid check (context.IsSigningValid = true),
		constraint SignatureValid check (context.IsSignatureValid = true),
		constraint DigestValid check (
			(not IsAccepted and new.Digest is null)
				or (IsAccepted and new.Digest is not null)
		),
		-- D-03 structural fallback (Phase 36): SlotCid is a reference to InviteSlot.Cid,
		-- not schema-reconstructable here — enforce structural CIDv1 raw-codec shape only.
		-- cast(...as text) required: json_extract's JSON-typed return is not directly
		-- =-comparable to a bare TEXT literal (36-01 Probe 3b finding).
		constraint SlotCidValid check ( cast(json_extract(cid_decode(SlotCid), '$.codec') as text) = 'raw' )
	)
		with context ( IsSigningValid boolean, IsSignatureValid boolean );

	-- Append-only withdrawal marker for a pending InviteSlot (SURF-03, D-06).
	-- A slot with a matching row drops off the pending list via a NOT EXISTS read filter;
	-- the InviteSlot itself is never mutated (InviteSlot is InsertOnly, so cancel cannot
	-- update/delete it). Audit trail persists. Non-signing this phase (D-06/D-05): the
	-- context envelope carries only Tid + now, no signature/user CHECK.
	table InviteCancellation (
		SlotCid text primary key, -- references InviteSlot(Cid)
		CancelledAt datetime,
		constraint SlotExists check on insert (exists (select 1 from InviteSlot S where S.Cid = new.SlotCid)),
		-- D-03 structural fallback (Phase 36): see InviteResult.SlotCidValid comment.
		constraint SlotCidValid check ( cast(json_extract(cid_decode(SlotCid), '$.codec') as text) = 'raw' ),
		constraint InsertOnly check on update, delete (false)
	)
		with context ( Tid int, now datetime );

	view AcceptedInvite as
		select IR.SlotCid, IR.IsAccepted, IR.Digest, IR.InviteSignature, SIG.Scope
			from InviteResult IR
			join InviteSlot S on S.Cid = IR.SlotCid
			join AdminSigning SIG on SIG.Nonce = S.SigningNonce
			where IR.IsAccepted;

	view UserKeyType as
		select 'M' as Code, 'Mobile' as Name
		union all select 'Y' as Code, 'Yubico' as Name;

	table User (
		Id text primary key, -- Random ID
		Name text,
		ImageRef text null, -- json object { url?: string, cid?: string }
		constraint UserValid check on update (
			-- Must be associated with a keyholder
			exists (select 1 from Keyholder K where K.UserId = new.Id)
				-- or must be associated with an officer
				or exists (select 1 from Officer O where O.UserId = new.Id)
		),
		constraint UserKeyValid check on update (
			-- Must be a non-expired key for the user
			exists (select 1 from UserKey K where K.UserId = new.Id)
		),
		constraint CantDelete check on delete (false),
		constraint ValidModification check (new.Id = old.Id),
		-- TODO add check for valid update
		constraint InsertValid check on insert (
			-- First user in the network - no invite, no signing
			(context.SigningNonce is null and context.InviteSlotCid is null and context.InviteSignature is null and (select count(*) from User) = 1)
				-- or Valid Invite for this user
				or (context.SigningNonce is null and context.InviteSlotCid is not null and context.InviteSignature is not null
					and exists (
						select 1 from InviteSlot I where I.Cid = context.InviteSlotCid and I.InviteSignature = context.InviteSignature
					)
				)
		)
	)
		with context (SigningNonce text null, InviteSlotCid text null, InviteSignature text null, Tid int);

	table UserKey (
		UserId text, -- references future User.Id
		Type text, -- references UserKeyType(Code)
		PubKey text, -- paired private key is stored on the user''s device
		Expiration datetime,
		primary key (UserId, PubKey),
		constraint UserIdValid check (
			exists (select 1 from User U where U.Id = new.UserId)
		),
		constraint InsertValid check on insert (
			(
				(select count(*) from UserKey K where K.UserId = new.UserId) = 1
				and context.UserKey is null
			)
			or exists (
				select 1
				from UserKey K
				where K.UserId = new.UserId
					and K.PubKey = context.UserKey
					and K.Expiration > context.now
					and K.PubKey <> new.PubKey
			)
	),
		constraint DeleteValid check on delete (
				-- must be a non-expired key for the user
				exists (select 1 from UserKey K where K.UserId = old.UserId and K.PubKey = context.UserKey and K.Expiration > context.now)
					-- and not the last key for the user
					and exists (select 1 from UserKey K where K.UserId = old.UserId and K.PubKey <> old.PubKey)
		),
		constraint SignatureValid check (context.IsSignatureValid = true),
		constraint NoUpdate check on update (false),
		constraint ExpirationFuture check (Expiration > context.now)
	)
		with context ( UserKey text null, Signature text null, Tid int, now datetime, IsSignatureValid boolean );

	-- Append-only user-event log (ENG-02, D-13..D-18). One row per user mutation
	-- (create/revise/addKey/revokeKey), written in the same db.exec batch as the mutation.
	-- Sequence is the per-user monotonic ordering key (NOT a reuse of Tid, which resets per
	-- process). Signature is written null this phase (D-15, signature-honest schema; Phase 21
	-- fills content). A single JSON Payload column round-trips all four UserHistory subtypes
	-- (D-16). Non-signing this phase: no IsSignatureValid/IsUserValid context CHECK.
	table UserEvent (
		UserId text,
		Tid integer null, -- 999.1 D-06/D-08/R-05: queryable Tid backstop; back-derives coalesce(max(Tid),-1)+1
		Sequence integer not null, -- per-user monotonic ordering key (coalesce(max(Sequence),-1)+1)
		Event text, -- 'C' | 'R' | 'AK' | 'RK' (UserHistoryEvent)
		Timestamp datetime, -- nowCanonicalDatetime()
		Signature text null, -- D-15: written null now, real signature content arrives in Phase 21
		Payload text, -- JSON; subtype-specific shape (D-16)
		primary key (UserId, Sequence),
		constraint UserIdValid check (exists (select 1 from User U where U.Id = new.UserId)),
		constraint EventValid check (Event in ('C','R','AK','RK')),
		constraint InsertOnly check on update, delete (false)
	)
		-- 999.1: context param renamed Tid -> CtxTid to avoid a Quereus
		-- RegisteredScope symbol collision with the new persisted `Tid` column above (both a
		-- bare column and a bare context param named `Tid` in the same table register into the
		-- same INSERT compile scope -> "Symbol 'tid' already exists in the same scope"). No CHECK
		-- constraint references context.Tid yet (Phase 21 signature-CHECK addition should use
		-- context.CtxTid on this table specifically).
		with context ( CtxTid int, now datetime );

	table Election (
		Id text primary key, -- 32 byte random id
		AuthorityId text, -- authority that created the election
		Title text, -- title of the election
		Date datetime, -- date of the election
		RevisionDeadline datetime, -- deadline for making revisions to the election, cannot be revised itself
		BallotDeadline datetime, -- deadline for adding or revising ballots to the election
		Type text, -- references ElectionType(Code)
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint DateValid check (Date >= context.now),
		constraint RevisionDeadlineValid check (RevisionDeadline <= Date),
		constraint BallotDeadlineValid check (BallotDeadline <= Date),
		constraint TypeValid check (Type in (select Code from ElectionType)),
		-- TODO: constrain Timeline
		constraint InsertOnly check on update, delete (false),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = new.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(
							context.Tid, new.Id, new.AuthorityId, new.Title, new.Date, new.RevisionDeadline, new.BallotDeadline, new.Type
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now text );

	table ProposedElection (
		Id text primary key, -- 32 byte random id
		AuthorityId text, -- authority that created the election
		Title text, -- title of the election
		Date datetime, -- date of the election
		RevisionDeadline datetime, -- deadline for making revisions to the election, cannot be revised itself
		BallotDeadline datetime, -- deadline for adding or revising ballots to the election
		Type text, -- references ElectionType(Code)
		constraint UserValid check (context.IsUserValid = true)
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsUserValid boolean );

	table ElectionRevision (
		ElectionId text primary key, -- references Election.Id
		Revision integer, -- references Election.Revision
		RevisionTimestamp datetime, -- timestamp of the revision
		Tags text, -- json array of strings
		Instructions text, -- markdown instructions for the election
		Timeline text, -- json object { [ElectionEvent]: datetime }
		KeyholderThreshold integer, -- number of keyholders required to sign the election
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint ElectionIdImmutable check on update (new.ElectionId = old.ElectionId),
		constraint BeforeRevisionDeadline check (exists (select 1 from Election E where E.Id = new.ElectionId and E.RevisionDeadline > context.now)),
		constraint RevisionStart check on insert (Revision = 0),
		constraint RevisionMonotonic check on update (new.Revision = old.Revision + 1),
		constraint RevisionTimestampValid check (RevisionTimestamp < context.now
			and RevisionTimestamp < (select RevisionDeadline from Election E where E.Id = new.ElectionId)),
		constraint RevisionTimestampValidUpdate check on update (new.RevisionTimestamp > old.RevisionTimestamp),
		--TODO constrain Timeline
		constraint KeyholderThresholdValid check (KeyholderThreshold >= 0 and typeof(new.KeyholderThreshold) = 'integer'),
		constraint NoDelete check on delete (false),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce join Election E on E.Id = new.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(
							context.Tid, new.ElectionId, new.Revision, new.RevisionTimestamp, new.Tags, new.Instructions, new.Timeline, new.KeyholderThreshold
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now text );

	table ProposedElectionRevision (
		ElectionId text primary key, -- references Election.Id
		Revision integer, -- references Election.Revision
		RevisionTimestamp datetime, -- timestamp of the revision
		Tags text, -- json array of strings
		Instructions text, -- markdown instructions for the election
		Timeline text, -- json object { [ElectionEvent]: datetime }
		KeyholderThreshold integer, -- number of keyholders required to sign the election
		constraint ElectionIdValid check (
			exists (select 1 from Election E where E.Id = new.ElectionId)
				or -- the election is still being proposed
					exists (select 1 from ProposedElection PE where PE.Id = new.ElectionId)
		),
		constraint UserValid check (context.IsUserValid = true)
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsUserValid boolean );

	table Ballot (
		Id text primary key, -- 32 byte random id
		ElectionId text, -- references Election.Id
		AuthorityId text, -- authority that created the ballot
		Description text, -- description of the ballot
		Districts text, -- json array of strings
		constraint ElectionIdValid check on insert, update (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint ElectionIdImmutable check on update (new.ElectionId = old.ElectionId),
		constraint AuthorityIdValid check on insert, update (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint AuthorityIdImmutable check on update (new.AuthorityId = old.AuthorityId),
		constraint IdImmutable check on update (new.Id = old.Id),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce join Election E on E.Id = new.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = new.AuthorityId
						and E.BallotDeadline > context.now
						and A.Scope = 'ceb'
						and A.Digest = Digest(
							context.Tid, new.Id, new.ElectionId, new.AuthorityId, new.Description, new.Districts
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig
					join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = old.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = old.AuthorityId
						and E.BallotDeadline > context.now
						and A.Scope = 'ceb'
						and A.Digest = Digest(
							context.Tid, old.Id, 'delete'
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	table ProposedBallot (
		Id text primary key, -- 32 byte random id or references Ballot.Id
		ElectionId text, -- references Election.Id
		AuthorityId text, -- authority that created the ballot
		Description text, -- description of the ballot
		Districts text, -- json array of strings
		Questions text null, -- json array of Question objects (persisted alongside the ballot header so questions survive the proposed phase)
		constraint ElectionIdValid check on insert, update (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint AuthorityIdValid check on insert, update (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint UserValid check (context.IsUserValid = true)
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsUserValid boolean );

	table Question (
		BallotId text, -- references Ballot.Id
		Code text, -- code of the question
		Title text, -- title of the question
		Instructions text, -- markdown instructions for the question
		DependsOn text null, -- json object { code: string, valuesExpression: string }
		Type text, -- references QuestionType(Code)
		OptionRange text default '{1, 1}', -- json object { min: number, max: number }
		ScoreRange text null, -- json object { min: number, max: number, step: number }
		Grouping text null, -- grouping (hierarchy) of the question (group is a reserved word)
		Sequence integer null, -- sequence of the question within the group
		Required integer default 1, -- whether the question is required
		primary key (BallotId, Code),
		constraint BallotIdValid check on insert, update (exists (select 1 from Ballot B where B.Id = new.BallotId)),
		constraint BallotIdImmutable check on update (new.BallotId = old.BallotId),
		constraint CodeImmutable check on update (new.Code = old.Code),
		constraint TypeValid check on insert, update (Type in (select Code from QuestionType)),
		constraint SequenceValid check on insert, update (Sequence is null or (typeof(Sequence) = 'integer' and Sequence >= 0)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce join Ballot B on B.Id = new.BallotId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = B.AuthorityId
						and A.Scope = 'ceb'
						and A.Digest = Digest(
							context.Tid, new.BallotId, new.Code, new.Title, new.Instructions, new.DependsOn, new.Type, new.OptionRange, new.ScoreRange, new.Grouping, new.Sequence, new.Required
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Ballot B on B.Id = old.BallotId
					join Election E on E.Id = B.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = B.AuthorityId
						and E.BallotDeadline > context.now
						and A.Scope = 'ceb'
						and A.Digest = Digest(
							context.Tid, old.BallotId, 'delete'
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	table ProposedQuestion (
		BallotId text, -- references ProposedBallot.Id
		Code text, -- code of the question
		Title text, -- title of the question
		Instructions text, -- markdown instructions for the question
		DependsOn text null, -- json object { code: string, valuesExpression: string }
		Type text, -- references QuestionType(Code)
		OptionRange text default '{1, 1}', -- json object { min: number, max: number }
		ScoreRange text null, -- json object { min: number, max: number, step: number }
		Grouping text null, -- grouping (hierarchy) of the question (group is a reserved word)
		Sequence integer null, -- sequence of the question within the group
		Required integer default 1, -- whether the question is required
		constraint BallotIdValid check (exists (select 1 from Ballot B where B.Id = new.BallotId)),
		constraint TypeValid check (Type in (select Code from QuestionType)),
		constraint MutationValid check on insert, update (context.IsMutationValid = true)
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsMutationValid boolean );

	table Option (
		BallotId text, -- references Ballot.Id
		QuestionCode text, -- references Question.Code
		Code text, -- code of the option
		Sequence integer null, -- how to order the options within the question, lower numbers are shown first, equal numbers are randomized within the grouping
		Title text, -- title of the option
		Details text null, -- details of the option
		InfoURL text null, -- info URL of the option
		Image text null, -- json object { url?: string, cid?: string }
		Video text null, -- json object { url?: string, cid?: string }
		primary key (BallotId, QuestionCode, Code),
		constraint BallotIdValid check on insert, update (exists (select 1 from Ballot B where B.Id = new.BallotId)),
		constraint QuestionCodeValid check on insert, update (exists (select 1 from Question Q where Q.BallotId = new.BallotId and Q.Code = new.QuestionCode)),
		constraint BallotIdImmutable check on update (new.BallotId = old.BallotId),
		constraint QuestionCodeImmutable check on update (new.QuestionCode = old.QuestionCode),
		constraint CodeImmutable check on update (new.Code = old.Code),
		constraint SequenceValid check on insert, update (Sequence is null or (typeof(Sequence) = 'integer' and Sequence >= 0)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce join Ballot B on B.Id = new.BallotId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = B.AuthorityId
						and A.Scope = 'ceb'
						and A.Digest = Digest(
							context.Tid, new.BallotId, new.QuestionCode, new.Code, new.Sequence, new.Title, new.Details, new.InfoURL, new.Image, new.Video
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Ballot B on B.Id = old.BallotId
					join Election E on E.Id = B.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = B.AuthorityId
						and E.BallotDeadline > context.now
						and A.Scope = 'ceb'
						and A.Digest = Digest(
							context.Tid, old.BallotId, 'delete'
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	view QuestionType as
		select 'select' as Code, 'Select' as Name
		union all select 'rank' as Code, 'Rank' as Name
		union all select 'score' as Code, 'Score' as Name
		union all select 'text' as Code, 'Text' as Name;

	table ProposedOption (
		BallotId text, -- references ProposedBallot.Id
		QuestionCode text, -- references ProposedQuestion.Code
		Code text, -- code of the option
		Sequence integer null, -- how to order the options within the question, lower numbers are shown first, equal numbers are randomized within the grouping
		Title text, -- title of the option
		Details text null, -- details of the option
		InfoURL text null, -- info URL of the option
		Image text null, -- json object { url?: string, cid?: string }
		Video text null, -- json object { url?: string, cid?: string }
		constraint BallotIdValid check (exists (select 1 from Ballot B where B.Id = new.BallotId)),
		constraint QuestionCodeValid check (exists (select 1 from Question Q where Q.BallotId = new.BallotId and Q.Code = new.QuestionCode)),
		constraint BallotIdImmutable check on update (new.BallotId = old.BallotId),
		constraint QuestionCodeImmutable check on update (new.QuestionCode = old.QuestionCode),
		constraint CodeImmutable check on update (new.Code = old.Code),
		constraint SequenceValid check (Sequence is null or (typeof(Sequence) = 'integer' and Sequence >= 0)),
		constraint MutationValid check on insert, update (context.IsMutationValid = true)
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsMutationValid boolean );

	table Keyholder (
		ElectionId text, -- references Election.Id
		ElectionRevision integer, -- references ElectionRevision.Revision
		UserId text, -- the user associated with this keyholder
		primary key (ElectionId, ElectionRevision, UserId),
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint UserIdValid check (exists (select 1 from User U where U.Id = new.UserId)),
		constraint ElectionRevisionValid check (exists (select 1 from ElectionRevision ER where ER.ElectionId = new.ElectionId and ER.Revision = new.ElectionRevision)),
		constraint InsertValid check on insert (
			context.SigningNonce is null and context.InviteSlotCid is null and context.InviteSignature is null
		)
	)
		with context ( SigningNonce text null, InviteSlotCid text null, InviteSignature text null, Tid int );

	table Task (
		Id text primary key, -- 32 byte random id
		UserId text, -- references User.Id
		Type text, -- references TaskType(Code)
		SignatureType text null, -- references SignatureType(Code) only used for signature tasks
		SigningNonce text null, -- references AdminSigning.Nonce only used for signature tasks
		IsCompleted integer default 0, -- whether the task has been completed
		constraint UserIdValid check (exists (select 1 from User U where U.Id = new.UserId)),
		constraint TypeValid check (Type in (select Code from TaskType)),
		constraint SignatureTypeValid check (SignatureType in (select Code from SignatureType) or SignatureType is null),
		constraint UserIdImmutable check on update (new.UserId = old.UserId),
		constraint TypeImmutable check on update (new.Type = old.Type),
		constraint SignatureTypeImmutable check on update (new.SignatureType = old.SignatureType),
		constraint ExtensionExists check (
			(Type = 'release-key' and exists (select 1 from ReleaseKeyTaskExtension R where R.TaskId = new.Id))
				or ( Type = 'onboarding' and exists (select 1 from OnboardingTaskExtension O where O.TaskId = new.Id))
					or ( Type = 'signature' and (
						( SignatureType = 'network' and exists (select 1 from NetworkSignatureTaskExtension N where N.TaskId = new.Id))
							or ( SignatureType = 'authority' and exists (select 1 from AuthoritySignatureTaskExtension A where A.TaskId = new.Id))
							or ( SignatureType = 'admin' and exists (select 1 from AdminSignatureTaskExtension A where A.TaskId = new.Id))
							or ( SignatureType = 'election' and exists (select 1 from ElectionSignatureTaskExtension E where E.TaskId = new.Id))
							or ( SignatureType = 'election-revision' and exists (select 1 from ElectionRevisionSignatureTaskExtension ER where ER.TaskId = new.Id))
							or ( SignatureType = 'ballot' and exists (select 1 from BallotSignatureTaskExtension B where B.TaskId = new.Id))
					) )
		),
		constraint MutationValid check on insert, update (context.IsMutationValid = true)
	)
		with context ( IsMutationValid boolean, Tid int );

	table ReleaseKeyTaskExtension (
		TaskId text primary key, -- references Task.Id
		ElectionId text, -- references Election.Id
		ElectionRevision integer, -- references ElectionRevision.Revision
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'release-key')),
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint ElectionRevisionValid check (exists (select 1 from ElectionRevision ER where ER.ElectionId = new.ElectionId and ER.Revision = new.ElectionRevision))
	)
		with context ( Tid int );

	table NetworkSignatureTaskExtension (
		TaskId text primary key, -- references Task.Id
		NetworkName text, -- references Network.Name
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'network')),
		constraint NetworkIdValid check (exists (select 1 from ProposedNetwork N where N.Name = new.NetworkName)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce and A.Scope = 'rn'
					join ProposedNetwork N on N.Name = new.NetworkName
						where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'network'
							and T.IsCompleted = false
							and A.Digest = Digest(
								context.Tid, N.Name, N.ImageRef, N.Relays, N.TimestampAuthorities, N.NumberRequiredTSAs, N.ElectionType
							)
			)
			-- if the network change has been fully signed, no uncompleted tasks should be left
			and not exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
					join AdminSignature ASig on ASig.SigningNonce = A.Nonce
						where T.Id = new.TaskId and T.IsCompleted = false
			)
		),
		constraint DeleteValid check on delete (
			not exists (select 1 from Task T where T.Id = old.TaskId)
				or exists (select 1 from Task T where T.Id = old.TaskId and T.IsCompleted = true)
		)
	)
		with context ( Tid int );

	index NetworkSignatureTaskName on NetworkSignatureTaskExtension (NetworkName);

	table AuthoritySignatureTaskExtension (
		TaskId text primary key, -- references Task.Id
		AuthorityId text, -- references Authority.Id
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'authority')),
		constraint AuthorityIdValid check (exists (select 1 from ProposedAuthority A where A.Id = new.AuthorityId)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce and A.Scope = 'uai'
					join ProposedAuthority PA on PA.Id = new.AuthorityId
						where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'authority'
							and T.IsCompleted = false
							and A.Digest = Digest(
								context.Tid, PA.Id, PA.Name, PA.DomainName, PA.ImageRef
							)
			)
			-- if the authority change has been fully signed, no uncompleted tasks should be left
			and not exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
					join AdminSignature ASig on ASig.SigningNonce = A.Nonce
						where T.Id = new.TaskId and T.IsCompleted = false
			)
		),
		constraint DeleteValid check on delete (
			not exists (select 1 from Task T where T.Id = old.TaskId)
				or exists (select 1 from Task T where T.Id = old.TaskId and T.IsCompleted = true)
		)
	)
		with context ( Tid int );

	index AuthoritySignatureTaskId on AuthoritySignatureTaskExtension (AuthorityId);

	table AdminSignatureTaskExtension (
		TaskId text primary key, -- references Task.Id
		AuthorityId text, -- references Authority.Id
		AdminEffectiveAt datetime, -- references Admin.EffectiveAt
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'admin')),
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint AdminEffectiveAtValid check (exists (select 1 from Admin A where A.AuthorityId = new.AuthorityId and A.EffectiveAt = new.AdminEffectiveAt)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce and A.Scope = 'rad'
					join ProposedAdmin PA on PA.AuthorityId = new.AuthorityId and PA.EffectiveAt = new.AdminEffectiveAt
						where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'admin'
							and T.IsCompleted = false
							and A.Digest = Digest(
								context.Tid, PA.AuthorityId, PA.EffectiveAt, PA.ThresholdPolicies
							)
			)
			-- if the admin change has been fully signed, no uncompleted tasks should be left
			and not exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
					join AdminSignature ASig on ASig.SigningNonce = A.Nonce
						where T.Id = new.TaskId and T.IsCompleted = false
			)
		),
		constraint DeleteValid check on delete (
			not exists (select 1 from Task T where T.Id = old.TaskId)
				or exists (select 1 from Task T where T.Id = old.TaskId and T.IsCompleted = true)
		)
	)
		with context ( Tid int );

	index AdminSignatureTaskId on AdminSignatureTaskExtension (AuthorityId, AdminEffectiveAt);

	-- This is for creating a new election, revising an election uses the ElectionRevisionSignatureTaskExtension table
	table ElectionSignatureTaskExtension (
		TaskId text primary key, -- references Task.Id
		ElectionId text, -- references Election.Id
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'election')),
		constraint ElectionIdValid check (exists (select 1 from ProposedElection E where E.Id = new.ElectionId)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce and A.Scope = 'mel'
					join ProposedElection PE on PE.Id = new.ElectionId
						where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'election'
							and T.IsCompleted = false
							and A.Digest = Digest(
								context.Tid, PE.Id, PE.AuthorityId, PE.Title, PE.Date, PE.RevisionDeadline, PE.BallotDeadline, PE.Type
							)
			)
			-- if the election has been fully signed, no uncompleted tasks should be left
			and not exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
					join AdminSignature ASig on ASig.SigningNonce = A.Nonce
						where T.Id = new.TaskId and T.IsCompleted = false
			)
		),
		constraint DeleteValid check on delete (
			not exists (select 1 from Task T where T.Id = old.TaskId)
				or exists (select 1 from Task T where T.Id = old.TaskId and T.IsCompleted = true)
		)
	)
		with context ( Tid int );

	index ElectionSignatureTaskId on ElectionSignatureTaskExtension (ElectionId);

	table ElectionRevisionSignatureTaskExtension (
		TaskId text primary key, -- references Task.Id
		ElectionId text, -- references Election.Id
		ElectionRevision integer, -- references ElectionRevision.Revision
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'election-revision')),
		constraint ElectionIdValid check (exists (select 1 from ProposedElectionRevision ER where ER.ElectionId = new.ElectionId and ER.Revision = new.ElectionRevision)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce and A.Scope = 'mel'
					join ProposedElectionRevision PER on PER.ElectionId = new.ElectionId and PER.Revision = new.ElectionRevision
						where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'election-revision'
							and T.IsCompleted = false
							and A.Digest = Digest(
								context.Tid, PER.ElectionId, PER.Revision, PER.RevisionTimestamp, PER.Tags, PER.Instructions, PER.Timeline, PER.KeyholderThreshold
							)
			)
			-- if the election revision has been fully signed, no uncompleted tasks should be left
			and not exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
					join AdminSignature ASig on ASig.SigningNonce = A.Nonce
						where T.Id = new.TaskId and T.IsCompleted = false
			)
		),
		constraint DeleteValid check on delete (
			not exists (select 1 from Task T where T.Id = old.TaskId)
				or exists (select 1 from Task T where T.Id = old.TaskId and T.IsCompleted = true)
		)
	)
		with context ( Tid int );

	index ElectionRevisionSignatureTaskId on ElectionRevisionSignatureTaskExtension (ElectionId, ElectionRevision);

	table BallotSignatureTaskExtension (
		TaskId text primary key, -- references Task.Id
		BallotId text, -- references Ballot.Id
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'ballot')),
		constraint BallotIdValid check (exists (select 1 from ProposedBallot B where B.Id = new.BallotId)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce and A.Scope = 'ceb'
					join ProposedBallot PB on PB.Id = new.BallotId
						where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'ballot'
							and T.IsCompleted = false
							and A.Digest = Digest(
								context.Tid, PB.Id, PB.ElectionId, PB.AuthorityId, PB.Description, PB.Districts
							)
			)
			-- if the ballot has been fully signed, no uncompleted tasks should be left
			and not exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
					join AdminSignature ASig on ASig.SigningNonce = A.Nonce
						where T.Id = new.TaskId and T.IsCompleted = false
			)
		),
		constraint DeleteValid check on delete (
			not exists (select 1 from Task T where T.Id = old.TaskId)
				or exists (select 1 from Task T where T.Id = old.TaskId and T.IsCompleted = true)
		)
	)
		with context ( Tid int );

	index BallotSignatureTaskBallot on BallotSignatureTaskExtension (BallotId);

	table OnboardingTaskExtension (
		TaskId text primary key, -- references Task.Id
		OnboardingId text, -- references Onboarding.Id
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'onboarding')),
		constraint OnboardingIdValid check (exists (select 1 from Onboarding O where O.Id = new.OnboardingId))
	)
		with context ( Tid int );

	table Onboarding (
		Id text primary key, -- 32 byte random id
		-- TODO: Add whatever onboarding tasks will need
		constraint InsertOnly check on update, delete (false)
	)
		with context ( Tid int );

	view TaskType as
		select 'release-key' as Code
		union all select 'signature' as Code
		union all select 'onboarding' as Code;

	view SignatureType as
		select 'admin' as Code
		union all select 'authority' as Code
		union all select 'network' as Code
		union all select 'election' as Code
		union all select 'election-revision' as Code
		union all select 'ballot' as Code;

	-- ═══════════════════════════════════════════════════════════════════════
	-- Registration
	-- Voter registration, device association + attestation, authority peers, polling devices
	-- ═══════════════════════════════════════════════════════════════════════

	view RegistrantStatus as
		select 'a' as Code, 'Active' as Name
		union all select 's', 'Suspended'
		union all select 'r', 'Revoked';

	table Registrant (
		Id text primary key, -- 32 byte random unique registrant identifier
		AuthorityId text, -- authority that validated this registrant
		PrivateCid text, -- content-addressed hash of the registrant's private data
		PublicCid text null, -- content-addressed hash of the registrant's public data (null if no public data)
		SelectiveCid text null, -- content-addressed hash of the registrant's selective-disclosure data (null if none)
		Status text default 'a', -- references RegistrantStatus(Code)
		Expiration datetime,
		SignorKey text, -- public key of the authority signor
		Signature text, -- signature of this record by the signor
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint StatusValid check (Status in (select Code from RegistrantStatus)),
		constraint ExpirationValid check (isISODatetime(Expiration) and like('%Z', Expiration)),
		constraint ExpirationFuture check on insert (Expiration > context.now),
		constraint IdImmutable check on update (new.Id = old.Id),
		constraint AuthorityIdImmutable check on update (new.AuthorityId = old.AuthorityId),
		constraint SignatureValid check (
			SignatureValid(
				Digest(Id, AuthorityId, PrivateCid, PublicCid, SelectiveCid, Status, Expiration),
				Signature,
				SignorKey
			)
		),
		constraint NoDelete check on delete (false),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = new.AuthorityId
						and A.Scope = 'vrg'
						and A.Digest = Digest(
							context.Tid, new.Id, new.AuthorityId, new.PrivateCid, new.PublicCid, new.SelectiveCid, new.Status, new.Expiration, new.SignorKey, new.Signature
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	table RegistrantPublic (
		Cid text, -- content-addressed hash of this record
		RegistrantId text, -- references Registrant.Id
		LastName text null,
		FirstName text null,
		District text null,
		ExtraFields text null, -- json object for authority-specific public fields
		primary key (RegistrantId, Cid), -- registrant-clustered storage key (one ranged fetch per registrant); Cid retains its content-integrity role
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId)),
		constraint CidValid check (Cid = cid(Digest(RegistrantId, LastName, FirstName, District, ExtraFields))),
		constraint RegistrantCidMatch check (exists (select 1 from Registrant R where R.Id = new.RegistrantId and R.PublicCid = new.Cid)),
		constraint InsertOnly check on update, delete (false),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = new.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, new.Cid, new.RegistrantId, new.LastName, new.FirstName, new.District, new.ExtraFields
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int );

	-- Authority-held private registrant data (not replicated to the public Election Network).
	-- Referenced by Registrant.PrivateCid; Registrant.Signature commits to this record via that hash.
	-- PrivateDetails is a json array of attribute triples { name, value, hint? } where `value` is
	-- either a scalar (a top-level field) or a nested array of the same triples (an object), and
	-- `hint` is optional validation metadata. PrivateDetails is NEVER disclosed; the selectively-
	-- disclosable tier lives in RegistrantSelective (separate Cid) so it can be revealed without
	-- exposing this record.
	table RegistrantPrivate (
		Cid text, -- content-addressed hash of this record
		RegistrantId text, -- references Registrant.Id
		Expiration datetime,
		PrivateDetails text null, -- json array of { name, value, hint? } triples (recursive); never disclosed
		primary key (RegistrantId, Cid), -- registrant-clustered storage key (one ranged fetch per registrant); Cid retains its content-integrity role
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId)),
		constraint ExpirationValid check (isISODatetime(Expiration) and like('%Z', Expiration)),
		constraint ExpirationFuture check on insert (Expiration > context.now),
		constraint CidValid check (Cid = cid(Digest(RegistrantId, Expiration, PrivateDetails))),
		constraint RegistrantCidMatch check (exists (select 1 from Registrant R where R.Id = new.RegistrantId and R.PrivateCid = new.Cid)),
		constraint InsertOnly check on update, delete (false),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = new.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, new.Cid, new.RegistrantId, new.Expiration, new.PrivateDetails
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	-- Authority-held selective-disclosure registrant data, committed SEPARATELY from PrivateDetails
	-- (own Cid, referenced by Registrant.SelectiveCid, covered by Registrant.Signature). Committed as a
	-- FLAT SALTED-LEAF SET (not a whole-set hash, not a Merkle tree) via the crypto plugin's set_commit:
	-- each attribute is a salted leaf leafDigest = digest([SD_LEAF_DOMAIN, name, value, salt]) and
	-- Cid = cid(set_commit(SelectiveDetails)) over the sorted leaf digests. This enables PER-FIELD
	-- selective disclosure: the engine reveals a subset via setDisclose(leaves, revealNames) and a
	-- recipient checks it with setVerify(root, disclosure) WITHOUT access to the hidden leaves or to
	-- PrivateDetails. Which fields are disclosed and to whom (e.g. same-district neighbors, or everyone)
	-- is decided per-election by ElectionDisclosurePolicy. Salts are random_bytes (>=128 bits); duplicate
	-- names and empty salts are rejected at commit. (Ref: Optimystic issue #5 — the landed flat-set design.)
	table RegistrantSelective (
		Cid text, -- content-addressed CIDv1 of this record: cid(set_commit(SelectiveDetails))
		RegistrantId text, -- references Registrant.Id
		Expiration datetime,
		SelectiveDetails text null, -- json array of flat { name, value, salt } salted leaves (SaltedLeaf[]); disclosed per-field per election policy via setDisclose/setVerify
		primary key (RegistrantId, Cid), -- registrant-clustered storage key (one ranged fetch per registrant); Cid retains its content-integrity role
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId)),
		constraint ExpirationValid check (isISODatetime(Expiration) and like('%Z', Expiration)),
		constraint ExpirationFuture check on insert (Expiration > context.now),
		constraint CidValid check (Cid = cid(set_commit(SelectiveDetails))),
		constraint RegistrantCidMatch check (exists (select 1 from Registrant R where R.Id = new.RegistrantId and R.SelectiveCid = new.Cid)),
		constraint InsertOnly check on update, delete (false),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = new.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, new.Cid, new.RegistrantId, new.Expiration, new.SelectiveDetails
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	table ElectionRegistrant (
		ElectionId text,
		RegistrantId text,
		primary key (ElectionId, RegistrantId),
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId and R.Status = 'a')),
		constraint RegistrantNotExpired check (exists (select 1 from Registrant R where R.Id = new.RegistrantId and R.Expiration > context.now)),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = new.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, new.ElectionId, new.RegistrantId
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = old.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, old.ElectionId, old.RegistrantId, 'delete'
						)
			)
		),
		constraint NoUpdate check on update (false)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	index ElectionRegistrantRegistrant on ElectionRegistrant (RegistrantId);

	-- Authority-issued device-attestation challenge. Before a device can Associate, the authority issues
	-- a one-time nonce bound to (RegistrantId, DeviceKey); the device's platform attestation (iOS App
	-- Attest / Android Play Integrity) must answer this exact nonce. Short-lived (Expiration). One-time
	-- use is structural, not a cross-row check: the resulting Association PK is (RegistrantId, DeviceKey),
	-- so one satisfied challenge cannot yield a second association, and the nonce is bound to a single
	-- registrant+device so it cannot be replayed elsewhere. The authority deletes the challenge once
	-- consumed. Issuance/deletion are authority-authorized under the 'vrg' scope.
	table AttestationChallenge (
		Nonce text primary key, -- random challenge nonce the device must attest against
		AuthorityId text, -- issuing authority
		RegistrantId text, -- registrant this challenge is bound to
		DeviceKey text, -- device voting public key this challenge is bound to
		Expiration datetime, -- short TTL
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId and R.Status = 'a')),
		constraint ExpirationValid check (isISODatetime(Expiration) and like('%Z', Expiration)),
		constraint ExpirationFuture check on insert (Expiration > context.now),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = new.AuthorityId
						and A.Scope = 'vrg'
						and A.Digest = Digest(
							context.Tid, new.Nonce, new.AuthorityId, new.RegistrantId, new.DeviceKey, new.Expiration
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = old.AuthorityId
						and A.Scope = 'vrg'
						and A.Digest = Digest(
							context.Tid, old.Nonce, 'delete'
						)
			)
		),
		constraint NoUpdate check on update (false)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	table Association (
		RegistrantId text,
		DeviceKey text, -- public key for voting; private key in biometrically secured TPM
		DeviceHash text null, -- sha256 hash of the device's ID (not the ID itself, for privacy); null = device uniqueness not publicly disclosed (transparency toggle off)
		AttestationCid text null, -- content-addressed hash of the authority-held AssociationPrivate (device attestation); null = no attestation committed on-network (e.g. self-signed/legacy)
		Expiration datetime,
		SignorKey text, -- public key of the authority signor
		Signature text, -- signature of this record by the signor
		primary key (RegistrantId, DeviceKey),
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId and R.Status = 'a')),
		constraint ExpirationValid check (isISODatetime(Expiration) and like('%Z', Expiration)),
		constraint ExpirationFuture check on insert (Expiration > context.now),
		constraint SignatureValid check (
			SignatureValid(
				Digest(RegistrantId, DeviceKey, DeviceHash, AttestationCid, Expiration),
				Signature,
				SignorKey
			)
		),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = new.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, new.RegistrantId, new.DeviceKey, new.DeviceHash, new.AttestationCid, new.Expiration, new.SignorKey, new.Signature
						)
			)
		),
		constraint NoUpdate check on update (false),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = old.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, old.RegistrantId, old.DeviceKey, 'delete'
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	index AssociationDeviceHash on Association (DeviceHash);

	view CurrentAssociation as
		select A.RegistrantId, A.DeviceKey, A.DeviceHash, A.Expiration
			from Association A
			join Registrant R on R.Id = A.RegistrantId
			where A.Expiration > datetime('now') and R.Status = 'a' and R.Expiration > datetime('now');

	-- Authority-held private device-association data (not replicated to the public Election Network).
	-- Referenced by Association.AttestationCid; Association.Signature commits to this record via that hash.
	-- Holds the sensitive device attestation: DeviceId can deanonymize/track a voter, so it never leaves
	-- the authority (the public Association exposes at most DeviceHash = sha256(DeviceId), transparency
	-- toggle). DeviceId, AttestationTime and Nonce are promoted for authority-side uniqueness/replay
	-- checks; AttestationDetails carries the platform-specific remainder of the DeviceAttestation struct
	-- ({ location?, attestationStatement?, certificateChain, platformDetails? }).
	table AssociationPrivate (
		Cid text, -- content-addressed hash of this record
		RegistrantId text, -- references Registrant.Id
		DeviceKey text, -- public voting key of the associated device (links to Association)
		DeviceId text, -- actual device / app-install id (sensitive; authority-held only)
		AttestationTime datetime, -- when the platform attestation was performed
		Nonce text, -- the AttestationChallenge nonce this attestation answered
		AttestationDetails text null, -- json object: remaining DeviceAttestation fields { location?, attestationStatement?, certificateChain, platformDetails? }
		Expiration datetime,
		primary key (RegistrantId, DeviceKey, Cid), -- registrant-clustered storage key (one ranged fetch per registrant); Cid retains its content-integrity role
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId)),
		constraint AttestationTimeValid check (isISODatetime(AttestationTime) and like('%Z', AttestationTime)),
		constraint ExpirationValid check (isISODatetime(Expiration) and like('%Z', Expiration)),
		constraint ExpirationFuture check on insert (Expiration > context.now),
		constraint CidValid check (Cid = cid(Digest(RegistrantId, DeviceKey, DeviceId, AttestationTime, Nonce, AttestationDetails, Expiration))),
		constraint AssociationCidMatch check (exists (select 1 from Association A where A.RegistrantId = new.RegistrantId and A.DeviceKey = new.DeviceKey and A.AttestationCid = new.Cid)),
		constraint ChallengeValid check (exists (select 1 from AttestationChallenge C where C.Nonce = new.Nonce and C.RegistrantId = new.RegistrantId and C.DeviceKey = new.DeviceKey)),
		constraint InsertOnly check on update, delete (false),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = new.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, new.Cid, new.RegistrantId, new.DeviceKey, new.DeviceId, new.AttestationTime, new.Nonce, new.AttestationDetails, new.Expiration
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	table AuthorityPeer (
		AuthorityId text,
		PeerId text,
		primary key (AuthorityId, PeerId),
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = new.AuthorityId
						and A.Scope = 'cap'
						and A.Digest = Digest(
							context.Tid, new.AuthorityId, new.PeerId
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = old.AuthorityId
						and A.Scope = 'cap'
						and A.Digest = Digest(
							context.Tid, old.AuthorityId, old.PeerId, 'delete'
						)
			)
		),
		constraint NoUpdate check on update (false)
	)
		with context ( SigningNonce text, Tid int );

	table PollingDevice (
		AuthorityId text,
		DeviceHash text, -- sha256 hash of the device ID
		Label text null, -- human-readable label for the polling location/device
		primary key (AuthorityId, DeviceHash),
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = new.AuthorityId
						and A.Scope = 'vrg'
						and A.Digest = Digest(
							context.Tid, new.AuthorityId, new.DeviceHash, new.Label
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = old.AuthorityId
						and A.Scope = 'vrg'
						and A.Digest = Digest(
							context.Tid, old.AuthorityId, old.DeviceHash, 'delete'
						)
			)
		),
		constraint NoUpdate check on update (false)
	)
		with context ( SigningNonce text, Tid int );

	view RegistrantTier as
		select 'public' as Code, 'Public' as Name
		union all select 'selective' as Code, 'Selective' as Name
		union all select 'private' as Code, 'Private' as Name;

	view FieldRequirement as
		select 'required' as Code, 'Required' as Name
		union all select 'optional' as Code, 'Optional' as Name;

	-- Election policy: the per-election registration field schema — which registrant detail fields this
	-- election expects, which tier (public / selective / private) each belongs to, and whether furnishing
	-- it is required to register. Companion to ElectionDisclosurePolicy (which maps a selective field name
	-- to an audience). A field's Tier says which record its value lands in: RegistrantPublic (a column or
	-- an ExtraFields entry), RegistrantSelective.SelectiveDetails, or RegistrantPrivate.PrivateDetails.
	-- Admin-signed under the 'mel' (Manage Elections) scope, keyed by ElectionId (per-election, not
	-- network-wide). Enforcement that a Register submission actually furnishes the Required fields in the
	-- correct tier is engine-side at Register time — the schema declares the policy; the engine validates
	-- submissions against it. (Requirement/Tier are text codes, not integer/boolean columns, to avoid the
	-- Quereus number-in-Digest coercion and boolean-default re-attach ALTER COLUMN pitfalls.)
	table ElectionRegistrationField (
		ElectionId text, -- references Election.Id
		FieldName text, -- attribute name (a RegistrantPublic column / ExtraFields key, or a top-level name within SelectiveDetails / PrivateDetails)
		Tier text, -- references RegistrantTier(Code)
		Requirement text, -- references FieldRequirement(Code)
		primary key (ElectionId, FieldName),
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint TierValid check (Tier in (select Code from RegistrantTier)),
		constraint RequirementValid check (Requirement in (select Code from FieldRequirement)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = new.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(
							context.Tid, new.ElectionId, new.FieldName, new.Tier, new.Requirement
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = old.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(
							context.Tid, old.ElectionId, old.FieldName, old.Tier, old.Requirement, 'delete'
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int );

	index ElectionRegistrationFieldElection on ElectionRegistrationField (ElectionId);

	view DisclosureAudience as
		select 'district' as Code, 'Same district (neighboring voters)' as Name
		union all select 'everyone' as Code, 'Everyone' as Name;

	-- Election policy: which RegistrantSelective field/object names may be disclosed, and to which
	-- audience, for a given election. The selective set itself is committed authority-side
	-- (RegistrantSelective / Registrant.SelectiveCid); this table only declares the disclosure
	-- intent per election (keyed by ElectionId). Delivery/filtering of disclosed data to
	-- recipients is handled off-schema by the engine/app at query time (no on-network disclosure
	-- record). Whole-set commitment (option B) means a disclosed subset is authority-vouched, not
	-- independently verifiable against SelectiveCid.
	table ElectionDisclosurePolicy (
		ElectionId text, -- references Election.Id
		FieldName text, -- a top-level attribute name within RegistrantSelective.SelectiveDetails
		Audience text, -- references DisclosureAudience(Code)
		primary key (ElectionId, FieldName),
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint AudienceValid check (Audience in (select Code from DisclosureAudience)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = new.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(
							context.Tid, new.ElectionId, new.FieldName, new.Audience
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = old.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(
							context.Tid, old.ElectionId, old.FieldName, old.Audience, 'delete'
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int );

	index ElectionDisclosurePolicyElection on ElectionDisclosurePolicy (ElectionId);
}

apply schema main;