declare schema main

{
	view ElectionType as
		select 'o' as Code, 'Official' as Name
		union all select 'a' as Code, 'Adhoc' as Name;

	-- Internal allocator table (999.1 D-05): durable, namespace-keyed Tid high-water mark.
	-- Never user-supplied, so it carries no signature/context CHECKs. PK is Namespace so every
	-- allocator read/write is a point lookup (where Namespace = :ns), never a full scan --
	-- mirrors the LevelDB-vtab-safety discipline of the legacy TidSequence table.
	table TidHighWater (
		Namespace text primary key,
		HighWater integer not null
	);

	table Network (
		Id text, -- 32 byte random id
		Hash text, -- H16(Id)
		PrimaryAuthorityId text,
		Name text,
		ImageRef text null, -- json object { url?: string, cid?: string }
		Relays text, -- json array of strings - TODO: constraint
		TimestampAuthorities text, -- json array of { url: string } - TODO: constraint
		NumberRequiredTSAs integer default 0,
		ElectionType text, -- references ElectionType(Code)
		primary key (),
		constraint CantDelete check on delete (false),
		constraint IdImmutable check on update (new.Id = old.Id),
		-- TODO: constraint HashValid check on insert (Hash = H16(Id)),
		constraint HashImmutable check on update (new.Hash = old.Hash),
		constraint PrimaryAuthorityIdImmutable check on update (new.PrimaryAuthorityId = old.PrimaryAuthorityId),
		constraint PrimaryAuthorityIdValid check on insert (exists (select 1 from Authority A where A.Id = new.PrimaryAuthorityId)),
		-- TODO: constraint ImageRefValid check (ImageRef is a valid image reference JSON)
		-- TODO: constraint RelaysValid check (Relays is a valid array of strings)
		-- TODO: constraint TimestampAuthoritiesValid check (TimestampAuthorities is a valid array of { url: string })
		constraint NumberRequiredTSAsValid check (NumberRequiredTSAs >= 0 and typeof(new.NumberRequiredTSAs) = 'integer'),
		constraint ElectionTypeValid check (ElectionType in (select Code from ElectionType)),
		constraint NoSigningNonceOnInsert check on insert (context.SigningNonce is null),
		constraint UpdateNetworkValid check on update (
				context.SigningNonce is not null
				and exists (
					select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
						where A.Nonce = context.SigningNonce
							-- Only the primary authority can update the network
							and A.AuthorityId = new.PrimaryAuthorityId
							and A.Scope = 'rn'
							and A.Digest = Digest(
								context.Tid, new.Id, new.Name, new.ImageRef, new.Relays, new.TimestampAuthorities, new.NumberRequiredTSAs, new.ElectionType
							)
			)
		)
	)
		with context ( SigningNonce text null, Tid int );

	view Scope as
		select 'rn' as Code, 'Revise Network' as Name
		union all select 'rad' as Code, 'Revise or replace the Admin' as Name
		union all select 'vrg' as Code, 'Validate registrations' as Name
		union all select 'iad' as Code, 'Invite other Authorities' as Name
		union all select 'uai' as Code, 'Update Authority Information' as Name
		union all select 'ceb' as Code, 'Create/Edit ballot templates' as Name
		union all select 'mel' as Code, 'Manage Elections' as Name
		union all select 'cap' as Code, 'Configure Authority Peers' as Name
		-- second-keyholder-invite-unique fix (2026-07-30): dedicated scope for admin
		-- approval of a keyholder InviteSlot, mirroring 'iad' (invite authorities) /
		-- 'rad' (invite officers via the Admin threshold) — keyholder invites get
		-- their own approval scope rather than overloading 'mel'.
		union all select 'ik' as Code, 'Invite Keyholders' as Name;

	table Authority (
		Id text primary key, -- 32 byte random id
		Name text,
		DomainName text null,
		ImageRef text null, -- json object { url?: string, cid?: string }
		constraint CantDelete check on delete (false),
		constraint AdminRequired check on update (exists (select 1 from Admin A where A.AuthorityId = new.Id)),
		constraint IdImmutable check on update (new.Id = old.Id),
		-- TODO: constraint ImageRefValid check (ImageRef is a valid image reference JSON)
		constraint InsertValid check on insert (
			-- Very first authority in the network - shoe-in, no Invite, no signing
			(context.SigningNonce is null and context.InviteSignature is null and (select count(*) from Authority) = 1)
				-- or Valid Invite for this authority (D-07b: existence-only; cryptographic binding moved to Admin.MutationValid TX3)
				or (context.InviteSlotCid is not null and context.InviteSignature is not null
					and exists (
						select 1 from InviteResult I where I.SlotCid = context.InviteSlotCid and I.IsAccepted
					)
				)
		),
		constraint UpdateValid check on update (
			context.SigningNonce is not null and context.InviteSlotCid is null and context.InviteSignature is not null
			and exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.Scope = 'uai'
						and A.Digest = Digest(
							context.Tid, new.Name, new.DomainName, new.ImageRef
						)
			)
		)
	)
		with context ( SigningNonce text null, InviteSlotCid text null, InviteSignature text null, Tid int );
	-- Tid is assumed to be a unique transaction identifier that ensures that an update can''t be repeated with the same credentials. Provided internally, not by the user

	-- Administration
	table Admin (
		AuthorityId text,
		EffectiveAt datetime,
		ThresholdPolicies text default '[]', -- json array of { scope: string, threshold: integer } - if not set for a scope, 1 is assumed
		primary key (AuthorityId, EffectiveAt),
		constraint OfficerRequired check on update (
			exists (select 1 from Officer O where O.AuthorityId = new.AuthorityId and O.AdminEffectiveAt = new.EffectiveAt
				and exists (select 1 from json_each(O.Scopes) where value = 'rad')
			)
		),
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint EffectiveAtValid check (EffectiveAt is not null),
		-- TODO: constraint ThresholdPoliciesValid check (valid json array of { scope: string, threshold: integer })
		constraint MutationValid check (
			-- Initial admin for the first authority - no invite, no signing
			(
				context.SigningNonce is null and context.InviteSlotCid is null and context.InviteSignature is null
					and old.AuthorityId is null -- an insertion
					and not exists (select 1 from Authority where Id <> new.AuthorityId)
			)
				-- or, if an invite is present this is a new authority - invite is valid
				or (
					context.SigningNonce is null and context.InviteSlotCid is not null and context.InviteSignature is not null
						and old.AuthorityId is null -- an insertion
						and exists (
							select 1 from InviteResult I join Authority A on A.Id = new.AuthorityId
							where I.SlotCid = context.InviteSlotCid and I.IsAccepted
								and I.Digest = Digest(
									context.Tid, A.Id, A.Name, A.DomainName, A.ImageRef,
									(select Digest(EffectiveAt, ThresholdPolicies)
											from Admin A where A.AuthorityId = new.AuthorityId and A.EffectiveAt = new.EffectiveAt),
									-- D-09: sort + bind first officer to make the multi-row scalar subquery deterministic under quereus 3.3.0
									(select Digest(AdminEffectiveAt, UserId, Title, Scopes)
										from (select * from Officer where AuthorityId = new.AuthorityId and AdminEffectiveAt = new.EffectiveAt order by UserId asc limit 1))
								)
						)
				)
				-- or, if a signing nonce is present this is a new or updated administration for existing authority - signing nonce is valid
				or (
					context.SigningNonce is not null and context.InviteSlotCid is null and context.InviteSignature is null
						and exists (
							select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
								where A.Nonce = context.SigningNonce
									and A.Digest = Digest(
										context.Tid, new.AuthorityId,
										(select Digest(EffectiveAt, ThresholdPolicies)
												from Admin Ad where Ad.AuthorityId = new.AuthorityId and Ad.EffectiveAt = new.EffectiveAt),
										-- D-09: sort + bind first officer to make the multi-row scalar subquery deterministic under quereus 3.3.0
										(select Digest(AdminEffectiveAt, UserId, Title, Scopes)
												from (select * from Officer where AuthorityId = new.AuthorityId and AdminEffectiveAt = new.EffectiveAt order by UserId asc limit 1))
									)
						)
				)
		)
	)
		with context ( SigningNonce text null, InviteSlotCid text null, InviteSignature text null, Tid int );

	view CurrentAdmin as
		select AuthorityId, max(EffectiveAt) as EffectiveAt
			from Admin
			where EffectiveAt <= datetime('now')
			group by AuthorityId;

	table Officer (
		AuthorityId text,
		AdminEffectiveAt datetime,
		UserId text,
		Title text,
		Scopes text default '[]', -- json array of strings
		primary key (AuthorityId, AdminEffectiveAt, UserId),
		-- NOT NEEDED - AuthorityId is validated through Admin
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint AdminValid check (
			-- D-07d: non-invite path keeps the strong FK check (Admin must exist before Officer);
			-- invite-bound path defers FK enforcement to Admin.MutationValid TX3 (D-07a insert order: Authority → Officer → Admin)
			((context.InviteSlotCid is null or context.InviteSignature is null) and exists (select 1 from Admin A where A.AuthorityId = new.AuthorityId and A.EffectiveAt = new.AdminEffectiveAt))
				or (context.InviteSlotCid is not null and context.InviteSignature is not null)
		),
		constraint UserIdValid check (exists (select 1 from User U where U.Id = new.UserId)),
		constraint ScopesValid check (not exists (select 1 from json_each(Scopes) where value not in (select Code from Scope))), -- throwing errors
		constraint OnlyInsert check on update, delete (false),
		constraint InsertValid check on insert (
			-- part of the very first authority in the network - no invite, no signing
			(context.SigningNonce is null and context.InviteSlotCid is null and context.InviteSignature is null and (select count(*) from Authority) = 1)
			-- part of the first admin for an authority - invite is valid (D-07c: existence-only; cryptographic binding moved to Admin.MutationValid TX3; Authority count relaxed to 1 per D-07a insert order)
				or (context.SigningNonce is null and context.InviteSlotCid is not null and context.InviteSignature is not null
					and (select count(*) from Authority where Id = new.AuthorityId) = 1
						and exists (
							select 1 from InviteResult I
							where I.SlotCid = context.InviteSlotCid and I.IsAccepted
						)
				)
				-- or, if a signing nonce is present this is a new or updated administration for existing authority - signing nonce is valid
				or (context.SigningNonce is not null and context.InviteSlotCid is null and context.InviteSignature is null
					and exists (
							select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
								where A.Nonce = context.SigningNonce
									and A.Digest = Digest(
										context.Tid, new.AuthorityId,
										(select Digest(EffectiveAt, ThresholdPolicies)
												from Admin Ad where Ad.AuthorityId = new.AuthorityId and Ad.EffectiveAt = new.AdminEffectiveAt),
										-- D-09: sort + bind first officer to make the multi-row scalar subquery deterministic under quereus 3.3.0
										(select Digest(AdminEffectiveAt, UserId, Title, Scopes)
												from (select * from Officer where AuthorityId = new.AuthorityId and AdminEffectiveAt = new.AdminEffectiveAt order by UserId asc limit 1))
									)
						)
				)
		)
	)
		with context ( SigningNonce text null, InviteSlotCid text null, InviteSignature text null, Tid int );

	index OfficerUser on Officer(UserId); -- include (Scopes)

	-- A signing "session" for an Admin
	table AdminSigning (
		Nonce text primary key, -- Random ID
		AuthorityId text,
		AdminEffectiveAt datetime,
		Scope text, -- references Scope(Code)
		Digest text, -- Content hash to be signed - Base64url encoded sha256
		UserId text, -- Officer who is instigator the signing session
		SignerKey text, -- Instigator's signing key
		Signature text, -- Instigator's signature of this row
		constraint InsertOnly check on update, delete (false),
		constraint ScopeValid check (exists (select 1 from Scope S where S.Code = new.Scope)),
		constraint UserIdValid check (exists (
			select 1 from Officer O
				where O.UserId = new.UserId
					and O.AdminEffectiveAt = new.AdminEffectiveAt
					and O.AuthorityId = new.AuthorityId
		)),
		-- 999.1 D-13: SignerKeyValid stays a stub — a real EXISTS-against-UserKey fold would need every
		-- producer (real + placeholder) to bind a currently-registered UserKey.PubKey, which is not
		-- guaranteed across today's call sites (some device/test keys are never inserted into UserKey);
		-- deferred, tracked here rather than silently closed.
		constraint SignerKeyValid check (context.IsSignerKeyValid = true),
		-- 999.1 R-02: real in-schema verification via the SignatureValid UDF (same seam initialize.ts's
		-- verifySig() registers, shared with Registrant/Association). IsPlaceholderSignature is a narrow,
		-- explicit escape hatch for the carried DEBT-11 ad-hoc/system-derived signing ceremonies
		-- (election-engine.ts submitBallotForConfirmation's initially-unsigned header row,
		-- signature-tasks-engine.ts finalizeBallot's per-question/option rows, elections-engine.ts
		-- debugSeedPendingTasks, and -- WR-07, added by Phase 48 --
		-- signature-tasks-engine.ts seedRegistrantSignatureTasks's per-request AdminSigning('vrg')
		-- row) that intentionally carry no real crypto — those call sites are the ONLY
		-- ones permitted to bind IsPlaceholderSignature = true; every other producer leaves it at its
		-- default (false) and must supply a real, verifiable signature.
		-- Why the seedRegistrantSignatureTasks producer is correct here (WR-07): the seed step runs
		-- at INBOX-READ time, before the reviewing officer has decided anything, so there is no
		-- officer decision for a real signature to cover yet. The officer's real crypto arrives
		-- later, at completeSignature, as a SEPARATE OfficerSignature row over this SAME Digest —
		-- never as a mutation of this row (AdminSigning is InsertOnly check on update, delete
		-- (false)). The placeholder therefore stands in for "not yet signed", not for
		-- "signed by something unverifiable". When the user holds no active key the row also binds
		-- SignerKey = '0'.repeat(66); SignerKeyValid is a stub (see above), so that placeholder key
		-- is not load-bearing either. This entry exists because an allowlist that silently omits a
		-- producer of a security-relevant flag is worse than no allowlist.
		--
		-- 49-02 (D-02/D-03): curve-branched. `new.SignerKey` may be a P-256 Authority-app device
		-- key (D-01) or a secp256k1 key (every pre-49-02 producer) -- resolve the curve from the
		-- signer's PERSISTED UserKey.Type, defaulting to secp256k1 ('M') when the key is not
		-- registered in UserKey. The 'M' default is load-bearing, not arbitrary: SignerKeyValid
		-- above is a documented D-13 stub precisely because some device/test signer keys are
		-- never inserted into UserKey, and those rows must keep verifying exactly as they did
		-- before this plan -- defaulting to 'P' here would fail closed on every one of them.
		constraint SignatureValid check (
			context.IsPlaceholderSignature = true
				or (
					coalesce((select K.Type from UserKey K where K.PubKey = new.SignerKey), 'M') = 'P'
					and SignatureValidP256(new.Digest, new.Signature, new.SignerKey)
				)
				or (
					coalesce((select K.Type from UserKey K where K.PubKey = new.SignerKey), 'M') <> 'P'
					and SignatureValid(new.Digest, new.Signature, new.SignerKey)
				)
		)
	)
		with context ( now datetime, IsSignerKeyValid boolean, IsPlaceholderSignature boolean );

	index AdminSigningDigest on AdminSigning (Digest);

	-- Officer''s signature on the signing session
	table OfficerSignature (
		SigningNonce text,
		UserId text,	-- Particular Officer
		SignerKey text,	-- User's particular signing key
		Signature text,	-- User's signature of the digest
		primary key (SigningNonce, UserId),
		constraint InsertOnly check on update, delete (false),
		-- 999.1 D-13: Key/Officer validity stay stubs — same deferral rationale as
		-- AdminSigning.SignerKeyValid (tracked, not closed this plan).
		constraint SignerKeyValid check (context.IsSignerKeyValid = true),
		constraint OfficerValid check (context.IsOfficerValid = true),
		-- 999.1 R-02: verifies the officer's signature against the referenced AdminSigning session's
		-- own Digest (the officer counter-signs the session digest, not a private per-officer digest).
		-- IsPlaceholderSignature: the same narrow DEBT-11 carve-out as AdminSigning.SignatureValid,
		-- propagated through the shared SigningEngine.sign() seam.
		--
		-- 49-02 (D-02/D-03): same curve-branch discriminant and 'M' default as
		-- AdminSigning.SignatureValid above (see its comment for the full rationale) -- the
		-- referenced-session digest subquery is kept IDENTICAL in both curve branches.
		constraint SignatureValid check (
			context.IsPlaceholderSignature = true
				or (
					coalesce((select K.Type from UserKey K where K.PubKey = new.SignerKey), 'M') = 'P'
					and SignatureValidP256(
						(select Digest from AdminSigning where Nonce = new.SigningNonce),
						new.Signature,
						new.SignerKey
					)
				)
				or (
					coalesce((select K.Type from UserKey K where K.PubKey = new.SignerKey), 'M') <> 'P'
					and SignatureValid(
						(select Digest from AdminSigning where Nonce = new.SigningNonce),
						new.Signature,
						new.SignerKey
					)
				)
		)
	)
		with context ( now datetime, IsSignerKeyValid boolean, IsOfficerValid boolean, IsPlaceholderSignature boolean );

	-- The final Admin signature output - only exists if required threshold of signatures are met - exists to avoid long validation
	table AdminSignature (
		SigningNonce text primary key,
		constraint InsertOnly check on update, delete (false),
		-- 999.1 R-06: gates on the REAL `signatureCount >= threshold` boolean the producer computes in TS
		-- (signing-engine.ts SigningEngine.sign()) and binds here — no longer a hardcoded literal.
		-- AdminSignature has no Digest/Signature/SignerKey columns (verified live: only a SigningNonce
		-- PK), so there is nothing on the row itself for SignatureValid() to re-verify — the threshold
		-- boolean IS the real value being gated.
		constraint SignatureValid check (context.IsSignatureValid = true)
	)
		with context ( IsSignatureValid boolean );

	table ProposedNetwork (
		Name text,
		Revision integer not null, -- monotonic discriminator allowing many proposed revisions per Name (Phase 12.3-02)
		ImageRef text null, -- json object { url?: string, cid?: string }
		Relays text, -- json array of strings - TODO: constraint
		TimestampAuthorities text, -- json array of { url: string } - TODO: constraint
		NumberRequiredTSAs integer default 0,
		ElectionType text, -- references ElectionType(Code)
		primary key (Name, Revision),
		-- TODO: constraint ImageRefValid check (ImageRef is a valid image reference JSON)
		-- TODO: constraint RelaysValid check (Relays is a valid array of strings)
		-- TODO: constraint TimestampAuthoritiesValid check (TimestampAuthorities is a valid array of { url: string })
		constraint NumberRequiredTSAsValid check (NumberRequiredTSAs >= 0 and typeof(new.NumberRequiredTSAs) = 'integer'),
		constraint ElectionTypeValid check (ElectionType in (select Code from ElectionType)),
		constraint UserValid check (context.IsUserValid = true),
		-- constraint TasksHandled	check (
		-- 	-- There must be an AdminSigning for rn whose digest matches this ProposedNetwork,
		-- 	-- and either the signing is fully completed (AdminSignature exists), or
		-- 	-- tasks exist for all other rn-scoped officers of the primary authority
		-- 	exists (
		-- 		select 1 from AdminSigning A
		-- 			join Network N on N.Name = coalesce(new.Name, old.Name) and N.PrimaryAuthorityId = A.AuthorityId
		-- 			where A.Scope = 'rn'
		-- 				and A.Digest = Digest(
		-- 					context.Tid,
		-- 					coalesce(new.Name, old.Name),
		-- 					coalesce(new.ImageRef, old.ImageRef),
		-- 					coalesce(new.Relays, old.Relays),
		-- 					coalesce(new.TimestampAuthorities, old.TimestampAuthorities),
		-- 					coalesce(new.NumberRequiredTSAs, old.NumberRequiredTSAs),
		-- 					coalesce(new.ElectionType, old.ElectionType)
		-- 				)
		-- 			and (
		-- 				exists (select 1 from AdminSignature ASig where ASig.SigningNonce = A.Nonce)
		-- 				or not exists (
		-- 					-- find any rn-scoped officer in this admin epoch (excluding instigator)
		-- 					-- who does NOT have a corresponding open task + NetworkSignatureTaskExtension
		-- 					select 1 from Officer O
		-- 						where O.AuthorityId = A.AuthorityId
		-- 							and O.AdminEffectiveAt = A.AdminEffectiveAt
		-- 							and exists (select 1 from json_each(O.Scopes) where value = 'rn')
		-- 							and O.UserId != A.UserId
		-- 							and not exists (
		-- 								select 1 from Task T
		-- 									join NetworkSignatureTaskExtension NX on NX.TaskId = T.Id
		-- 									where T.UserId = O.UserId
		-- 										and T.Type = 'signature'
		-- 										and T.SignatureType = 'network'
		-- 										and T.IsCompleted = false
		-- 										and T.SigningNonce = A.Nonce
		-- 										and NX.NetworkName = coalesce(new.Name, old.Name)
		-- 							)
		-- 				)
		-- 			)
		-- 	)
		-- )
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsUserValid boolean );

	-- Append-only withdrawal marker for a proposed network revision (SURF-04, D-09).
	-- Keyed on (Name, Revision) so a withdrawn revision drops off the proposed list via a
	-- NOT EXISTS read filter, WITHOUT mutating or deleting the ProposedNetwork row.
	-- Justification: append-only audit consistency + no proposal-history loss — NOT because
	-- ProposedNetwork forbids delete (it does not: ProposedNetwork has no CantDelete/InsertOnly;
	-- CantDelete lives only on Network/Officer/ProposedOfficer(User)/Authority). Non-signing
	-- this phase (D-09/D-05): the context envelope carries only Tid + now, no signature/user CHECK.
	table RevisionCancellation (
		Name text,
		Revision integer not null,
		CancelledAt datetime,
		primary key (Name, Revision),
		constraint ProposalExists check on insert (
			exists (select 1 from ProposedNetwork P where P.Name = new.Name and P.Revision = new.Revision)
		),
		constraint InsertOnly check on update, delete (false)
	)
		with context ( Tid int, now datetime );

	table ProposedAuthority (
		Id text primary key,
		Name text,
		DomainName text null,
		ImageRef text null, -- json object { url?: string, cid?: string }
		constraint AuthorityExists check on insert, update (exists (select 1 from Authority A where A.Id = new.Id)),
		constraint UserValid check (context.IsUserValid = true),
		-- constraint TasksHandled	check (
		-- 	-- if more signatures are required
		-- 	-- exists (

		-- 	-- )
		-- 	-- if a signature is present, no hanging tasks should be left
		-- 	not exists (
		-- 		select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
		-- 			join AdminSignature ASig on ASig.SigningNonce = A.Nonce
		-- 				where T.Id = new.TaskId and T.IsCompleted = false
		-- 	)
		-- )
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsUserValid boolean );

	table ProposedAdmin (
		AuthorityId text,
		EffectiveAt datetime,
		ThresholdPolicies text default '[]', -- json array of { policy: string (Scope), threshold: integer }
		primary key (AuthorityId, EffectiveAt),
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint EffectiveAtValid check on insert, update (EffectiveAt is not null),
		--constraint ThresholdPoliciesValid check (...), -- TODO: constraint
		constraint UserValid check (context.IsUserValid = true)
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsUserValid boolean );

	table ProposedOfficer (
		AuthorityId text,
		AdminEffectiveAt datetime,
		ProposedName text,
		Title text,
		Scopes text default '[]', -- json array of strings
		primary key (AuthorityId, AdminEffectiveAt, ProposedName),
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint AdminValid check (exists (select 1 from ProposedAdmin A where A.AuthorityId = new.AuthorityId and A.EffectiveAt = new.AdminEffectiveAt)),
		constraint CantDelete check on delete (false),
		constraint ScopesValid check (not exists (select 1 from json_each(Scopes) where value not in (select Code from Scope))),
		constraint UserValid check (context.IsUserValid = true)
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsUserValid boolean );

	-- Possibly remove, since users must be associated with a keyholer or officer
	-- Extension of ProposedOfficer to associate a specific UserId and include the user''s signature
	table ProposedOfficerUser (
		AuthorityId text,
		AdminEffectiveAt datetime,
		ProposedName text,
		UserId text,
		UserKey text,
		UserSignature text,
		primary key (AuthorityId, AdminEffectiveAt, ProposedName),
		constraint ProposedOfficerValid check (exists (select 1 from ProposedOfficer PA where PA.AuthorityId = new.AuthorityId and PA.AdminEffectiveAt = new.AdminEffectiveAt and PA.ProposedName = new.ProposedName)),
		constraint UserIdValid check (exists (select 1 from User U where U.Id = new.UserId)),
		constraint UserKeyValid check (exists (select 1 from UserKey K where K.UserId = new.UserId and K.PubKey = new.UserKey and K.Expiration > context.now)),
		constraint CantDelete check on delete (false),
		-- TODO: re-enable when ProposedOfficerUser's role is decided (currently "possibly remove" per the table comment).
		-- Original (broken) body referenced PA.AdminRevision / PA.UserId / PA.SignerKey / PA.Signature which do not exist on ProposedOfficer.
		constraint SignatureValid check (true)
	)
		with context ( now datetime );

	view InviteType as
		select 'au' as Code, 'Authority' as Name
		union all select 'of' as Code, 'Officer' as Name
		union all select 'k' as Code, 'Keyholder' as Name
		union all select 'r' as Code, 'Registrant' as Name;

	table InviteSlot (
		Cid text primary key,
		Type text, -- references InviteType(Code) — must match TS union InviteType in packages/vote-core/src/invite/models.ts:68 ('au'|'of'|'k'|'r')
		Name text, -- Name of invited person or authority for informational purpose and/or manually catch abuse
		Expiration datetime,
		InviteKey text, -- public key of temporary Invite key pair
		InviteSignature text,
		SigningNonce text, -- AdminSigning.Nonce, shows admin approval including scope (implies the type of invite, e.g. authority, officer, keyholder, registrant)
		ResendSalt text null, -- D-03 Option B (Phase 36): resendInvite's salt (resend|tid|now), persisted so the resend row's Cid is fully re-derivable; null for normal (au/of) invites
		-- second-keyholder-invite-unique fix (2026-07-30): the election a Type='k'
		-- (keyholder) invite is FOR. null for au/of/r invites. Required so that
		-- InvitationEngine.respondToInvite can resolve which Election/ElectionRevision
		-- to bind the accept-time Keyholder row to, given only the InviteSlot Cid — the
		-- ElectionRevision (a mutable, monotonically-increasing column, not a separate
		-- row per revision) is deliberately NOT persisted here and is instead resolved
		-- FRESH from ElectionRevision at accept-time, so an invite always binds to the
		-- CURRENT revision rather than a possibly-stale one captured at send-time.
		ElectionId text null,
		-- D-02/D-03 (Phase 36): Cid is minted as an IPLD CIDv1 via cid(Digest(...)) at all
		-- 3 authority-engine.ts producer sites (au/of/resend), PLUS the keyholder (k)
		-- producer site (ElectionEngine.inviteKeyholder). TOTAL content re-derivation —
		-- no structural-only acceptance branch on InviteSlot: every row's Cid must equal
		-- cid(Digest(...)) recomputed from that row's OWN persisted columns. Branches are
		-- keyed on ResendSalt null/not-null, and (mutually exclusive with ResendSalt —
		-- resendInvite never handles Type='k') ElectionId null/not-null:
		--   au/of (6-field):        Cid = cid(Digest(Expiration, InviteKey, InviteSignature, Name, SigningNonce, Type))
		--   resend (7-field):       Cid = cid(Digest(Expiration, InviteKey, InviteSignature, Name, SigningNonce, Type, ResendSalt))
		--   keyholder (7-field):    Cid = cid(Digest(ElectionId, Expiration, InviteKey, InviteSignature, Name, SigningNonce, Type))
		constraint CidValid check (
			(ResendSalt is null and ElectionId is null
				and Cid = cid(Digest(Expiration, InviteKey, InviteSignature, Name, SigningNonce, Type)))
			or (ResendSalt is not null
				and Cid = cid(Digest(Expiration, InviteKey, InviteSignature, Name, SigningNonce, Type, ResendSalt)))
			or (ElectionId is not null
				and Cid = cid(Digest(ElectionId, Expiration, InviteKey, InviteSignature, Name, SigningNonce, Type)))
		),
		constraint TypeValid check (Type in (select Code from InviteType)),
		constraint ExpirationValid check (Expiration > context.now),
		constraint InviteSignatureValid check (context.IsSignatureValid = true),
		constraint InsertOnly check on update, delete (false),
		-- D-13 (999.1-09, explicit deferral — evaluated, not silently left):
		-- CidValid already re-derives EVERY persisted column from the row's own
		-- content (total re-derivation, no structural-only branch — see the
		-- comment above), TypeValid/ExpirationValid/InviteSignatureValid cover
		-- the remaining columns, and the PK (Cid) makes duplicate rows
		-- impossible. The one candidate structural fold considered — "the
		-- row's SigningNonce refers to an EXISTING AdminSigning" (mirroring
		-- Authority.InsertValid's/User.InsertValid's EXISTS-boolean idiom) —
		-- is NOT foldable: authority-engine.ts's saveInviteWithSigning
		-- comment documents the mandatory insert order "nonce first,
		-- InviteSlots second, AdminSigning (startSigningSession) third", so
		-- AdminSigning legitimately does NOT exist yet at InviteSlot
		-- insert-time on the normal path (InviteSlotSigningValid's own D-03
		-- comment confirms this ordering is allowed). Requiring it here would
		-- break every legitimate invite. No other cheap real condition was
		-- found within this plan's budget, so this stays a context passthrough
		-- (the producer side already validates via CidValid's re-derivation).
		constraint InsertValid check on insert (context.IsInsertValid = true)
	)
		with context ( Tid int, now datetime, IsSignatureValid boolean, IsInsertValid boolean );

	index InviteSlotSigningNonce on InviteSlot (SigningNonce, Cid);

	-- A single signing can encompass a batch of Invite slots, so validate the whole batch at once.
	-- D-03 (Phase 33): rewritten to inner-join form that fires only when AdminSigning IS present but
	-- no InviteSlot in the batch matches the Digest. This allows:
	--   (a) InviteSlot INSERT before AdminSigning — inner join finds no AdminSigning → no violation.
	--   (b) resendInvite — fresh slot reuses the original SigningNonce; AdminSigning.Digest = Digest(orig.Cid)
	--       matches the original slot in the batch → no violation (whole batch is covered).
	--   (c) mismatched AdminSigning Digest — no InviteSlot in the batch matches → violation.
	-- Eliminates the SND derived alias that quereus 4.x per-tuple residual resolveAttribute
	-- cannot carry into run context (same Digest(I.Cid) UDF call, same Cid argument, D-03).
	assertion InviteSlotSigningValid check (not exists (
		select 1 from InviteSlot I
			inner join AdminSigning SIG on SIG.Nonce = I.SigningNonce
				where not exists (
					select 1 from InviteSlot I2
						where I2.SigningNonce = I.SigningNonce and SIG.Digest = Digest(I2.Cid)
				)
	));

	-- Acceptance or rejection of Invite, created before resulting object
	table InviteResult (
		SlotCid text primary key,
		IsAccepted boolean,	-- If Not accepted, Digest must be null
		Digest text null,	-- On whatever the invited party is intending to create - not validated here besides not null if IsAccepted
		InviteSignature text,	-- Signs H(SlotCid, Digest, IsAccepted)
		InvokedId text null,	-- ID of the object that will be invoked by the invitation - not validated here, this id is reserved for when the authority/user/ is created
		constraint InsertOnly check on update, delete (false),
		constraint SigningValid check (context.IsSigningValid = true),
		constraint SignatureValid check (context.IsSignatureValid = true),
		constraint DigestValid check (
			(not IsAccepted and new.Digest is null)
				or (IsAccepted and new.Digest is not null)
		),
		-- D-03 structural fallback (Phase 36): SlotCid is a reference to InviteSlot.Cid,
		-- not schema-reconstructable here — enforce structural CIDv1 raw-codec shape only.
		-- cast(...as text) required: json_extract's JSON-typed return is not directly
		-- =-comparable to a bare TEXT literal (36-01 Probe 3b finding).
		constraint SlotCidValid check ( cast(json_extract(cid_decode(SlotCid), '$.codec') as text) = 'raw' )
	)
		with context ( IsSigningValid boolean, IsSignatureValid boolean );

	-- Append-only withdrawal marker for a pending InviteSlot (SURF-03, D-06).
	-- A slot with a matching row drops off the pending list via a NOT EXISTS read filter;
	-- the InviteSlot itself is never mutated (InviteSlot is InsertOnly, so cancel cannot
	-- update/delete it). Audit trail persists. Non-signing this phase (D-06/D-05): the
	-- context envelope carries only Tid + now, no signature/user CHECK.
	table InviteCancellation (
		SlotCid text primary key, -- references InviteSlot(Cid)
		CancelledAt datetime,
		constraint SlotExists check on insert (exists (select 1 from InviteSlot S where S.Cid = new.SlotCid)),
		-- D-03 structural fallback (Phase 36): see InviteResult.SlotCidValid comment.
		constraint SlotCidValid check ( cast(json_extract(cid_decode(SlotCid), '$.codec') as text) = 'raw' ),
		constraint InsertOnly check on update, delete (false)
	)
		with context ( Tid int, now datetime );

	view AcceptedInvite as
		select IR.SlotCid, IR.IsAccepted, IR.Digest, IR.InviteSignature, SIG.Scope
			from InviteResult IR
			join InviteSlot S on S.Cid = IR.SlotCid
			join AdminSigning SIG on SIG.Nonce = S.SigningNonce
			where IR.IsAccepted;

	view UserKeyType as
		select 'M' as Code, 'Mobile' as Name
		union all select 'Y' as Code, 'Yubico' as Name;

	table User (
		Id text primary key, -- Random ID
		Name text,
		ImageRef text null, -- json object { url?: string, cid?: string }
		constraint UserValid check on update (
			-- Must be associated with a keyholder
			exists (select 1 from Keyholder K where K.UserId = new.Id)
				-- or must be associated with an officer
				or exists (select 1 from Officer O where O.UserId = new.Id)
		),
		constraint UserKeyValid check on update (
			-- Must be a non-expired key for the user
			exists (select 1 from UserKey K where K.UserId = new.Id)
		),
		constraint CantDelete check on delete (false),
		constraint ValidModification check (new.Id = old.Id),
		-- TODO add check for valid update
		constraint InsertValid check on insert (
			-- First user in the network - no invite, no signing
			(context.SigningNonce is null and context.InviteSlotCid is null and context.InviteSignature is null and (select count(*) from User) = 1)
				-- or Valid Invite for this user
				or (context.SigningNonce is null and context.InviteSlotCid is not null and context.InviteSignature is not null
					and exists (
						select 1 from InviteSlot I where I.Cid = context.InviteSlotCid and I.InviteSignature = context.InviteSignature
					)
				)
		)
	)
		with context (SigningNonce text null, InviteSlotCid text null, InviteSignature text null, Tid int);

	table UserKey (
		UserId text, -- references future User.Id
		Type text, -- references UserKeyType(Code)
		PubKey text, -- paired private key is stored on the user''s device
		Expiration datetime,
		primary key (UserId, PubKey),
		constraint UserIdValid check (
			exists (select 1 from User U where U.Id = new.UserId)
		),
		constraint InsertValid check on insert (
			(
				(select count(*) from UserKey K where K.UserId = new.UserId) = 1
				and context.UserKey is null
			)
			or exists (
				select 1
				from UserKey K
				where K.UserId = new.UserId
					and K.PubKey = context.UserKey
					and K.Expiration > context.now
					and K.PubKey <> new.PubKey
			)
	),
		-- 49-05 (D-20): extends the pre-existing two-clause DeleteValid (signer non-expired;
		-- not the last key) with a third AND'd clause verifying a REAL signature over the
		-- canonical revoke pre-image Digest(old.UserId, old.PubKey) -- the single formula also
		-- defined TS-side by UserEngine.getRevokeKeyDigest, so the engine and the schema can
		-- never drift. Shape selected by 49-03's empirical probe
		-- (quereus-delete-check-semantics.spec.ts VERDICT: extend-DeleteValid) -- installed
		-- Quereus 4.11.0 proved `check on delete` fires ONLY on DELETE (never INSERT/UPDATE --
		-- quereus#23 stays fixed) and can safely call `SignatureValid(Digest(old...), ...)`.
		-- Curve-branched per 49-02 (D-02/D-03), mirroring SignatureValid's own discriminant
		-- above: resolves the verifying curve from the EXISTING signer's persisted
		-- UserKey.Type (context.UserKey), defaulting to 'M' (secp256k1) when unregistered --
		-- the same default AdminSigning/OfficerSignature use, and immaterial here in practice
		-- because the FIRST clause already requires context.UserKey to be a registered,
		-- non-expired UserKey row for this user. Digest(old.UserId, old.PubKey) is TEXT-only
		-- (no datetime column), so this is NOT the Registrant/Association deferred-CHECK
		-- Expiration-coercion trap (49-02 Deviation 2) -- and DeleteValid already carries two
		-- pre-existing EXISTS subqueries, so this adds no NEW deferred-promotion risk either.
		constraint DeleteValid check on delete (
				-- must be a non-expired key for the user
				exists (select 1 from UserKey K where K.UserId = old.UserId and K.PubKey = context.UserKey and K.Expiration > context.now)
					-- and not the last key for the user
					and exists (select 1 from UserKey K where K.UserId = old.UserId and K.PubKey <> old.PubKey)
					-- and a real signature over the canonical revoke pre-image
					and (
						(
							coalesce((select K.Type from UserKey K where K.PubKey = context.UserKey), 'M') = 'P'
							and SignatureValidP256(
								Digest(old.UserId, old.PubKey),
								context.Signature,
								context.UserKey
							)
						)
						or (
							coalesce((select K.Type from UserKey K where K.PubKey = context.UserKey), 'M') <> 'P'
							and SignatureValid(
								Digest(old.UserId, old.PubKey),
								context.Signature,
								context.UserKey
							)
						)
					)
		),
		-- 999.1 R-02/D-11/Pitfall 3: real in-schema verification via the shared SignatureValid UDF,
		-- gated by a bootstrap discriminant that MIRRORS InsertValid's own first branch exactly
		-- (first key for this user AND no existing signer bound in context). The bootstrap branch
		-- intentionally does NOT call SignatureValid against a null signature -- it stays a plain
		-- boolean short-circuit so the most-tested first-key path never depends on crypto. Every
		-- subsequent-key insert must carry a real signature from the EXISTING active signer
		-- (context.UserKey) over Digest(UserId, PubKey, Type, Expiration) -- the exact formula
		-- UserEngine.addKey's sign-callback path computes (see user-engine.ts addKey doc comment).
		-- IsSignatureValid stays declared (unused by this CHECK) for backward-compatible binding
		-- from other raw-SQL seeders across the suite; producers accepting a real signature no
		-- longer assert it hardcoded true (R-04) -- see UserEngine.addKey.
		--
		-- 49-02 (D-02/D-03): curve-branched. `new.Type` describes the curve of the KEY BEING
		-- INSERTED, but the curve that must actually verify the signature bytes is the EXISTING
		-- signer's own curve (`context.UserKey`), which may differ in this permanently
		-- mixed-curve system (D-03) -- a P-256 Authority officer key can countersign a new
		-- secp256k1 key and vice versa. The discriminant therefore resolves from the PERSISTED
		-- `UserKey.Type` of the verifying key, not from `new.Type`: `coalesce((select K.Type
		-- from UserKey K where K.PubKey = context.UserKey), new.Type)` -- a registered signer
		-- uses its own recorded curve, and an unregistered/legacy signer falls back to the new
		-- row's own type, which preserves every existing (pre-49-02) test path exactly. Do not
		-- "simplify" this back to `new.Type` -- that would verify a P-256 signer's countersignature
		-- of a new secp256k1 key against the WRONG curve and fail closed and silently.
		constraint SignatureValid check (
			(
				(select count(*) from UserKey K where K.UserId = new.UserId) = 1
				and context.UserKey is null
			)
			or (
				coalesce((select K.Type from UserKey K where K.PubKey = context.UserKey), new.Type) = 'P'
				and SignatureValidP256(
					Digest(new.UserId, new.PubKey, new.Type, new.Expiration),
					context.Signature,
					context.UserKey
				)
			)
			or (
				coalesce((select K.Type from UserKey K where K.PubKey = context.UserKey), new.Type) <> 'P'
				and SignatureValid(
					Digest(new.UserId, new.PubKey, new.Type, new.Expiration),
					context.Signature,
					context.UserKey
				)
			)
		),
		constraint NoUpdate check on update (false),
		constraint ExpirationFuture check (Expiration > context.now)
	)
		with context ( UserKey text null, Signature text null, Tid int, now datetime, IsSignatureValid boolean );

	-- Append-only user-event log (ENG-02, D-13..D-18). One row per user mutation
	-- (create/revise/addKey/revokeKey), written in the same db.exec batch as the mutation.
	-- Sequence is the per-user monotonic ordering key (NOT a reuse of Tid, which resets per
	-- process). Signature is written null this phase (D-15, signature-honest schema; Phase 21
	-- fills content). A single JSON Payload column round-trips all four UserHistory subtypes
	-- (D-16). Non-signing this phase: no IsSignatureValid/IsUserValid context CHECK.
	table UserEvent (
		UserId text,
		Tid integer null, -- 999.1 D-06/D-08/R-05: queryable Tid backstop; back-derives coalesce(max(Tid),-1)+1
		Sequence integer not null, -- per-user monotonic ordering key (coalesce(max(Sequence),-1)+1)
		Event text, -- 'C' | 'R' | 'AK' | 'RK' (UserHistoryEvent)
		Timestamp datetime, -- nowCanonicalDatetime()
		Signature text null, -- D-15: written null now, real signature content arrives in Phase 21
		Payload text, -- JSON; subtype-specific shape (D-16)
		primary key (UserId, Sequence),
		constraint UserIdValid check (exists (select 1 from User U where U.Id = new.UserId)),
		constraint EventValid check (Event in ('C','R','AK','RK')),
		constraint InsertOnly check on update, delete (false)
	)
		-- 999.1: context param renamed Tid -> CtxTid to avoid a Quereus
		-- RegisteredScope symbol collision with the new persisted `Tid` column above (both a
		-- bare column and a bare context param named `Tid` in the same table register into the
		-- same INSERT compile scope -> "Symbol 'tid' already exists in the same scope"). No CHECK
		-- constraint references context.Tid yet (Phase 21 signature-CHECK addition should use
		-- context.CtxTid on this table specifically).
		with context ( CtxTid int, now datetime );

	table Election (
		Id text primary key, -- 32 byte random id
		AuthorityId text, -- authority that created the election
		Title text, -- title of the election
		Date datetime, -- date of the election
		RevisionDeadline datetime, -- deadline for making revisions to the election, cannot be revised itself
		BallotDeadline datetime, -- deadline for adding or revising ballots to the election
		Type text, -- references ElectionType(Code)
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint DateValid check (Date >= context.now),
		constraint RevisionDeadlineValid check (RevisionDeadline <= Date),
		constraint BallotDeadlineValid check (BallotDeadline <= Date),
		constraint TypeValid check (Type in (select Code from ElectionType)),
		-- TODO: constrain Timeline
		constraint InsertOnly check on update, delete (false),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = new.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(
							context.Tid, new.Id, new.AuthorityId, new.Title, new.Date, new.RevisionDeadline, new.BallotDeadline, new.Type
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now text );

	table ProposedElection (
		Id text primary key, -- 32 byte random id
		AuthorityId text, -- authority that created the election
		Title text, -- title of the election
		Date datetime, -- date of the election
		RevisionDeadline datetime, -- deadline for making revisions to the election, cannot be revised itself
		BallotDeadline datetime, -- deadline for adding or revising ballots to the election
		Type text, -- references ElectionType(Code)
		constraint UserValid check (context.IsUserValid = true)
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsUserValid boolean );

	table ElectionRevision (
		ElectionId text primary key, -- references Election.Id
		Revision integer, -- references Election.Revision
		RevisionTimestamp datetime, -- timestamp of the revision
		Tags text, -- json array of strings
		Instructions text, -- markdown instructions for the election
		Timeline text, -- json object { [ElectionEvent]: datetime }
		KeyholderThreshold integer, -- number of keyholders required to sign the election
		-- 39-02 D-04 Gap 1/2: create-time keyholder invitees, persisted name-only
		-- (a JSON array of SentKeyholderInvite-shaped { name } objects, or the
		-- caller's full KeyholderInvite[] payload verbatim). UNSIGNED and
		-- deliberately excluded from the MutationValid Digest tuple below (A1) —
		-- these are pending invitees, not yet-signed keyholder commitments. The
		-- signed binding is the separate inviteKeyholder -> Keyholder flow.
		Keyholders text null,
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint ElectionIdImmutable check on update (new.ElectionId = old.ElectionId),
		constraint BeforeRevisionDeadline check (exists (select 1 from Election E where E.Id = new.ElectionId and E.RevisionDeadline > context.now)),
		constraint RevisionStart check on insert (Revision = 0),
		constraint RevisionMonotonic check on update (new.Revision = old.Revision + 1),
		constraint RevisionTimestampValid check (RevisionTimestamp < context.now
			and RevisionTimestamp < (select RevisionDeadline from Election E where E.Id = new.ElectionId)),
		constraint RevisionTimestampValidUpdate check on update (new.RevisionTimestamp > old.RevisionTimestamp),
		--TODO constrain Timeline
		constraint KeyholderThresholdValid check (KeyholderThreshold >= 0 and typeof(new.KeyholderThreshold) = 'integer'),
		constraint NoDelete check on delete (false),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce join Election E on E.Id = new.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(
							context.Tid, new.ElectionId, new.Revision, new.RevisionTimestamp, new.Tags, new.Instructions, new.Timeline, new.KeyholderThreshold
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now text );

	table ProposedElectionRevision (
		ElectionId text primary key, -- references Election.Id
		Revision integer, -- references Election.Revision
		RevisionTimestamp datetime, -- timestamp of the revision
		Tags text, -- json array of strings
		Instructions text, -- markdown instructions for the election
		Timeline text, -- json object { [ElectionEvent]: datetime }
		KeyholderThreshold integer, -- number of keyholders required to sign the election
		-- 39-02 D-04: sibling column to ElectionRevision.Keyholders (see there).
		-- proposeRevision does not currently write this column (out of this
		-- plan's Gap 1 scope, which targets createElection only) -- reads
		-- correctly fall back to an empty set via the shared parse helper.
		Keyholders text null,
		constraint ElectionIdValid check (
			exists (select 1 from Election E where E.Id = new.ElectionId)
				or -- the election is still being proposed
					exists (select 1 from ProposedElection PE where PE.Id = new.ElectionId)
		),
		constraint UserValid check (context.IsUserValid = true)
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsUserValid boolean );

	table Ballot (
		Id text primary key, -- 32 byte random id
		ElectionId text, -- references Election.Id
		AuthorityId text, -- authority that created the ballot
		Description text, -- description of the ballot
		Districts text, -- json array of strings
		constraint ElectionIdValid check on insert, update (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint ElectionIdImmutable check on update (new.ElectionId = old.ElectionId),
		constraint AuthorityIdValid check on insert, update (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint AuthorityIdImmutable check on update (new.AuthorityId = old.AuthorityId),
		constraint IdImmutable check on update (new.Id = old.Id),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce join Election E on E.Id = new.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = new.AuthorityId
						and E.BallotDeadline > context.now
						and A.Scope = 'ceb'
						and A.Digest = Digest(
							context.Tid, new.Id, new.ElectionId, new.AuthorityId, new.Description, new.Districts
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig
					join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = old.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = old.AuthorityId
						and E.BallotDeadline > context.now
						and A.Scope = 'ceb'
						and A.Digest = Digest(
							context.Tid, old.Id, 'delete'
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	table ProposedBallot (
		Id text primary key, -- 32 byte random id or references Ballot.Id
		ElectionId text, -- references Election.Id
		AuthorityId text, -- authority that created the ballot
		Description text, -- description of the ballot
		Districts text, -- json array of strings
		Questions text null, -- json array of Question objects (persisted alongside the ballot header so questions survive the proposed phase)
		constraint ElectionIdValid check on insert, update (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint AuthorityIdValid check on insert, update (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint UserValid check (context.IsUserValid = true)
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsUserValid boolean );

	table Question (
		BallotId text, -- references Ballot.Id
		Code text, -- code of the question
		Title text, -- title of the question
		Instructions text, -- markdown instructions for the question
		DependsOn text null, -- json object { code: string, valuesExpression: string }
		Type text, -- references QuestionType(Code)
		OptionRange text default '{1, 1}', -- json object { min: number, max: number }
		ScoreRange text null, -- json object { min: number, max: number, step: number }
		Grouping text null, -- grouping (hierarchy) of the question (group is a reserved word)
		Sequence integer null, -- sequence of the question within the group
		Required integer default 1, -- whether the question is required
		primary key (BallotId, Code),
		constraint BallotIdValid check on insert, update (exists (select 1 from Ballot B where B.Id = new.BallotId)),
		constraint BallotIdImmutable check on update (new.BallotId = old.BallotId),
		constraint CodeImmutable check on update (new.Code = old.Code),
		constraint TypeValid check on insert, update (Type in (select Code from QuestionType)),
		constraint SequenceValid check on insert, update (Sequence is null or (typeof(Sequence) = 'integer' and Sequence >= 0)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce join Ballot B on B.Id = new.BallotId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = B.AuthorityId
						and A.Scope = 'ceb'
						and A.Digest = Digest(
							context.Tid, new.BallotId, new.Code, new.Title, new.Instructions, new.DependsOn, new.Type, new.OptionRange, new.ScoreRange, new.Grouping, new.Sequence, new.Required
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Ballot B on B.Id = old.BallotId
					join Election E on E.Id = B.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = B.AuthorityId
						and E.BallotDeadline > context.now
						and A.Scope = 'ceb'
						and A.Digest = Digest(
							context.Tid, old.BallotId, 'delete'
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	table ProposedQuestion (
		BallotId text, -- references ProposedBallot.Id
		Code text, -- code of the question
		Title text, -- title of the question
		Instructions text, -- markdown instructions for the question
		DependsOn text null, -- json object { code: string, valuesExpression: string }
		Type text, -- references QuestionType(Code)
		OptionRange text default '{1, 1}', -- json object { min: number, max: number }
		ScoreRange text null, -- json object { min: number, max: number, step: number }
		Grouping text null, -- grouping (hierarchy) of the question (group is a reserved word)
		Sequence integer null, -- sequence of the question within the group
		Required integer default 1, -- whether the question is required
		constraint BallotIdValid check (exists (select 1 from Ballot B where B.Id = new.BallotId)),
		constraint TypeValid check (Type in (select Code from QuestionType)),
		constraint MutationValid check on insert, update (context.IsMutationValid = true)
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsMutationValid boolean );

	table Option (
		BallotId text, -- references Ballot.Id
		QuestionCode text, -- references Question.Code
		Code text, -- code of the option
		Sequence integer null, -- how to order the options within the question, lower numbers are shown first, equal numbers are randomized within the grouping
		Title text, -- title of the option
		Details text null, -- details of the option
		InfoURL text null, -- info URL of the option
		Image text null, -- json object { url?: string, cid?: string }
		Video text null, -- json object { url?: string, cid?: string }
		primary key (BallotId, QuestionCode, Code),
		constraint BallotIdValid check on insert, update (exists (select 1 from Ballot B where B.Id = new.BallotId)),
		constraint QuestionCodeValid check on insert, update (exists (select 1 from Question Q where Q.BallotId = new.BallotId and Q.Code = new.QuestionCode)),
		constraint BallotIdImmutable check on update (new.BallotId = old.BallotId),
		constraint QuestionCodeImmutable check on update (new.QuestionCode = old.QuestionCode),
		constraint CodeImmutable check on update (new.Code = old.Code),
		constraint SequenceValid check on insert, update (Sequence is null or (typeof(Sequence) = 'integer' and Sequence >= 0)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce join Ballot B on B.Id = new.BallotId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = B.AuthorityId
						and A.Scope = 'ceb'
						and A.Digest = Digest(
							context.Tid, new.BallotId, new.QuestionCode, new.Code, new.Sequence, new.Title, new.Details, new.InfoURL, new.Image, new.Video
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Ballot B on B.Id = old.BallotId
					join Election E on E.Id = B.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = B.AuthorityId
						and E.BallotDeadline > context.now
						and A.Scope = 'ceb'
						and A.Digest = Digest(
							context.Tid, old.BallotId, 'delete'
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	view QuestionType as
		select 'select' as Code, 'Select' as Name
		union all select 'rank' as Code, 'Rank' as Name
		union all select 'score' as Code, 'Score' as Name
		union all select 'text' as Code, 'Text' as Name;

	table ProposedOption (
		BallotId text, -- references ProposedBallot.Id
		QuestionCode text, -- references ProposedQuestion.Code
		Code text, -- code of the option
		Sequence integer null, -- how to order the options within the question, lower numbers are shown first, equal numbers are randomized within the grouping
		Title text, -- title of the option
		Details text null, -- details of the option
		InfoURL text null, -- info URL of the option
		Image text null, -- json object { url?: string, cid?: string }
		Video text null, -- json object { url?: string, cid?: string }
		constraint BallotIdValid check (exists (select 1 from Ballot B where B.Id = new.BallotId)),
		constraint QuestionCodeValid check (exists (select 1 from Question Q where Q.BallotId = new.BallotId and Q.Code = new.QuestionCode)),
		constraint BallotIdImmutable check on update (new.BallotId = old.BallotId),
		constraint QuestionCodeImmutable check on update (new.QuestionCode = old.QuestionCode),
		constraint CodeImmutable check on update (new.Code = old.Code),
		constraint SequenceValid check (Sequence is null or (typeof(Sequence) = 'integer' and Sequence >= 0)),
		constraint MutationValid check on insert, update (context.IsMutationValid = true)
	)
		with context ( UserId text, UserKey text, Signature text, Tid int, now datetime, IsMutationValid boolean );

	table Keyholder (
		ElectionId text, -- references Election.Id
		ElectionRevision integer, -- references ElectionRevision.Revision
		UserId text, -- the user associated with this keyholder
		primary key (ElectionId, ElectionRevision, UserId),
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint UserIdValid check (exists (select 1 from User U where U.Id = new.UserId)),
		constraint ElectionRevisionValid check (exists (select 1 from ElectionRevision ER where ER.ElectionId = new.ElectionId and ER.Revision = new.ElectionRevision)),
		constraint InsertValid check on insert (
			context.SigningNonce is null and context.InviteSlotCid is null and context.InviteSignature is null
		)
	)
		with context ( SigningNonce text null, InviteSlotCid text null, InviteSignature text null, Tid int );

	table Task (
		Id text primary key, -- 32 byte random id
		UserId text, -- references User.Id
		Type text, -- references TaskType(Code)
		SignatureType text null, -- references SignatureType(Code) only used for signature tasks
		SigningNonce text null, -- references AdminSigning.Nonce only used for signature tasks
		IsCompleted integer default 0, -- whether the task has been completed
		constraint UserIdValid check (exists (select 1 from User U where U.Id = new.UserId)),
		constraint TypeValid check (Type in (select Code from TaskType)),
		constraint SignatureTypeValid check (SignatureType in (select Code from SignatureType) or SignatureType is null),
		constraint UserIdImmutable check on update (new.UserId = old.UserId),
		constraint TypeImmutable check on update (new.Type = old.Type),
		constraint SignatureTypeImmutable check on update (new.SignatureType = old.SignatureType),
		constraint ExtensionExists check (
			(Type = 'release-key' and exists (select 1 from ReleaseKeyTaskExtension R where R.TaskId = new.Id))
				or ( Type = 'onboarding' and exists (select 1 from OnboardingTaskExtension O where O.TaskId = new.Id))
					or ( Type = 'signature' and (
						( SignatureType = 'network' and exists (select 1 from NetworkSignatureTaskExtension N where N.TaskId = new.Id))
							or ( SignatureType = 'authority' and exists (select 1 from AuthoritySignatureTaskExtension A where A.TaskId = new.Id))
							or ( SignatureType = 'admin' and exists (select 1 from AdminSignatureTaskExtension A where A.TaskId = new.Id))
							or ( SignatureType = 'election' and exists (select 1 from ElectionSignatureTaskExtension E where E.TaskId = new.Id))
							or ( SignatureType = 'election-revision' and exists (select 1 from ElectionRevisionSignatureTaskExtension ER where ER.TaskId = new.Id))
							or ( SignatureType = 'ballot' and exists (select 1 from BallotSignatureTaskExtension B where B.TaskId = new.Id))
							or ( SignatureType = 'registrant' and exists (select 1 from RegistrantSignatureTaskExtension R where R.TaskId = new.Id))
					) )
		),
		constraint MutationValid check on insert, update (context.IsMutationValid = true)
	)
		with context ( IsMutationValid boolean, Tid int );

	table ReleaseKeyTaskExtension (
		TaskId text primary key, -- references Task.Id
		ElectionId text, -- references Election.Id
		ElectionRevision integer, -- references ElectionRevision.Revision
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'release-key')),
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint ElectionRevisionValid check (exists (select 1 from ElectionRevision ER where ER.ElectionId = new.ElectionId and ER.Revision = new.ElectionRevision))
	)
		with context ( Tid int );

	table NetworkSignatureTaskExtension (
		TaskId text primary key, -- references Task.Id
		NetworkName text, -- references Network.Name
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'network')),
		constraint NetworkIdValid check (exists (select 1 from ProposedNetwork N where N.Name = new.NetworkName)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce and A.Scope = 'rn'
					join ProposedNetwork N on N.Name = new.NetworkName
						where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'network'
							and T.IsCompleted = false
							and A.Digest = Digest(
								context.Tid, N.Name, N.ImageRef, N.Relays, N.TimestampAuthorities, N.NumberRequiredTSAs, N.ElectionType
							)
			)
			-- if the network change has been fully signed, no uncompleted tasks should be left
			and not exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
					join AdminSignature ASig on ASig.SigningNonce = A.Nonce
						where T.Id = new.TaskId and T.IsCompleted = false
			)
		),
		constraint DeleteValid check on delete (
			not exists (select 1 from Task T where T.Id = old.TaskId)
				or exists (select 1 from Task T where T.Id = old.TaskId and T.IsCompleted = true)
		)
	)
		with context ( Tid int );

	index NetworkSignatureTaskName on NetworkSignatureTaskExtension (NetworkName);

	table AuthoritySignatureTaskExtension (
		TaskId text primary key, -- references Task.Id
		AuthorityId text, -- references Authority.Id
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'authority')),
		constraint AuthorityIdValid check (exists (select 1 from ProposedAuthority A where A.Id = new.AuthorityId)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce and A.Scope = 'uai'
					join ProposedAuthority PA on PA.Id = new.AuthorityId
						where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'authority'
							and T.IsCompleted = false
							and A.Digest = Digest(
								context.Tid, PA.Id, PA.Name, PA.DomainName, PA.ImageRef
							)
			)
			-- if the authority change has been fully signed, no uncompleted tasks should be left
			and not exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
					join AdminSignature ASig on ASig.SigningNonce = A.Nonce
						where T.Id = new.TaskId and T.IsCompleted = false
			)
		),
		constraint DeleteValid check on delete (
			not exists (select 1 from Task T where T.Id = old.TaskId)
				or exists (select 1 from Task T where T.Id = old.TaskId and T.IsCompleted = true)
		)
	)
		with context ( Tid int );

	index AuthoritySignatureTaskId on AuthoritySignatureTaskExtension (AuthorityId);

	table AdminSignatureTaskExtension (
		TaskId text primary key, -- references Task.Id
		AuthorityId text, -- references Authority.Id
		AdminEffectiveAt datetime, -- references Admin.EffectiveAt
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'admin')),
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint AdminEffectiveAtValid check (exists (select 1 from Admin A where A.AuthorityId = new.AuthorityId and A.EffectiveAt = new.AdminEffectiveAt)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce and A.Scope = 'rad'
					join ProposedAdmin PA on PA.AuthorityId = new.AuthorityId and PA.EffectiveAt = new.AdminEffectiveAt
						where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'admin'
							and T.IsCompleted = false
							and A.Digest = Digest(
								context.Tid, PA.AuthorityId, PA.EffectiveAt, PA.ThresholdPolicies
							)
			)
			-- if the admin change has been fully signed, no uncompleted tasks should be left
			and not exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
					join AdminSignature ASig on ASig.SigningNonce = A.Nonce
						where T.Id = new.TaskId and T.IsCompleted = false
			)
		),
		constraint DeleteValid check on delete (
			not exists (select 1 from Task T where T.Id = old.TaskId)
				or exists (select 1 from Task T where T.Id = old.TaskId and T.IsCompleted = true)
		)
	)
		with context ( Tid int );

	index AdminSignatureTaskId on AdminSignatureTaskExtension (AuthorityId, AdminEffectiveAt);

	-- This is for creating a new election, revising an election uses the ElectionRevisionSignatureTaskExtension table
	table ElectionSignatureTaskExtension (
		TaskId text primary key, -- references Task.Id
		ElectionId text, -- references Election.Id
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'election')),
		constraint ElectionIdValid check (exists (select 1 from ProposedElection E where E.Id = new.ElectionId)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce and A.Scope = 'mel'
					join ProposedElection PE on PE.Id = new.ElectionId
						where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'election'
							and T.IsCompleted = false
							and A.Digest = Digest(
								context.Tid, PE.Id, PE.AuthorityId, PE.Title, PE.Date, PE.RevisionDeadline, PE.BallotDeadline, PE.Type
							)
			)
			-- if the election has been fully signed, no uncompleted tasks should be left
			and not exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
					join AdminSignature ASig on ASig.SigningNonce = A.Nonce
						where T.Id = new.TaskId and T.IsCompleted = false
			)
		),
		constraint DeleteValid check on delete (
			not exists (select 1 from Task T where T.Id = old.TaskId)
				or exists (select 1 from Task T where T.Id = old.TaskId and T.IsCompleted = true)
		)
	)
		with context ( Tid int );

	index ElectionSignatureTaskId on ElectionSignatureTaskExtension (ElectionId);

	table ElectionRevisionSignatureTaskExtension (
		TaskId text primary key, -- references Task.Id
		ElectionId text, -- references Election.Id
		ElectionRevision integer, -- references ElectionRevision.Revision
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'election-revision')),
		constraint ElectionIdValid check (exists (select 1 from ProposedElectionRevision ER where ER.ElectionId = new.ElectionId and ER.Revision = new.ElectionRevision)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce and A.Scope = 'mel'
					join ProposedElectionRevision PER on PER.ElectionId = new.ElectionId and PER.Revision = new.ElectionRevision
						where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'election-revision'
							and T.IsCompleted = false
							and A.Digest = Digest(
								context.Tid, PER.ElectionId, PER.Revision, PER.RevisionTimestamp, PER.Tags, PER.Instructions, PER.Timeline, PER.KeyholderThreshold
							)
			)
			-- if the election revision has been fully signed, no uncompleted tasks should be left
			and not exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
					join AdminSignature ASig on ASig.SigningNonce = A.Nonce
						where T.Id = new.TaskId and T.IsCompleted = false
			)
		),
		constraint DeleteValid check on delete (
			not exists (select 1 from Task T where T.Id = old.TaskId)
				or exists (select 1 from Task T where T.Id = old.TaskId and T.IsCompleted = true)
		)
	)
		with context ( Tid int );

	index ElectionRevisionSignatureTaskId on ElectionRevisionSignatureTaskExtension (ElectionId, ElectionRevision);

	table BallotSignatureTaskExtension (
		TaskId text primary key, -- references Task.Id
		BallotId text, -- references Ballot.Id
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'ballot')),
		constraint BallotIdValid check (exists (select 1 from ProposedBallot B where B.Id = new.BallotId)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce and A.Scope = 'ceb'
					join ProposedBallot PB on PB.Id = new.BallotId
						where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'ballot'
							and T.IsCompleted = false
							and A.Digest = Digest(
								context.Tid, PB.Id, PB.ElectionId, PB.AuthorityId, PB.Description, PB.Districts
							)
			)
			-- if the ballot has been fully signed, no uncompleted tasks should be left
			and not exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
					join AdminSignature ASig on ASig.SigningNonce = A.Nonce
						where T.Id = new.TaskId and T.IsCompleted = false
			)
		),
		constraint DeleteValid check on delete (
			not exists (select 1 from Task T where T.Id = old.TaskId)
				or exists (select 1 from Task T where T.Id = old.TaskId and T.IsCompleted = true)
		)
	)
		with context ( Tid int );

	index BallotSignatureTaskBallot on BallotSignatureTaskExtension (BallotId);

	-- D-05. This is the FIRST signature-extension table whose FK target (RegistrationRequest) is
	-- NOT a ProposedX table -- that is correct; the extension pattern only needs a stable row with
	-- a digest to bind to. Do not "fix" this asymmetry by reshaping RegistrationRequest.
	table RegistrantSignatureTaskExtension (
		TaskId text primary key, -- references Task.Id
		RequestId text, -- references RegistrationRequest.Id
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'registrant')),
		constraint RequestIdValid check (exists (select 1 from RegistrationRequest R where R.Id = new.RequestId)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce and A.Scope = 'vrg'
					join RegistrationRequest R on R.Id = new.RequestId
						where T.Id = new.TaskId and T.Type = 'signature' and T.SignatureType = 'registrant'
							and T.IsCompleted = false
							and A.Digest = Digest(
								context.Tid, R.Id, R.AuthorityId, R.RequesterKey, R.IssuerType, R.BridgeId, R.PayloadCid, R.SubmittedAt
							)
			)
			-- if the registration request change has been fully signed, no uncompleted tasks should be left
			and not exists (
				select 1 from Task T join AdminSigning A on A.Nonce = T.SigningNonce
					join AdminSignature ASig on ASig.SigningNonce = A.Nonce
						where T.Id = new.TaskId and T.IsCompleted = false
			)
		),
		constraint DeleteValid check on delete (
			not exists (select 1 from Task T where T.Id = old.TaskId)
				or exists (select 1 from Task T where T.Id = old.TaskId and T.IsCompleted = true)
		)
	)
		with context ( Tid int );

	index RegistrantSignatureTaskRequest on RegistrantSignatureTaskExtension (RequestId);

	table OnboardingTaskExtension (
		TaskId text primary key, -- references Task.Id
		OnboardingId text, -- references Onboarding.Id
		constraint TaskIdValid check (exists (select 1 from Task T where T.Id = new.TaskId and T.Type = 'onboarding')),
		constraint OnboardingIdValid check (exists (select 1 from Onboarding O where O.Id = new.OnboardingId))
	)
		with context ( Tid int );

	table Onboarding (
		Id text primary key, -- 32 byte random id
		-- TODO: Add whatever onboarding tasks will need
		constraint InsertOnly check on update, delete (false)
	)
		with context ( Tid int );

	view TaskType as
		select 'release-key' as Code
		union all select 'signature' as Code
		union all select 'onboarding' as Code;

	view SignatureType as
		select 'admin' as Code
		union all select 'authority' as Code
		union all select 'network' as Code
		union all select 'election' as Code
		union all select 'election-revision' as Code
		union all select 'ballot' as Code
		union all select 'registrant' as Code;

	-- ═══════════════════════════════════════════════════════════════════════
	-- Registration
	-- Voter registration, device association + attestation, authority peers, polling devices
	-- ═══════════════════════════════════════════════════════════════════════

	view RegistrationRequestStatus as
		select 'p' as Code, 'Pending' as Name
		union all select 'a' as Code, 'Approved' as Name
		union all select 'r' as Code, 'Rejected' as Name;

	view RegistrationRequestIssuer as
		select 'registrant' as Code, 'Registrant' as Name
		union all select 'bridge' as Code, 'Bridge' as Name;

	-- D-03 registry: the bounded, append-only allowlist of bridge keys authorized to submit
	-- RegistrationRequest rows on another person's behalf. RevokedAt is shipped so
	-- RegistrationRequest.BridgeIdValid can honestly enforce revocation, but no revoke ceremony
	-- ships this phase (48-07 implements registerBridgeKey/listBridgeKeys only) -- do not add one
	-- and do not remove the column because nothing writes it yet.
	table RegistrationBridgeKey (
		Id text primary key, -- 32 byte random id
		AuthorityId text,
		Label text, -- human-readable importer name, surfaced in the inbox (48-14)
		BridgeKey text, -- the bridge's public key
		RevokedAt datetime null,
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint RevokedAtValid check (RevokedAt is null or (isISODatetime(RevokedAt) and like('%Z', RevokedAt))),
		constraint CantDelete check on delete (false),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = new.AuthorityId
						and A.Scope = 'vrg'
						and A.Digest = Digest(
							context.Tid, new.Id, new.AuthorityId, new.Label, new.BridgeKey, new.RevokedAt
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int );

	-- D-02/D-03/D-06/D-07 intake row. Authorized on INSERT SOLELY by the requester's own
	-- signature (SignatureValid below) -- NO User FK, NO IsUserValid gate (D-02/D-04). This is
	-- deliberately NOT a ProposedX-shaped table; see votetorrent.qsql's ProposedOfficer (:411) for
	-- the shape this table must NOT have.
	--
	-- SubmittedAt vs ReceivedAt (L-3): SubmittedAt is SUPPLIED BY THE SUBMITTER -- it is DG-1's
	-- seventh argument, so it must be a value the signer already knew at signing time (an offline
	-- courier binding depends on this). ReceivedAt is the AUTHORITY'S OWN OBSERVATION of intake
	-- time, written by the engine with toIsoZDatetime, and is deliberately inside NO digest at all.
	-- Do not collapse these two columns back into one -- see the plan's <digest_register>.
	table RegistrationRequest (
		Id text primary key, -- 32 byte random id
		AuthorityId text,
		RequesterKey text, -- the requester's (or bridge's) public key
		IssuerType text default 'registrant', -- references RegistrationRequestIssuer(Code)
		BridgeId text null, -- references RegistrationBridgeKey.Id when IssuerType = 'bridge'
		Payload text, -- JSON RegisterInit
		PayloadCid text, -- content-addressed hash of Payload
		Status text default 'p', -- references RegistrationRequestStatus(Code)
		SubmittedAt datetime, -- submitter-supplied, inside DG-1 (see comment above)
		ReceivedAt datetime, -- authority-observed intake time, inside NO digest (see comment above)
		RequesterSignature text,
		VerificationCid text null, -- content-addressed hash of the structured verification record (D-07)
		DecidedAt datetime null,
		DecidingOfficerUserId text null,
		RejectionReason text null,
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint StatusValid check (Status in (select Code from RegistrationRequestStatus)),
		constraint IssuerTypeValid check (IssuerType in (select Code from RegistrationRequestIssuer)),
		-- D-03 machine-distinguishability gate: a bridge assertion is distinguishable from a
		-- voter's own act at the data layer, not merely in the UI.
		constraint BridgeIdValid check (
			(IssuerType = 'registrant' and BridgeId is null)
				or (IssuerType = 'bridge' and exists (
					select 1 from RegistrationBridgeKey B where B.Id = new.BridgeId and B.BridgeKey = new.RequesterKey and B.RevokedAt is null
				))
		),
		-- payload's digest-boundness is what makes DG-1 cover the payload transitively
		constraint PayloadCidValid check (PayloadCid = Digest(Payload)),
		-- SubmittedAt validates an UNTRUSTED, submitter-supplied value (L-3), not an engine-written one
		constraint SubmittedAtValid check (isISODatetime(SubmittedAt) and like('%Z', SubmittedAt)),
		-- ReceivedAt is written by the engine with toIsoZDatetime
		constraint ReceivedAtValid check (isISODatetime(ReceivedAt) and like('%Z', ReceivedAt)),
		-- Absolute plausibility bound only -- NOT the relative skew window (that is engine-side,
		-- 48-07). Arithmetic-free lexicographic comparison over fixed-width canonical ISO-Z strings.
		constraint SubmittedAtSaneValid check on insert (
			SubmittedAt >= '2024-01-01T00:00:00.000Z' and SubmittedAt < '2100-01-01T00:00:00.000Z'
		),
		constraint DecidedAtValid check (DecidedAt is null or (isISODatetime(DecidedAt) and like('%Z', DecidedAt))),
		-- D-02 -- the ONLY authorization gate on INSERT. No User FK, no UserId/UserKey context
		-- param, no IsUserValid gate. Unqualified so it re-evaluates on UPDATE.
		-- 49-02 (D-02/D-03) audit verdict: RequesterKey is PROVABLY voter/bridge-side only, never
		-- an Authority-app device key -- deliberately left secp256k1-only, NOT curve-branched.
		-- registration-engine.ts submitRegistrationRequest is called exclusively by the
		-- requesting party (the registrant's own device, see
		-- VoteTorrentVoter ConfirmationScreen.tsx-style self-service submission) or by an
		-- allowlisted RegistrationBridgeKey holder (an external paper-form-intake operator key,
		-- registered in its own RegistrationBridgeKey table -- never in UserKey, never the
		-- Authority app's own signing key). No Authority-app call site ever signs a
		-- RegistrationRequest with its own device key; the Authority app only ever DECIDES on one
		-- (RegistrationRequest.DecisionValid, a separate CHECK, out of this constraint's scope).
		constraint SignatureValid check (
			SignatureValid(
				Digest(Id, AuthorityId, RequesterKey, IssuerType, BridgeId, PayloadCid, SubmittedAt),
				RequesterSignature,
				RequesterKey
			)
		),
		constraint IdImmutable check on update (new.Id = old.Id),
		constraint PayloadImmutable check on update (new.Payload = old.Payload),
		-- WR-08: every remaining IDENTITY column is now immutable too. SignatureValid above is
		-- deliberately unqualified so it re-evaluates on UPDATE -- but it verifies
		-- Digest(Id, AuthorityId, RequesterKey, IssuerType, BridgeId, PayloadCid, SubmittedAt)
		-- against RequesterSignature AND RequesterKey, both COLUMNS OF THE SAME ROW. An UPDATE that
		-- changed AuthorityId, RequesterKey and RequesterSignature TOGETHER therefore still
		-- satisfied it (the attacker simply signs the new tuple with their own key) and, with a
		-- 'vrg' AdminSignature at the NEW authority, satisfied DecisionValid as well. Given this
		-- phase frames these CHECKs as THE authorization boundary, the omission was a real
		-- defense-in-depth gap; Registrant already carries AuthorityIdImmutable, this table did not.
		-- Note the interaction with the engine-side CR-02 refusal, which compares the payload
		-- against RegistrationRequest.AuthorityId: without AuthorityIdImmutable, rewriting that
		-- column was the last remaining way to move a request between authorities after intake.
		--
		-- WHY THERE IS NO SubmittedAtImmutable, and it is not an omission: SubmittedAt is the
		-- seventh argument of the SignatureValid digest above, and that CHECK is unqualified, so it
		-- re-runs on every UPDATE. With RequesterKey and RequesterSignature now immutable, an
		-- attacker can no longer re-sign a rewritten tuple, so SignatureValid pins SubmittedAt (and
		-- Id/AuthorityId/IssuerType/BridgeId/PayloadCid) transitively. A literal
		-- `new.SubmittedAt = old.SubmittedAt` CHECK is ALSO not expressible here: `new.*` sees the
		-- raw bound Z-suffixed value while `old.*` is read back Temporal-coerced (Z stripped,
		-- trailing fractional zeros dropped -- T-42-03/T-42-06), so the two never compare equal and
		-- the constraint would reject every legitimate decision. This was confirmed empirically, not
		-- assumed: the constraint was written, and the whole registrant accept AND reject suite went
		-- red with `CHECK constraint failed: SubmittedAtImmutable`.
		--
		-- WHY THERE IS NO ReceivedAtImmutable, stated as an OPEN RESIDUAL rather than a conclusion:
		-- ReceivedAt is inside NO digest, so the transitive argument above does not reach it -- and
		-- it is both the anti-backdating sort key (registration-request-query.ts's order key) and
		-- the basis of D-09's published median time-to-decision, so a rewrite would flatter the
		-- authority's own responsiveness figure. It is blocked by the SAME datetime-coercion
		-- asymmetry (a literal equality CHECK fails identically, also confirmed by running it), and
		-- no format-insensitive comparison is available: Quereus rejects the two-operand `is` form,
		-- and a prefix/`like` workaround would still admit a sub-second rewrite. What holds today is
		-- ENGINE-side only: the two decision ceremonies are the only writers, and both rebind
		-- ReceivedAt to its unchanged value via restoreCanonicalDatetime. Closing this properly needs
		-- either a Quereus-level datetime comparison primitive or ReceivedAt folded into a digest.
		-- BridgeId needs NULL-SAFE equality: it is null on every registrant-issued row, and
		-- `null = null` is null (not true), which would make a plain `=` reject every legitimate
		-- decision on a non-bridge request. Quereus's parser does NOT accept the two-operand
		-- `x is y` form (only `is null` / `is not null`), so the equality is spelled out as an
		-- explicit disjunction. The asymmetric cases still fail closed: null -> non-null (or the
		-- reverse) leaves the first disjunct false and the second null, so the CHECK does not pass.
		constraint AuthorityIdImmutable check on update (new.AuthorityId = old.AuthorityId),
		constraint RequesterKeyImmutable check on update (new.RequesterKey = old.RequesterKey),
		constraint RequesterSignatureImmutable check on update (new.RequesterSignature = old.RequesterSignature),
		constraint IssuerTypeImmutable check on update (new.IssuerType = old.IssuerType),
		constraint BridgeIdImmutable check on update (
			(new.BridgeId is null and old.BridgeId is null) or new.BridgeId = old.BridgeId
		),
		constraint PayloadCidImmutable check on update (new.PayloadCid = old.PayloadCid),
		-- D-06: a rejected request is a permanent, attributable record
		constraint NoDelete check on delete (false),
		-- D-06/D-07: the ONLY legal update to this table is a signed pending->decided transition
		constraint DecisionValid check on update (
			old.Status = 'p'
				and new.Status in ('a', 'r')
				and exists (
					select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
						where A.Nonce = context.SigningNonce
							and A.AuthorityId = new.AuthorityId
							and A.Scope = 'vrg'
							and A.Digest = Digest(
								context.Tid, new.Id, new.Status, new.VerificationCid, new.DecidedAt, new.DecidingOfficerUserId, new.RejectionReason
							)
				)
		)
	)
		-- At INSERT no signing session exists, so only Tid is meaningful -- 48-07 still binds both
		-- declared params. Do not "fix" the insert path by inventing a ceremony, and do not add a
		-- third context param.
		with context ( SigningNonce text, Tid int );

	index RegistrationRequestAuthorityStatus on RegistrationRequest (AuthorityId, Status);

	view RegistrantStatus as
		select 'a' as Code, 'Active' as Name
		union all select 's', 'Suspended'
		union all select 'r', 'Revoked';

	table Registrant (
		Id text primary key, -- 32 byte random unique registrant identifier
		AuthorityId text, -- authority that validated this registrant
		PrivateCid text, -- content-addressed hash of the registrant's private data
		PublicCid text null, -- content-addressed hash of the registrant's public data (null if no public data)
		SelectiveCid text null, -- content-addressed hash of the registrant's selective-disclosure data (null if none)
		Status text default 'a', -- references RegistrantStatus(Code)
		Expiration datetime,
		SignorKey text, -- public key of the authority signor
		Signature text, -- signature of this record by the signor
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint StatusValid check (Status in (select Code from RegistrantStatus)),
		constraint ExpirationValid check (isISODatetime(Expiration) and like('%Z', Expiration)),
		constraint ExpirationFuture check on insert (Expiration > context.now),
		constraint IdImmutable check on update (new.Id = old.Id),
		constraint AuthorityIdImmutable check on update (new.AuthorityId = old.AuthorityId),
		-- 49-02 (D-02/D-03) audit finding: SignorKey is NOT always a voter-side key -- this row is
		-- signed either by the registrant's OWN device key (VoteTorrentVoter's self-service
		-- registration path, ConfirmationScreen.tsx, secp256k1 by design) OR by the reviewing
		-- Authority officer's device key (signature-tasks-engine.ts finalizeRegistrantApproval's
		-- officer-approval path, which becomes P-256 this phase) -- genuinely mixed-curve.
		--
		-- UNLIKE AdminSigning/OfficerSignature/UserKey, this does NOT use a UserKey.Type lookup
		-- discriminant -- empirically, adding ANY correlated subquery here promotes this CHECK
		-- from an immediate (non-deferred) evaluation to Quereus's DEFERRED constraint queue,
		-- whose row snapshot re-derives `new.Expiration` through a Temporal round-trip that
		-- strips the trailing `Z` (the same class of trap recorded in this project's Quereus
		-- deferred-CHECK memory). `Digest(Id, ..., Expiration)` recomputed against that
		-- Z-stripped snapshot no longer matches the digest the caller pre-signed with the raw
		-- Z-suffixed value (registration-engine.ts createRegistrant step 1), so EVERY insert --
		-- secp256k1 included -- started failing closed when this was first tried with a
		-- coalesce((select ...)) discriminant (confirmed empirically: the full registration
		-- suite went red, not just the P-256 cases). Trying both curves directly needs no
		-- subquery, stays a non-deferred CHECK, and is not a weaker check: an ECDSA signature
		-- essentially never verifies against the wrong curve's point/generator by chance (the
		-- same assumption Task 2's wrong-curve-rejection case already empirically proved for
		-- UserKey) -- so this only ever accepts a genuinely valid signature on ONE of the two
		-- curves, exactly like the discriminant form, just without the lookup.
		constraint SignatureValid check (
			SignatureValid(
				Digest(Id, AuthorityId, PrivateCid, PublicCid, SelectiveCid, Status, Expiration),
				Signature,
				SignorKey
			)
			or SignatureValidP256(
				Digest(Id, AuthorityId, PrivateCid, PublicCid, SelectiveCid, Status, Expiration),
				Signature,
				SignorKey
			)
		),
		constraint NoDelete check on delete (false),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = new.AuthorityId
						and A.Scope = 'vrg'
						and A.Digest = Digest(
							context.Tid, new.Id, new.AuthorityId, new.PrivateCid, new.PublicCid, new.SelectiveCid, new.Status, new.Expiration, new.SignorKey, new.Signature
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	table RegistrantPublic (
		Cid text, -- content-addressed hash of this record
		RegistrantId text, -- references Registrant.Id
		LastName text null,
		FirstName text null,
		District text null,
		ExtraFields text null, -- json object for authority-specific public fields
		primary key (RegistrantId, Cid), -- registrant-clustered storage key (one ranged fetch per registrant); Cid retains its content-integrity role
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId)),
		constraint CidValid check (Cid = cid(Digest(RegistrantId, LastName, FirstName, District, ExtraFields))),
		constraint RegistrantCidMatch check (exists (select 1 from Registrant R where R.Id = new.RegistrantId and R.PublicCid = new.Cid)),
		constraint InsertOnly check on update, delete (false),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = new.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, new.Cid, new.RegistrantId, new.LastName, new.FirstName, new.District, new.ExtraFields
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int );

	-- Authority-held private registrant data (not replicated to the public Election Network).
	-- Referenced by Registrant.PrivateCid; Registrant.Signature commits to this record via that hash.
	-- PrivateDetails is a json array of attribute triples { name, value, hint? } where `value` is
	-- either a scalar (a top-level field) or a nested array of the same triples (an object), and
	-- `hint` is optional validation metadata. PrivateDetails is NEVER disclosed; the selectively-
	-- disclosable tier lives in RegistrantSelective (separate Cid) so it can be revealed without
	-- exposing this record.
	table RegistrantPrivate (
		Cid text, -- content-addressed hash of this record
		RegistrantId text, -- references Registrant.Id
		Expiration datetime,
		PrivateDetails text null, -- json array of { name, value, hint? } triples (recursive); never disclosed
		primary key (RegistrantId, Cid), -- registrant-clustered storage key (one ranged fetch per registrant); Cid retains its content-integrity role
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId)),
		constraint ExpirationValid check (isISODatetime(Expiration) and like('%Z', Expiration)),
		constraint ExpirationFuture check on insert (Expiration > context.now),
		constraint CidValid check (Cid = cid(Digest(RegistrantId, Expiration, PrivateDetails))),
		constraint RegistrantCidMatch check (exists (select 1 from Registrant R where R.Id = new.RegistrantId and R.PrivateCid = new.Cid)),
		constraint InsertOnly check on update, delete (false),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = new.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, new.Cid, new.RegistrantId, new.Expiration, new.PrivateDetails
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	-- Authority-held selective-disclosure registrant data, committed SEPARATELY from PrivateDetails
	-- (own Cid, referenced by Registrant.SelectiveCid, covered by Registrant.Signature). Committed as a
	-- FLAT SALTED-LEAF SET (not a whole-set hash, not a Merkle tree) via the crypto plugin's set_commit:
	-- each attribute is a salted leaf leafDigest = digest([SD_LEAF_DOMAIN, name, value, salt]) and
	-- Cid = cid(set_commit(SelectiveDetails)) over the sorted leaf digests. This enables PER-FIELD
	-- selective disclosure: the engine reveals a subset via setDisclose(leaves, revealNames) and a
	-- recipient checks it with setVerify(root, disclosure) WITHOUT access to the hidden leaves or to
	-- PrivateDetails. Which fields are disclosed and to whom (e.g. same-district neighbors, or everyone)
	-- is decided per-election by ElectionDisclosurePolicy. Salts are random_bytes (>=128 bits); duplicate
	-- names and empty salts are rejected at commit. (Ref: Optimystic issue #5 — the landed flat-set design.)
	table RegistrantSelective (
		Cid text, -- content-addressed CIDv1 of this record: cid(set_commit(SelectiveDetails))
		RegistrantId text, -- references Registrant.Id
		Expiration datetime,
		SelectiveDetails text null, -- json array of flat { name, value, salt } salted leaves (SaltedLeaf[]); disclosed per-field per election policy via setDisclose/setVerify
		primary key (RegistrantId, Cid), -- registrant-clustered storage key (one ranged fetch per registrant); Cid retains its content-integrity role
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId)),
		constraint ExpirationValid check (isISODatetime(Expiration) and like('%Z', Expiration)),
		constraint ExpirationFuture check on insert (Expiration > context.now),
		constraint CidValid check (Cid = cid(set_commit(SelectiveDetails))),
		constraint RegistrantCidMatch check (exists (select 1 from Registrant R where R.Id = new.RegistrantId and R.SelectiveCid = new.Cid)),
		constraint InsertOnly check on update, delete (false),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = new.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, new.Cid, new.RegistrantId, new.Expiration, new.SelectiveDetails
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	table ElectionRegistrant (
		ElectionId text,
		RegistrantId text,
		primary key (ElectionId, RegistrantId),
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId and R.Status = 'a')),
		constraint RegistrantNotExpired check (exists (select 1 from Registrant R where R.Id = new.RegistrantId and R.Expiration > context.now)),
		constraint InsertValid check on insert (
			-- Authority path: registrar-scope admin signature (the pre-existing path).
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = new.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, new.ElectionId, new.RegistrantId
						)
			)
			-- Self-service path (doc/registration.md "or the user, if permitted"): when the
			-- election's enrollment policy allows it, the registrant's OWN associated device key
			-- may enroll, signing the same tuple. The Association join proves the signing key is
			-- currently bound to exactly this registrant (and the registrant is active/unexpired);
			-- SignatureValid pins the signature to (Tid, election, registrant) so it cannot be
			-- replayed onto another row. Dual-curve: device keys are secp256k1 today, P-256 as the
			-- authority-app ceremony migrates (49-02 precedent).
			or (
				context.UserKey is not null and context.UserSignature is not null
				and exists (
					select 1 from ElectionEnrollmentPolicy P
						where P.ElectionId = new.ElectionId and P.AllowSelfEnrollment = 1
				)
				and exists (
					select 1 from Association A join Registrant R on R.Id = A.RegistrantId
						where A.RegistrantId = new.RegistrantId
							and A.DeviceKey = context.UserKey
							and A.Expiration > context.now
							and R.Status = 'a' and R.Expiration > context.now
				)
				and (
					SignatureValid(Digest(context.Tid, new.ElectionId, new.RegistrantId), context.UserSignature, context.UserKey)
					or SignatureValidP256(Digest(context.Tid, new.ElectionId, new.RegistrantId), context.UserSignature, context.UserKey)
				)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = old.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, old.ElectionId, old.RegistrantId, 'delete'
						)
			)
		),
		constraint NoUpdate check on update (false)
	)
		with context ( SigningNonce text, Tid int, now datetime, UserKey text null, UserSignature text null );

	index ElectionRegistrantRegistrant on ElectionRegistrant (RegistrantId);

	-- Authority-issued device-attestation challenge. Before a device can Associate, the authority issues
	-- a one-time nonce bound to (RegistrantId, DeviceKey); the device's platform attestation (iOS App
	-- Attest / Android Play Integrity) must answer this exact nonce. Short-lived (Expiration). One-time
	-- use is structural, not a cross-row check: the resulting Association PK is (RegistrantId, DeviceKey),
	-- so one satisfied challenge cannot yield a second association, and the nonce is bound to a single
	-- registrant+device so it cannot be replayed elsewhere. The authority deletes the challenge once
	-- consumed. Issuance/deletion are authority-authorized under the 'vrg' scope.
	table AttestationChallenge (
		Nonce text primary key, -- random challenge nonce the device must attest against
		AuthorityId text, -- issuing authority
		RegistrantId text, -- registrant this challenge is bound to
		DeviceKey text, -- device voting public key this challenge is bound to
		ElectionId text null, -- which election this challenge is for (D-14a); welded into
			-- InsertValid's Digest below, lockstep with AssociationEngine.issueAttestationChallenge's
			-- digestExpr (45-04). Nullable so a null-electionId challenge still binds :electionId=null
			-- and passes InsertValid identically on both sides.
		Expiration datetime, -- short TTL
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId and R.Status = 'a')),
		constraint ExpirationValid check (isISODatetime(Expiration) and like('%Z', Expiration)),
		constraint ExpirationFuture check on insert (Expiration > context.now),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = new.AuthorityId
						and A.Scope = 'vrg'
						and A.Digest = Digest(
							context.Tid, new.Nonce, new.AuthorityId, new.RegistrantId, new.DeviceKey, new.ElectionId, new.Expiration
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = old.AuthorityId
						and A.Scope = 'vrg'
						and A.Digest = Digest(
							context.Tid, old.Nonce, 'delete'
						)
			)
		),
		constraint NoUpdate check on update (false)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	table Association (
		RegistrantId text,
		DeviceKey text, -- public key for voting; private key in biometrically secured TPM
		DeviceHash text null, -- sha256 hash of the device's ID (not the ID itself, for privacy); null = device uniqueness not publicly disclosed (transparency toggle off)
		AttestationCid text null, -- content-addressed hash of the authority-held AssociationPrivate (device attestation); null = no attestation committed on-network (e.g. self-signed/legacy)
		Expiration datetime,
		SignorKey text, -- public key of the authority signor
		Signature text, -- signature of this record by the signor
		primary key (RegistrantId, DeviceKey),
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId and R.Status = 'a')),
		constraint ExpirationValid check (isISODatetime(Expiration) and like('%Z', Expiration)),
		constraint ExpirationFuture check on insert (Expiration > context.now),
		-- 49-02 (D-02/D-03) audit finding: same reasoning as Registrant.SignatureValid above --
		-- SignorKey is either the registrant's own device key (VoteTorrentVoter self-service
		-- association, secp256k1) or the reviewing Authority officer's device key (Authority-app
		-- association ceremony, becomes P-256 this phase) -- mixed-curve. Same subquery-free
		-- "try both curves" form as Registrant.SignatureValid, for the SAME empirically-found
		-- reason: a UserKey.Type lookup discriminant here promotes this CHECK to Quereus's
		-- deferred queue, whose Expiration re-derivation no longer matches the pre-signed digest
		-- (association-engine.ts associate()'s row-level signature, computed before insert with
		-- the raw Z-suffixed value) -- see Registrant.SignatureValid's comment for the full
		-- empirical finding.
		constraint SignatureValid check (
			SignatureValid(
				Digest(RegistrantId, DeviceKey, DeviceHash, AttestationCid, Expiration),
				Signature,
				SignorKey
			)
			or SignatureValidP256(
				Digest(RegistrantId, DeviceKey, DeviceHash, AttestationCid, Expiration),
				Signature,
				SignorKey
			)
		),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = new.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, new.RegistrantId, new.DeviceKey, new.DeviceHash, new.AttestationCid, new.Expiration, new.SignorKey, new.Signature
						)
			)
		),
		constraint NoUpdate check on update (false),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = old.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, old.RegistrantId, old.DeviceKey, 'delete'
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	index AssociationDeviceHash on Association (DeviceHash);

	view CurrentAssociation as
		select A.RegistrantId, A.DeviceKey, A.DeviceHash, A.Expiration
			from Association A
			join Registrant R on R.Id = A.RegistrantId
			where A.Expiration > datetime('now') and R.Status = 'a' and R.Expiration > datetime('now');

	-- Authority-held private device-association data (not replicated to the public Election Network).
	-- Referenced by Association.AttestationCid; Association.Signature commits to this record via that hash.
	-- Holds the sensitive device attestation: DeviceId can deanonymize/track a voter, so it never leaves
	-- the authority (the public Association exposes at most DeviceHash = sha256(DeviceId), transparency
	-- toggle). DeviceId, AttestationTime and Nonce are promoted for authority-side uniqueness/replay
	-- checks; AttestationDetails carries the platform-specific remainder of the DeviceAttestation struct
	-- ({ location?, attestationStatement?, certificateChain, platformDetails? }).
	table AssociationPrivate (
		Cid text, -- content-addressed hash of this record
		RegistrantId text, -- references Registrant.Id
		DeviceKey text, -- public voting key of the associated device (links to Association)
		DeviceId text, -- actual device / app-install id (sensitive; authority-held only)
		AttestationTime datetime, -- when the platform attestation was performed
		Nonce text, -- the AttestationChallenge nonce this attestation answered
		AttestationDetails text null, -- json object: remaining DeviceAttestation fields { location?, attestationStatement?, certificateChain, platformDetails? }
		Expiration datetime,
		primary key (RegistrantId, DeviceKey, Cid), -- registrant-clustered storage key (one ranged fetch per registrant); Cid retains its content-integrity role
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId)),
		constraint AttestationTimeValid check (isISODatetime(AttestationTime) and like('%Z', AttestationTime)),
		constraint ExpirationValid check (isISODatetime(Expiration) and like('%Z', Expiration)),
		constraint ExpirationFuture check on insert (Expiration > context.now),
		constraint CidValid check (Cid = cid(Digest(RegistrantId, DeviceKey, DeviceId, AttestationTime, Nonce, AttestationDetails, Expiration))),
		constraint AssociationCidMatch check (exists (select 1 from Association A where A.RegistrantId = new.RegistrantId and A.DeviceKey = new.DeviceKey and A.AttestationCid = new.Cid)),
		constraint ChallengeValid check (exists (select 1 from AttestationChallenge C where C.Nonce = new.Nonce and C.RegistrantId = new.RegistrantId and C.DeviceKey = new.DeviceKey)),
		constraint InsertOnly check on update, delete (false),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Registrant R on R.Id = new.RegistrantId
					where A.Nonce = context.SigningNonce
						and A.Scope = 'vrg'
						and A.AuthorityId = R.AuthorityId
						and A.Digest = Digest(
							context.Tid, new.Cid, new.RegistrantId, new.DeviceKey, new.DeviceId, new.AttestationTime, new.Nonce, new.AttestationDetails, new.Expiration
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	table AuthorityPeer (
		AuthorityId text,
		PeerId text,
		primary key (AuthorityId, PeerId),
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = new.AuthorityId
						and A.Scope = 'cap'
						and A.Digest = Digest(
							context.Tid, new.AuthorityId, new.PeerId
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = old.AuthorityId
						and A.Scope = 'cap'
						and A.Digest = Digest(
							context.Tid, old.AuthorityId, old.PeerId, 'delete'
						)
			)
		),
		constraint NoUpdate check on update (false)
	)
		with context ( SigningNonce text, Tid int );

	table PollingDevice (
		AuthorityId text,
		DeviceHash text, -- sha256 hash of the device ID
		Label text null, -- human-readable label for the polling location/device
		primary key (AuthorityId, DeviceHash),
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint InsertValid check on insert (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = new.AuthorityId
						and A.Scope = 'vrg'
						and A.Digest = Digest(
							context.Tid, new.AuthorityId, new.DeviceHash, new.Label
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = old.AuthorityId
						and A.Scope = 'vrg'
						and A.Digest = Digest(
							context.Tid, old.AuthorityId, old.DeviceHash, 'delete'
						)
			)
		),
		constraint NoUpdate check on update (false)
	)
		with context ( SigningNonce text, Tid int );

	-- Authority-held, unsigned, InsertOnly access trail for RegistrantPrivate reads (D-01/D-02).
	-- Not replicated to the public Election Network -- same posture as RegistrantPrivate itself.
	-- Fields holds a JSON array of the revealed PRIVATE attribute NAMES only, never their values.
	-- One row is written per screen-visit (D-14): a single audit row records the set of private
	-- fields revealed during that visit, flushed on unmount/background rather than per-field-tap.
	--
	-- Accountability, deterrence, and regulatory posture -- NOT a security control. This table
	-- records app-mediated access only: reads happen on the officer's own device against a local
	-- Quereus/LevelDB file, and an officer who queries that file directly (or pulls the LevelDB
	-- store off the device) bypasses the app entirely, so no row is written for that access. It
	-- neither prevents nor restricts anything; it exists so app-mediated PII reveals are
	-- accountable after the fact.
	table RegistrantAccessEvent (
		RegistrantId text, -- references Registrant.Id
		ViewerUserId text, -- the officer's User.Id who viewed the private tier
		Sequence integer not null, -- per-registrant monotonic ordering key (coalesce(max(Sequence),-1)+1)
		Timestamp datetime, -- Z-suffixed ISO (toIsoZDatetime); NOT nowCanonicalDatetime(), which lacks the trailing Z the CHECK below requires
		Fields text, -- JSON array of revealed private attribute NAMES -- never values
		primary key (RegistrantId, Sequence),
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId)),
		constraint TimestampValid check (isISODatetime(Timestamp) and like('%Z', Timestamp)),
		constraint InsertOnly check on update, delete (false)
	)
		with context ( Tid int, now datetime );

	view AttestationVerdictResult as
		select 'pass' as Code, 'Pass' as Name
		union all select 'fail' as Code, 'Fail' as Name;

	-- Authority-held, unsigned, InsertOnly store for device-attestation verdicts (D-03). Persists
	-- PlayIntegrityVerifier.verify()'s otherwise-transient { ok, reason } result, which today is
	-- never written anywhere. AssociationPrivate cannot carry it after the fact: that table is
	-- InsertOnly and its Cid commits to a fixed digest tuple over the device-produced attestation
	-- data, so folding an authority-computed judgement in would conflate the two. Sequence is
	-- monotonic per (RegistrantId, DeviceKey) so re-verifications accumulate over time rather than
	-- overwriting. Verdict is a text code referencing AttestationVerdictResult(Code) -- a
	-- boolean-default column here would hit the quereus 4.x re-attach ALTER-COLUMN coercion class
	-- (see the schema's ElectionRegistrationField comment above). Deliberately carries NO
	-- foreign-key CHECK against Association/AssociationPrivate: a FAIL verdict is written before
	-- the associate() ceremony throws, at a point where no Association row exists yet on that
	-- path, so such a CHECK would make recording a failed verification structurally impossible --
	-- destroying exactly the record this table exists to keep. RegistrantIdValid deliberately does
	-- NOT require R.Status = 'a' (unlike Association's own existence CHECK): a verdict must stay
	-- readable after a registrant is later suspended or revoked.
	table AttestationVerdict (
		RegistrantId text, -- references Registrant.Id
		DeviceKey text, -- the device's public key, as attested (no FK -- see comment above)
		Sequence integer not null, -- per (RegistrantId, DeviceKey) monotonic ordering key
		Verdict text, -- references AttestationVerdictResult(Code)
		Reason text null, -- the verifier's {reason} string, if any
		VerifiedAt datetime, -- Z-suffixed ISO (toIsoZDatetime); NOT nowCanonicalDatetime(), which lacks the trailing Z the CHECK below requires
		primary key (RegistrantId, DeviceKey, Sequence),
		constraint RegistrantIdValid check (exists (select 1 from Registrant R where R.Id = new.RegistrantId)),
		constraint VerdictValid check (Verdict in (select Code from AttestationVerdictResult)),
		constraint VerifiedAtValid check (isISODatetime(VerifiedAt) and like('%Z', VerifiedAt)),
		constraint InsertOnly check on update, delete (false)
	)
		with context ( Tid int, now datetime );

	view RegistrantTier as
		select 'public' as Code, 'Public' as Name
		union all select 'selective' as Code, 'Selective' as Name
		union all select 'private' as Code, 'Private' as Name;

	view FieldRequirement as
		select 'required' as Code, 'Required' as Name
		union all select 'optional' as Code, 'Optional' as Name;

	-- Election policy: the per-election registration field schema — which registrant detail fields this
	-- election expects, which tier (public / selective / private) each belongs to, and whether furnishing
	-- it is required to register. Companion to ElectionDisclosurePolicy (which maps a selective field name
	-- to an audience). A field's Tier says which record its value lands in: RegistrantPublic (a column or
	-- an ExtraFields entry), RegistrantSelective.SelectiveDetails, or RegistrantPrivate.PrivateDetails.
	-- Admin-signed under the 'mel' (Manage Elections) scope, keyed by ElectionId (per-election, not
	-- network-wide). Enforcement that a Register submission actually furnishes the Required fields in the
	-- correct tier is engine-side at Register time — the schema declares the policy; the engine validates
	-- submissions against it. (Requirement/Tier are text codes, not integer/boolean columns, to avoid the
	-- Quereus number-in-Digest coercion and boolean-default re-attach ALTER COLUMN pitfalls.)
	table ElectionRegistrationField (
		ElectionId text, -- references Election.Id
		FieldName text, -- attribute name (a RegistrantPublic column / ExtraFields key, or a top-level name within SelectiveDetails / PrivateDetails)
		Tier text, -- references RegistrantTier(Code)
		Requirement text, -- references FieldRequirement(Code)
		primary key (ElectionId, FieldName),
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint TierValid check (Tier in (select Code from RegistrantTier)),
		constraint RequirementValid check (Requirement in (select Code from FieldRequirement)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = new.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(
							context.Tid, new.ElectionId, new.FieldName, new.Tier, new.Requirement
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = old.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(
							context.Tid, old.ElectionId, old.FieldName, old.Tier, old.Requirement, 'delete'
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int );

	index ElectionRegistrationFieldElection on ElectionRegistrationField (ElectionId);

	view DisclosureAudience as
		select 'district' as Code, 'Same district (neighboring voters)' as Name
		union all select 'everyone' as Code, 'Everyone' as Name;

	-- Election policy: which RegistrantSelective field/object names may be disclosed, and to which
	-- audience, for a given election. The selective set itself is committed authority-side
	-- (RegistrantSelective / Registrant.SelectiveCid); this table only declares the disclosure
	-- intent per election (keyed by ElectionId). Delivery/filtering of disclosed data to
	-- recipients is handled off-schema by the engine/app at query time (no on-network disclosure
	-- record). Whole-set commitment (option B) means a disclosed subset is authority-vouched, not
	-- independently verifiable against SelectiveCid.
	table ElectionDisclosurePolicy (
		ElectionId text, -- references Election.Id
		FieldName text, -- a top-level attribute name within RegistrantSelective.SelectiveDetails
		Audience text, -- references DisclosureAudience(Code)
		primary key (ElectionId, FieldName),
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint AudienceValid check (Audience in (select Code from DisclosureAudience)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = new.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(
							context.Tid, new.ElectionId, new.FieldName, new.Audience
						)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = old.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(
							context.Tid, old.ElectionId, old.FieldName, old.Audience, 'delete'
						)
			)
		)
	)
		with context ( SigningNonce text, Tid int );

	index ElectionDisclosurePolicyElection on ElectionDisclosurePolicy (ElectionId);

	-- Election policy: whether this election requires device attestation to Associate (D-14a/b).
	-- Single row per election (PK = ElectionId); 'mel'-signed, mirrors ElectionRegistrationField/
	-- ElectionDisclosurePolicy. AttestationRequired MUST stay `integer default` (NEVER `boolean
	-- default` -- Quereus v4 re-attach ALTER COLUMN landmine, project_quereus_v4_reattach_boolean_
	-- default_alter_column). Fail-closed default (1 = attestation required); enforcement of the
	-- fail-closed no-row-means-required posture is engine-side at the associate() read (45-04).
	table ElectionAttestationPolicy (
		ElectionId text primary key, -- references Election.Id
		AttestationRequired integer default 1, -- 1 = attestation required (safe/fail-closed default), 0 = not required
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = new.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(context.Tid, new.ElectionId, new.AttestationRequired)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = old.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(context.Tid, old.ElectionId, old.AttestationRequired, 'delete')
			)
		)
	)
		with context ( SigningNonce text, Tid int );

	-- ---------------------------------------------------------------------------
	-- VOTER-SIDE ELECTION PIPELINE (doc/election.md, doc/validations.md,
	-- doc/architecture.md). Election threshold key material, vote casting, block
	-- formation, tally/validation/certification records, directory discovery, and
	-- the enrollment policy consumed by ElectionRegistrant''s self-service path.
	--
	-- Signature conventions: rows signed by USER/DEVICE keys use the dual-curve
	-- SignatureValid / SignatureValidP256 pattern (secp256k1 today, P-256 as the
	-- authority ceremony migrates — 49-02). Rows signed by authorities use the
	-- AdminSignature/AdminSigning ''mel'' join like every other authority mutation.
	-- Flags are integer (0/1), NEVER boolean — Quereus v4 re-attach ALTER COLUMN
	-- landmine (see ElectionAttestationPolicy above).
	-- ---------------------------------------------------------------------------

	-- Election threshold-encryption public key. Votes are ciphertexts against this key;
	-- decryption requires the keyholder threshold (KeyholderThreshold on ElectionRevision).
	--
	-- WHY A TABLE AND NOT A COLUMN ON ELECTIONRevision: adding to that table''s MutationValid
	-- Digest tuple breaks every existing signed row AND every engine builder mirroring the
	-- tuple in lockstep. A standalone ''mel''-signed row carries the same commitment with zero
	-- blast radius; it can be frozen engine-side once Timeline.votingStarts passes.
	table ElectionKey (
		ElectionId text primary key, -- references Election.Id
		PublicKey text, -- threshold encryption public key (serialized per the crypto scheme)
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint PublicKeyNotEmpty check (PublicKey is not null and length(PublicKey) > 0),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = new.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(context.Tid, new.ElectionId, new.PublicKey)
			)
		)
	)
		with context ( SigningNonce text, Tid int );

	-- A keyholder''s published private election key (or share), released during the Releasing
	-- Keys window (doc/election.md "Election unlocked"). Signed by the keyholder''s own user
	-- key; Tsas carries external timestamp(s) proving release timing. A row whose Tsas/
	-- ReleasedAt falls OUTSIDE the window is the premature-disclosure ANOMALY RECORD consumed
	-- by validation (doc/election.md "Validation Process") — the schema records evidence, the
	-- window comparison is validation-side.
	table ReleasedKey (
		ElectionId text,
		UserId text,
		KeyMaterial text, -- released private key/share (serialized); decryptability is proven at tally time
		ReleasedAt datetime,
		Tsas text null, -- json array of TSA timestamp tokens
		primary key (ElectionId, UserId),
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint KeyholderValid check (exists (
			select 1 from Keyholder K where K.ElectionId = new.ElectionId and K.UserId = new.UserId)),
		constraint KeyMaterialNotEmpty check (KeyMaterial is not null and length(KeyMaterial) > 0),
		constraint ReleasedAtValid check (isISODatetime(ReleasedAt) and like('%Z', ReleasedAt)),
		constraint InsertValid check on insert (
			context.UserKey is not null and context.UserSignature is not null
			and exists (
				select 1 from UserKey UK where UK.UserId = new.UserId and UK.Key = context.UserKey
			)
			and (
				SignatureValid(Digest(context.Tid, new.ElectionId, new.UserId, new.KeyMaterial, new.ReleasedAt), context.UserSignature, context.UserKey)
				or SignatureValidP256(Digest(context.Tid, new.ElectionId, new.UserId, new.KeyMaterial, new.ReleasedAt), context.UserSignature, context.UserKey)
			)
		),
		constraint NoUpdate check on update (false),
		constraint NoDelete check on delete (false)
	)
		with context ( UserKey text, UserSignature text, Tid int, now datetime );

	-- Voter entry: WHO is voting, per district ballot. One row per (election, ballot,
	-- registrant) — the PK IS the duplicate-registrant rejection of doc/validations.md.
	-- Carries the registrant references the spec requires (public registrant key = DeviceKey
	-- of an active Association; PublicCid/PrivateCid pinned to the Registrant''s actual CIDs),
	-- optional location/deviceID/attestation disclosures, and the registrant device''s
	-- signature over the entry plus the ballot-template CID (doc/election.md:99-110).
	table VoterEntry (
		Id text primary key, -- 32 byte random id
		ElectionId text,
		BallotId text,
		RegistrantId text,
		DeviceKey text, -- voting public key; must be an ACTIVE Association binding for this registrant
		PublicCid text, -- must equal Registrant.PublicCid (tamper-evident copy, not free text)
		PrivateCid text, -- must equal Registrant.PrivateCid
		OptionalInfo text null, -- json { location?, deviceIdHash?, attestationCid? }
		TemplateCid text, -- commitment to the district ballot template answered; cross-checked at
			-- tally/validation. TODO: bind structurally once Ballot carries a content cid column.
		Signature text, -- by DeviceKey over Digest(Tid, Id, ElectionId, BallotId, RegistrantId, DeviceKey, PublicCid, PrivateCid, OptionalInfo, TemplateCid)
		constraint DuplicateRegistrantRejected check (
			not exists (
				select 1 from VoterEntry VE
					where VE.ElectionId = new.ElectionId and VE.BallotId = new.BallotId
						and VE.RegistrantId = new.RegistrantId and VE.Id != new.Id
			)
		),
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint BallotBelongs check (exists (
			select 1 from Ballot B where B.Id = new.BallotId and B.ElectionId = new.ElectionId)),
		constraint RegistrantCidsValid check (exists (
			select 1 from Registrant R where R.Id = new.RegistrantId and R.Status = 'a'
				and R.Expiration > context.now and R.PublicCid = new.PublicCid and R.PrivateCid = new.PrivateCid)),
		constraint AssociatedAndEnrolled check (
			exists (
				select 1 from Association A where A.RegistrantId = new.RegistrantId
					and A.DeviceKey = new.DeviceKey and A.Expiration > context.now
			)
			and exists (
				select 1 from ElectionRegistrant ER where ER.ElectionId = new.ElectionId
					and ER.RegistrantId = new.RegistrantId
			)
		),
		constraint TemplateCidNotEmpty check (TemplateCid is not null and length(TemplateCid) > 0),
		constraint SignatureValidCheck check (
			SignatureValid(
				Digest(context.Tid, new.Id, new.ElectionId, new.BallotId, new.RegistrantId, new.DeviceKey, new.PublicCid, new.PrivateCid, new.OptionalInfo, new.TemplateCid),
				new.Signature, new.DeviceKey
			)
			or SignatureValidP256(
				Digest(context.Tid, new.Id, new.ElectionId, new.BallotId, new.RegistrantId, new.DeviceKey, new.PublicCid, new.PrivateCid, new.OptionalInfo, new.TemplateCid),
				new.Signature, new.DeviceKey
			)
		),
		constraint InsertOnly check on update, delete (false)
	)
		with context ( SigningNonce text, Tid int, now datetime );

	index VoterEntryBallot on VoterEntry (BallotId);

	-- Vote proper: WHAT was voted, as threshold ciphertext. Answers are encrypted to
	-- ElectionKey.PublicKey so nobody (authority included) can read them until the keyholder
	-- threshold releases. NonceCommitment = H(answers plaintext || vote nonce); the plaintext
	-- nonce NEVER touches the network — the voter holds it privately and uses it to locate and
	-- verify their entry in results (doc/election.md:97, architecture.md requirement 14).
	table Vote (
		Id text primary key, -- 32 byte random id
		VoterEntryId text, -- references VoterEntry.Id (one Vote per entry: entry is already per-ballot)
		AnswersCipher text, -- encrypted answers, split per the entry's district ballot template
		NonceCommitment text, -- commitment binding ciphertext to the voter-held nonce
		BlockId text null, -- set when pool negotiation forms a block ('form' message CID)
		CreatedAt datetime,
		constraint VoterEntryExists check (exists (select 1 from VoterEntry VE where VE.Id = new.VoterEntryId)),
		constraint OneVotePerEntry check (not exists (
			select 1 from Vote V where V.VoterEntryId = new.VoterEntryId)),
		constraint AnswersCipherNotEmpty check (AnswersCipher is not null and length(AnswersCipher) > 0),
		constraint NonceCommitmentNotEmpty check (NonceCommitment is not null and length(NonceCommitment) > 0),
		constraint CreatedAtValid check (isISODatetime(CreatedAt) and like('%Z', CreatedAt)),
		constraint InsertValid check on insert (
			context.UserSignature is not null
			and exists (
				select 1 from VoterEntry VE where VE.Id = new.VoterEntryId
					and (
						SignatureValid(Digest(context.Tid, new.Id, new.VoterEntryId, new.AnswersCipher, new.NonceCommitment, new.CreatedAt), context.UserSignature, VE.DeviceKey)
						or SignatureValidP256(Digest(context.Tid, new.Id, new.VoterEntryId, new.AnswersCipher, new.NonceCommitment, new.CreatedAt), context.UserSignature, VE.DeviceKey)
					)
			)
		),
		-- Updates may ONLY assign BlockId; the ciphertext/commitment are immutable after signing.
		constraint BlockAssignmentOnly check on update (
			new.BlockId is not null
			and new.AnswersCipher = old.AnswersCipher and new.NonceCommitment = old.NonceCommitment
			and new.CreatedAt = old.CreatedAt and new.Id = old.Id and new.VoterEntryId = old.VoterEntryId
		),
		constraint NoDelete check on delete (false)
	)
		with context ( UserSignature text, Tid int, now datetime );

	index VoteBlockAssignment on Vote (BlockId);
	index VoteEntryLookup on Vote (VoterEntryId);

	-- A formed vote block: the output of pool→block negotiation (doc/election.md "Vote Block
	-- Negotiation"). Id is the records-portion hash announced by the coordinator''s `form`
	-- message; MerkleRoot is the deterministic accounting leaves commit to (each leaf covers a
	-- scrambled (voter entry, vote) pair) — this root is the voter-receipt verification anchor:
	-- a voter proves INCLUSION with (nonce-held data + Merkle path against this root) and
	-- nothing else, satisfying "only the voter themselves should be able to prove
	-- inclusion/exclusion". Coordinator signing is any-valid-user-key for MVP; squad-threshold
	-- authorization of pools is deferred — fraud is caught at validation/tally, not admission.
	table VoteBlock (
		Id text primary key, -- hash/CID of the block's records portion (from `form`)
		ElectionId text,
		BallotId text,
		MerkleRoot text,
		RecordCount integer,
		FormedAt datetime,
		Tsas text null, -- json array of TSA timestamp tokens (late-block adjudication, validations note)
		CoordinatorKey text, -- pool coordinator's public key
		constraint ElectionBelongs check (exists (
			select 1 from Ballot B join Election E on E.Id = B.ElectionId
				where B.Id = new.BallotId and B.ElectionId = new.ElectionId)),
		constraint MerkleRootNotEmpty check (MerkleRoot is not null and length(MerkleRoot) > 0),
		constraint RecordCountValid check (typeof(new.RecordCount) = 'integer' and RecordCount >= 1),
		constraint FormedAtValid check (isISODatetime(FormedAt) and like('%Z', FormedAt)),
		constraint CoordinatorKeyNotEmpty check (CoordinatorKey is not null and length(CoordinatorKey) > 0),
		constraint InsertValid check on insert (
			context.CoordinatorKey is not null and context.UserSignature is not null
			and context.CoordinatorKey = CoordinatorKey
			and (
				SignatureValid(Digest(context.Tid, new.Id, new.ElectionId, new.BallotId, new.MerkleRoot, new.RecordCount, new.FormedAt), context.UserSignature, context.CoordinatorKey)
				or SignatureValidP256(Digest(context.Tid, new.Id, new.ElectionId, new.BallotId, new.MerkleRoot, new.RecordCount, new.FormedAt), context.UserSignature, context.CoordinatorKey)
			)
		),
		constraint NoUpdate check on update (false),
		constraint NoDelete check on delete (false)
	)
		with context ( CoordinatorKey text, UserSignature text, Tid int, now datetime );

	index VoteBlockByBallot on VoteBlock (ElectionId, BallotId);

	-- Tally tree node (doc/election.md "Election tallied"): histogram-carrying counterpart of
	-- the block Merkle tree. Root''s published form is the raw outcome; ResultHash on
	-- Certification commits to it (single-result guarantee, doc/election.md:225). Multi-party
	-- co-signing of nodes is deferred — one creator signature for MVP, creators listed in Sources.
	table TallyNode (
		Id text primary key, -- 32 byte random id or content hash of the node payload
		ElectionId text,
		ParentId text null, -- null = root
		Histogram text, -- json histogram of results at this node
		Sources text null, -- json array of child TallyNode ids and/or covered VoteBlock ids
		CreatedByKey text,
		NodeSignature text,
		Tsas text null,
		CreatedAt datetime,
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint ParentValid check (ParentId is null or exists (
			select 1 from TallyNode T where T.Id = new.ParentId and T.ElectionId = new.ElectionId)),
		constraint HistogramValid check (Histogram is not null and json_valid(Histogram)),
		constraint CreatedByKeyNotEmpty check (CreatedByKey is not null and length(CreatedByKey) > 0),
		constraint CreatedAtValid check (isISODatetime(CreatedAt) and like('%Z', CreatedAt)),
		constraint InsertValid check on insert (
			context.UserSignature is not null
			and (
				SignatureValid(Digest(context.Tid, new.Id, new.ElectionId, new.ParentId, new.Histogram, new.Sources, new.CreatedAt), context.UserSignature, new.CreatedByKey)
				or SignatureValidP256(Digest(context.Tid, new.Id, new.ElectionId, new.ParentId, new.Histogram, new.Sources, new.CreatedAt), context.UserSignature, new.CreatedByKey)
			)
		),
		constraint NoUpdate check on update (false),
		constraint NoDelete check on delete (false)
	)
		with context ( UserSignature text, Tid int, now datetime );

	index TallyNodeByElection on TallyNode (ElectionId);

	view ValidationKind as
		select 'slice' as Code, 'Voter slice-level verification' as Name
		union all select 'comprehensive' as Code, 'Comprehensive validation' as Name
		union all select 'anomaly' as Code, 'Validation anomaly record' as Name;

	-- Validation record (doc/election.md "Validation", "Validation Process"): successful and
	-- failed validations alike land here, failures carrying whatever proof can be given in
	-- DetailsCid. Kind ''slice'' = optional per-voter checks; ''comprehensive'' = full block/tree
	-- audit (doc/validations.md''s five checks); ''anomaly'' = e.g. premature key disclosure with
	-- TSA-signed proof. Passed is nullable because anomaly records are evidence, not verdicts.
	table ValidationRecord (
		Id text primary key, -- 32 byte random id
		ElectionId text,
		Kind text, -- references ValidationKind(Code)
		ValidatorKey text, -- public key of the validating party (voter, node, or authority)
		Passed integer null, -- 1/0 verdict; null for anomaly/evidence-only records
		DetailsCid text null, -- content-addressed details/proof payload
		CreatedAt datetime,
		Tsas text null,
		Signature text,
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint KindValid check (Kind in (select Code from ValidationKind)),
		constraint ValidatorKeyNotEmpty check (ValidatorKey is not null and length(ValidatorKey) > 0),
		constraint PassedValid check (Passed is null or Passed in (0, 1)),
		constraint CreatedAtValid check (isISODatetime(CreatedAt) and like('%Z', CreatedAt)),
		constraint InsertValid check on insert (
			context.UserSignature is not null
			and (
				SignatureValid(Digest(context.Tid, new.Id, new.ElectionId, new.Kind, new.Passed, new.DetailsCid, new.CreatedAt), context.UserSignature, new.ValidatorKey)
				or SignatureValidP256(Digest(context.Tid, new.Id, new.ElectionId, new.Kind, new.Passed, new.DetailsCid, new.CreatedAt), context.UserSignature, new.ValidatorKey)
			)
		),
		constraint NoUpdate check on update (false),
		constraint NoDelete check on delete (false)
	)
		with context ( UserSignature text, Tid int, now datetime );

	index ValidationRecordByElection on ValidationRecord (ElectionId);

	-- Authority certification of the outcome (doc/election.md "Certification"). Positive 0 is a
	-- NEGATIVE certification (contested result). ResultHash is the single-result commitment the
	-- validation chain reports against and the runoff dispute anchor (doc/election.md:211,225).
	table Certification (
		Id text primary key, -- 32 byte random id
		ElectionId text,
		AuthorityId text,
		Positive integer not null, -- 1 = certify outcome, 0 = negative certification
		StatementCid text null, -- content-addressed certification statement
		ResultHash text null, -- commitment to TallyNode root (required before runoffs can be judged)
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint PositiveValid check (Positive in (0, 1)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = new.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = new.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(context.Tid, new.Id, new.ElectionId, new.AuthorityId, new.Positive, new.StatementCid, new.ResultHash)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = old.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(context.Tid, old.Id, 'delete')
			)
		)
	)
		with context ( SigningNonce text, Tid int );

	index CertificationByElection on Certification (ElectionId);

	-- Directory-discovery record for an authority (doc/election.md:16-25): geohash for the
	-- precision-cascade search, precise GeoJson geometry for the containment pass, CA chain
	-- for verifying the authority''s records. Deliberately a SEPARATE 1:1 table rather than
	-- columns on Authority — directory data churns (districts change) while identity must not;
	-- edits ride the same ''uai'' admin-signing scope as Authority updates.
	table AuthorityDirectory (
		AuthorityId text primary key,
		GeoHash text null, -- coarse locator; app searches each precision level via prefix match
		DistrictGeometry text null, -- GeoJson geometry (json) for exact point-in-district filtering
		CaCertChain text null, -- json array of PEM certificates anchoring authority verification
		constraint AuthorityIdValid check (exists (select 1 from Authority A where A.Id = new.AuthorityId)),
		constraint GeoHashShape check (GeoHash is null or (length(GeoHash) >= 1 and GeoHash = lower(GeoHash))),
		constraint DistrictGeometryJson check (DistrictGeometry is null or json_valid(DistrictGeometry)),
		constraint CaCertChainJson check (CaCertChain is null or json_valid(CaCertChain)),
		constraint NoDelete check on delete (false),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					where A.Nonce = context.SigningNonce
						and A.Scope = 'uai'
						and A.Digest = Digest(context.Tid, new.AuthorityId, new.GeoHash, new.DistrictGeometry, new.CaCertChain)
			)
		)
	)
		with context ( SigningNonce text, Tid int );

	index AuthorityDirectoryGeoHash on AuthorityDirectory (GeoHash);

	-- Per-election self-enrollment policy (consumed by ElectionRegistrant.InsertValid''s
	-- self-service arm). Absence of a row = authority-enrollment only (fail-closed default,
	-- matching the ElectionAttestationPolicy posture). Integer flag, never boolean (Quereus v4
	-- re-attach ALTER COLUMN landmine).
	-- Runoff configuration lives in ElectionRevision.Timeline (decision 2026-08-24): the JSON
	-- object gains typed keys alongside the seven ElectionEvent keys —
	--   runoffAnnounced, runoffVotingStarts   (scheduling interval, doc/election.md:206)
	-- plus a Runoff sub-object { discrepancyMargin, accessibilityRatio, topTwo } holding the
	-- trigger thresholds (doc/election.md:200-208). Structural Timeline validation remains the
	-- standing TODO on both Election tables; no dedicated columns by decision.
	--
	-- NOTE: keep plain statements last in this declare block — a comment directly before the
	-- closing brace trips a quereus parser bug (comment swallows the brace, "Expected '}'").
	table ElectionEnrollmentPolicy (
		ElectionId text primary key, -- references Election.Id
		AllowSelfEnrollment integer default 0, -- 1 = an associated device key may self-enroll its registrant
		constraint ElectionIdValid check (exists (select 1 from Election E where E.Id = new.ElectionId)),
		constraint AllowSelfEnrollmentValid check (AllowSelfEnrollment in (0, 1)),
		constraint MutationValid check on insert, update (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = new.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(context.Tid, new.ElectionId, new.AllowSelfEnrollment)
			)
		),
		constraint DeleteValid check on delete (
			exists (
				select 1 from AdminSignature ASig join AdminSigning A on A.Nonce = ASig.SigningNonce
					join Election E on E.Id = old.ElectionId
					where A.Nonce = context.SigningNonce
						and A.AuthorityId = E.AuthorityId
						and A.Scope = 'mel'
						and A.Digest = Digest(context.Tid, old.ElectionId, old.AllowSelfEnrollment, 'delete')
			)
		)
	)
		with context ( SigningNonce text, Tid int );
}

apply schema main;