{
	"name": "@votetorrent/vote-viz",
	"version": "0.0.1",
	"type": "module",
	"description": "Visualization for VoteTorrent Schema",
	"main": "dist/src/index.js",
	"types": "dist/src/index.d.ts",
	"files": [
		"src",
		"dist",
		"!dist/test",
		"!**/*.tsbuildinfo"
	],
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		}
	},
	"scripts": {
		"clean": "aegir clean",
		"build": "aegir build",
		"lint": "aegir lint",
		"test": "aegir test",
		"test:node": "aegir test -t node",
		"dep-check": "aegir dep-check",
		"translate": "tsx src/ast-based-translation.ts"
	},
	"homepage": "https://github.com/gotchoices/votetorrent",
	"bugs": {
		"url": "https://github.com/gotchoices/votetorrent/issues"
	},
	"keywords": [
		"vote",
		"voting",
		"peer to peer",
		"p2p"
	],
	"author": "Nathan Allan",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.13.10",
		"aegir": "^45.1.4",
		"tsx": "^4.21.0"
	},
	"dependencies": {
		"@quereus/quereus": "^1.3.1"
	}
}
